---
/**
 * Canlı proje sitesinin gerçek ekran görüntüsü (araclar/proje-ekran.mjs ile alınır).
 * Üretilmiş ya da elle çizilmiş bir taklit değildir; alan adı ve çekim tarihi altında yazar.
 */
import type { ImageMetadata } from 'astro';
import Gorsel from './Gorsel.astro';
import { KAYNAK_KONTROL_TARIHI } from '../data/projeler';

interface Props {
  gorsel: ImageMetadata;
  marka: string;
  alanAdi: string;
  tur: 'masaustu' | 'mobil';
  sizes?: string;
  /** Görselin tıklanınca gideceği sayfa. Verilmezse canlı site. */
  url?: string;
}
const { gorsel, marka, alanAdi, tur, sizes, url } = Astro.props;
const hedef = url ?? `https://${alanAdi}/`;
const dis = !url;
---

<figure class:list={['pe', `pe--${tur}`]}>
  <a class="pe__cerceve" href={hedef} rel={dis ? 'noopener' : undefined} aria-label={`${marka}: ${dis ? 'canlı siteyi açın' : 'projeyi inceleyin'}`}>
    <Gorsel
      src={gorsel}
      alt={`${marka} web sitesinin ${tur === 'mobil' ? 'telefondaki' : 'masaüstündeki'} ilk ekranı`}
      sizes={sizes ?? (tur === 'mobil' ? '(max-width: 47.99rem) 44vw, 18vw' : '(max-width: 47.99rem) 100vw, 52vw')}
      genislikler={tur === 'mobil' ? [320, 480, 640, 780] : [640, 960, 1280, 1440]}
      kalite={70}
    />
  </a>
  <figcaption class="mikro ikincil">{alanAdi}, {KAYNAK_KONTROL_TARIHI} tarihli ekran görüntüsü</figcaption>
</figure>

<style>
  .pe {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .pe__cerceve {
    display: block;
    overflow: hidden;
    border-radius: var(--kose);
    box-shadow:
      0 0 0 1px var(--cizgi),
      0 22px 44px -22px rgb(16 28 57 / 0.35);
    background: var(--beyaz);
  }
  .pe__cerceve :global(img) {
    display: block;
    width: 100%;
    transition: transform 900ms var(--yumusak);
  }
  .pe--masaustu .pe__cerceve :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .pe--mobil .pe__cerceve :global(img) {
    aspect-ratio: 9 / 16;
    object-fit: cover;
    object-position: top center;
  }
  .pe__cerceve:hover :global(img) {
    transform: scale(1.02);
  }
  @media (prefers-reduced-motion: reduce) {
    .pe__cerceve :global(img) {
      transition: none;
    }
  }
</style>
