---
/**
 * Proje künyesi: sektör, yapılan iş ve canlı site, üç görselli kartta.
 * Yapılan iş proje kaydından gelir (src/data/projeler.ts); Google Ads ve Meta yönetimi işletme sahibinin beyanıdır.
 * Ölçülmüş sonuç alanı yoktur; müşteri onaylı ölçüm gelene kadar gösterilmez.
 * Bölümün kimliği "kunye"dir: sayfa içi gezinme buraya iner.
 */
import type { ImageMetadata } from 'astro';
import Cizim from '../Cizim.astro';
import Ikon from '../Ikon.astro';
import { projeBul } from '../../data/projeler';
import dukkan from '../../assets/cizimler/dukkan.png';

interface Props {
  kimlik: string;
  /** İşletmenin adı ve şehri (ör. "Rotech Mühendislik, Ankara"). */
  isletme?: string;
  /** Canlı site kartında gösterilecek not (ör. site tasarımı ekibe ait değilse). */
  not?: string;
  /** Sektör kartındaki kâğıt işi nesne. */
  sektorCizim: ImageMetadata;
  /** Yapılan iş kartındaki kâğıt işi nesne. */
  isCizim: ImageMetadata;
}
const { kimlik, isletme, not, sektorCizim, isCizim } = Astro.props;
const p = projeBul(kimlik);
const boyutlar = { sizes: '(max-width: 47.99rem) 30vw, 11vw', genislikler: [200, 320, 480] };
---

<section class="bolum bolum--beyaz bolum--siki pkn" id="kunye">
  <div class="sarici">
    <h2 class="baslik-3 pkn__baslik">Proje künyesi</h2>
    <ul class="pkn__izgara">
      <li class="pkn__kart" data-gir>
        <h3 class="pkn__ad">Sektör</h3>
        <div class="pkn__icerik">
          <p class="pkn__deger">{p.sektor}</p>
          <p class="pkn__alt">{isletme ?? p.marka}</p>
        </div>
        <div class="pkn__cizim" aria-hidden="true">
          <Cizim src={sektorCizim} {...boyutlar} />
        </div>
      </li>

      <li class="pkn__kart pkn__kart--mavi" data-gir style="--gecikme:90ms">
        <h3 class="pkn__ad">Yapılan iş</h3>
        <div class="pkn__icerik">
          <ul class="pkn__isler">
            {p.obrandyKapsami.map((i) => <li>{i}</li>)}
          </ul>
          {p.reklamYonetimi === 'beyan' && <p class="pkn__alt">Google Ads ve Meta yönetimi sürüyor.</p>}
        </div>
        <div class="pkn__cizim" aria-hidden="true">
          <Cizim src={isCizim} {...boyutlar} />
        </div>
      </li>

      <li class="pkn__kart" data-gir style="--gecikme:180ms">
        <h3 class="pkn__ad">Canlı site</h3>
        <div class="pkn__icerik">
          <a class="pkn__deger pkn__site" href={`https://${p.alanAdi}/`} rel="noopener">
            {p.alanAdi}
            <Ikon ad="arrow-up-right" boyut={18} />
          </a>
        </div>
        <div class="pkn__cizim" aria-hidden="true">
          <Cizim src={dukkan} {...boyutlar} />
        </div>
        {not && <p class="pkn__not">{not}</p>}
      </li>
    </ul>
  </div>
</section>

<style>
  .pkn__baslik {
    margin-block-end: clamp(1.1rem, 2vw, 1.6rem);
  }
  .pkn__izgara {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .pkn__kart {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(5.25rem, 7.6vw, 7.25rem);
    grid-template-rows: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: start;
    padding: clamp(1.15rem, 2vw, 1.75rem);
    background: var(--yuzey, var(--kagit));
    border-radius: var(--kose);
    min-width: 0;
  }
  .pkn__kart--mavi {
    background: var(--mavi-acik);
  }
  .pkn__ad {
    grid-column: 1;
    font-size: var(--b-kucuk);
    font-weight: 640;
    font-stretch: 100%;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--mavi);
  }
  .pkn__icerik {
    grid-column: 1;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: start;
    min-width: 0;
  }
  .pkn__cizim {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    margin: -0.25rem -0.5rem -0.35rem 0;
  }
  .pkn__deger {
    font-family: var(--yazi-baslik);
    font-size: clamp(1.45rem, 1.15rem + 1vw, 2rem);
    font-weight: 700;
    font-stretch: 86%;
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--murekkep);
    overflow-wrap: anywhere;
  }
  .pkn__alt {
    font-size: var(--b-kucuk);
    line-height: 1.45;
    color: var(--murekkep-2);
  }
  /* Not kartın tam genişliğinde, görselin altında durur. */
  .pkn__not {
    grid-column: 1 / -1;
    margin-block-start: 0.35rem;
    font-size: var(--b-mikro);
    line-height: 1.45;
    color: var(--ikincil);
  }
  /* Yapılan iş: her biri kırmızı kalem tikiyle. */
  .pkn__isler {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pkn__isler li {
    position: relative;
    padding-inline-start: 1.75rem;
    font-family: var(--yazi-baslik);
    font-size: clamp(1.15rem, 1.02rem + 0.5vw, 1.4rem);
    font-weight: 680;
    font-stretch: 88%;
    line-height: 1.15;
    letter-spacing: -0.016em;
  }
  .pkn__isler li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.34em;
    width: 0.9rem;
    height: 0.48rem;
    border-left: 2.5px solid var(--kirmizi);
    border-bottom: 2.5px solid var(--kirmizi);
    transform: rotate(-48deg);
    transform-origin: left bottom;
    border-radius: 1px;
  }
  .pkn__site {
    font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.4rem);
    font-stretch: 90%;
    letter-spacing: -0.012em;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    margin-block: -0.4rem;
    text-decoration-color: var(--cizgi-koyu);
  }
  .pkn__site :global(svg) {
    flex: none;
    color: var(--kirmizi);
  }
  .pkn__site:hover {
    text-decoration-color: var(--kirmizi);
  }
  @media (max-width: 61.99rem) {
    .pkn__izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pkn__kart:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (max-width: 43.99rem) {
    .pkn__izgara {
      grid-template-columns: minmax(0, 1fr);
    }
    .pkn__kart:nth-child(2) {
      grid-column: auto;
      grid-row: auto;
    }
    .pkn__kart {
      grid-template-columns: minmax(0, 1fr) 5.25rem;
    }
  }
</style>
