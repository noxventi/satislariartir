---
/**
 * Reklam açılış sayfası üst alanı: reklamın sorusu (H1), tek cümlelik açıklama, form ve kâğıt işi sahne.
 * Masaüstü: solda başlık, açıklama ve altında sayfanın sol kenarına taşan sahne; sağda form fişi.
 * Mobil: başlık, açıklama, form; sahne formun altına iner (form ilk ekranda kalsın diye).
 * Form sayfanın tek formudur ve #gorusme çapasını taşır. Form fişinin başlığında küçük bir kâğıt işi nesne durur.
 */
import type { ImageMetadata } from 'astro';
import TalepFormu from '../TalepFormu.astro';
import Gorsel from '../Gorsel.astro';
import Cizim from '../Cizim.astro';
import Isaret from '../Isaret.astro';
import type { KanalDegeri } from '../../site.config';
import { whatsappBaglantisi } from '../../lib/iletisim';

interface Props {
  baslik: string;
  /** Başlığın kırmızı kalemle altı çizilecek kısmı. Başlıkta birebir geçmeli; kısa tutulur (satır ortasında bölünmez). */
  vurgu?: string;
  altMetin: string;
  kanal: KanalDegeri;
  cagri: string;
  konum: string;
  kampanyaDurumu?: 'new' | 'existing' | '';
  formKimligi: string;
  formBasligi: string;
  formMetni?: string;
  /** Kâğıt işi sahne (src/assets/gorseller). */
  gorsel: ImageMetadata;
  gorselAlt: string;
  /** Sahnenin kırpım odağı (object-position). Dikey sahnelerde anlatan kısım görünsün diye verilir. */
  odak?: string;
  mobilOdak?: string;
  /** Form fişinin başlığındaki kâğıt işi nesne (src/assets/cizimler). */
  nesne?: ImageMetadata;
  /** kagit: sitenin kırık beyaz zemini. acik: soluk mavi zemin. */
  zemin?: 'kagit' | 'acik';
  /** Doğrulanmış WhatsApp numarası (yalnız rakam). Boşsa seçenek gösterilmez. Tıklama talep sayılmaz. */
  whatsapp?: string;
}
const {
  baslik,
  vurgu,
  altMetin,
  kanal,
  cagri,
  konum,
  kampanyaDurumu = 'existing',
  formKimligi,
  formBasligi,
  formMetni = 'İşletmenizi ve ulaşmak istediğiniz müşteriyi anlatın. Görüşmeye buradan başlayalım.',
  gorsel,
  gorselAlt,
  odak = '50% 50%',
  mobilOdak,
  nesne,
  zemin = 'kagit',
  whatsapp = '',
} = Astro.props;

// Dikey sahneler dar ekranda kare gösterilir: 3:2 kırpım sahnenin çoğunu keserdi.
const dikey = gorsel.height > gorsel.width;
const yer = vurgu ? baslik.indexOf(vurgu) : -1;
const once = yer >= 0 ? baslik.slice(0, yer) : baslik;
const sonra = yer >= 0 ? baslik.slice(yer + vurgu!.length) : '';
---

<section class:list={['lpk', `lpk--${zemin}`]}>
  <div class="sarici lpk__ic">
    <div class="lpk__bas">
      <h1 class="lpk__baslik">
        {once}{yer >= 0 && <Isaret tip="alt" gecikme={450}>{vurgu}</Isaret>}{sonra}
      </h1>
      <p class="giris">{altMetin}</p>
    </div>

    <div class="lpk__form" id="gorusme">
      <TalepFormu konum={konum} kanal={kanal} cagri={cagri} kampanyaDurumu={kampanyaDurumu} kimlik={formKimligi}>
        <Fragment slot="baslik">
          <div class="lpk__form-ust">
            <div class="lpk__form-yazi">
              <h2 class="baslik-3">{formBasligi}</h2>
              <p class="kucuk ikincil">{formMetni}</p>
            </div>
            {nesne && <Cizim src={nesne} class="lpk__nesne" sizes="7rem" genislikler={[160, 240, 320]} oncelik />}
          </div>
        </Fragment>
      </TalepFormu>
      {
        whatsapp && (
          <p class="lpk__form-alti kucuk">
            Yazmayı tercih ederseniz <a href={whatsappBaglantisi(kanal)} rel="noopener" data-olay="whatsapp_click" data-yer={konum}>WhatsApp’tan ulaşın</a>.
          </p>
        )
      }
    </div>

    <figure class:list={['lpk__gorsel', dikey && 'lpk__gorsel--dikey']} style={`--odak:${odak};--mobil-odak:${mobilOdak ?? odak}`}>
      <Gorsel
        src={gorsel}
        alt={gorselAlt}
        sizes="(max-width: 55.99rem) 100vw, 58vw"
        genislikler={[640, 960, 1280, 1700, 2000]}
        kalite={66}
        oncelik
      />
    </figure>
  </div>
</section>

<style>
  .lpk {
    --lpk-golge: var(--mavi-acik);
    padding-block: clamp(1.25rem, 3.2vw, 3rem) clamp(2.75rem, 5.5vw, 5rem);
    overflow: clip;
  }
  .lpk--acik {
    --lpk-golge: rgb(23 61 166 / 0.2);
    background: var(--mavi-acik);
  }
  .lpk__ic {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'bas form'
      'gorsel form';
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 5vw, 5.5rem);
    row-gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  .lpk__bas {
    grid-area: bas;
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.4rem);
    padding-block-start: clamp(0.25rem, 1.6vw, 1.5rem);
  }
  /* Açılış sayfası başlıkları uzundur: sitenin birinci başlığından bir kademe küçük. */
  .lpk__baslik {
    font-size: clamp(2.1rem, 1.25rem + 3.3vw, 4rem);
    font-weight: 720;
    font-stretch: 84%;
    line-height: 1;
    letter-spacing: -0.028em;
    max-width: 12em;
  }
  .lpk__bas .giris {
    max-width: 30em;
  }

  /* Form fişi: ana sayfadaki arama kutusu gibi lacivert çerçeve ve sert gölge. */
  .lpk__form {
    grid-area: form;
    padding: clamp(1.2rem, 2.4vw, 2.1rem);
    background: var(--beyaz);
    border: 1.5px solid var(--murekkep);
    border-radius: var(--kose);
    box-shadow: 0.45rem 0.45rem 0 var(--lpk-golge);
    color: var(--murekkep);
    scroll-margin-top: calc(var(--ust-bant) + 1rem);
  }
  .lpk__form-ust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
  }
  .lpk__form-yazi {
    display: grid;
    gap: 0.35rem;
  }
  .lpk__nesne {
    width: clamp(5rem, 7.4vw, 6.75rem);
    margin: -0.9rem -0.6rem -0.7rem 0;
  }
  .lpk__form-alti {
    margin-block-start: 1rem;
    color: var(--murekkep-2);
  }

  /* Sahne: metnin altında, sayfanın sol kenarına taşar; alt kenarı form fişiyle hizalanır. */
  .lpk__gorsel {
    grid-area: gorsel;
    position: relative;
    align-self: stretch;
    min-height: clamp(15rem, 26vw, 23rem);
    margin-inline-start: calc((100vw - min(100vw - 2 * var(--kenar), var(--genislik))) / -2);
    overflow: hidden;
    border-radius: 0 var(--kose) var(--kose) 0;
  }
  /* Görsel satırın yüksekliğini belirlemez: yüksekliği form fişi verir, sahne kalan alanı doldurur. */
  .lpk__gorsel :global(picture) {
    position: absolute;
    inset: 0;
  }
  .lpk__gorsel :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--odak);
  }

  @media (max-width: 55.99rem) {
    .lpk {
      padding-block-end: 0;
    }
    .lpk__ic {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'bas'
        'form'
        'gorsel';
      grid-template-rows: auto;
      row-gap: 1.35rem;
    }
    .lpk__bas {
      padding-block-start: 0;
      gap: 0.75rem;
    }
    .lpk__gorsel {
      min-height: 0;
      margin-block-start: 1.4rem;
      margin-inline: calc(var(--kenar) * -1);
      border-radius: 0;
    }
    .lpk__gorsel :global(picture) {
      position: static;
      display: block;
    }
    .lpk__gorsel :global(img) {
      height: auto;
      aspect-ratio: 3 / 2;
      object-position: var(--mobil-odak);
    }
    .lpk__gorsel--dikey :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 35.99rem) {
    .lpk__gorsel--dikey :global(img) {
      aspect-ratio: 1 / 1;
    }
  }
  /* 360 pikselden dar ekranda sade üst menünün iki bağlantısı logonun yanına sığmaz ve sağdan kesilir.
     Üst bilgi ortak bileşen olduğu için yalnız açılış sayfasında ilk bağlantı gizlenir; form zaten ilk ekrandadır. */
  @media (max-width: 22.49rem) {
    :global(.ust__sade a:first-child:not(:only-child)) {
      display: none;
    }
  }
  @media (max-width: 26rem) {
    .lpk__form {
      padding-inline: 1.05rem;
    }
    .lpk__nesne {
      width: 4.75rem;
      margin-inline-end: -0.35rem;
    }
    /* En dar ekranda uzun düğme etiketi tek satırda kalsın. */
    .lpk__form :global(.talep__gonder) {
      padding-inline: 0.6rem;
      gap: 0.45rem;
      font-size: 0.975rem;
      font-stretch: 90%;
    }
  }
</style>
