---
/**
 * Reklam açılış sayfasının kapanışı: tek cümle, sayfadaki forma dönen tek düğme ve kâğıt işi bir nesne.
 * İkinci bir form açılmaz; düğme üstteki #gorusme formuna iner.
 * Varsayılan yuva (slot): doğrulanmış müşteri sözü gibi kısa bir kanıt; görselin altında durur.
 */
import type { ImageMetadata } from 'astro';
import Cizim from '../Cizim.astro';
import Ikon from '../Ikon.astro';

interface Props {
  baslik: string;
  metin?: string;
  cagri: string;
  kanal: string;
  yer: string;
  /** Beyaz zeminli kâğıt işi nesne (src/assets/cizimler). */
  cizim?: ImageMetadata;
}
const { baslik, metin, cagri, kanal, yer, cizim } = Astro.props;
const ekVar = Astro.slots.has('default');
---

<section class="bolum bolum--acik lpc">
  <div class:list={['sarici lpc__ic', (cizim || ekVar) && 'lpc__ic--ikili']}>
    <div class="lpc__metin">
      <h2 class="baslik-1">{baslik}</h2>
      {metin && <p class="giris">{metin}</p>}
      <a class="dugme" href="#gorusme" data-ana-cagri data-olay="cta_click" data-yer={yer} data-kanal={kanal}>
        {cagri}
        <Ikon ad="arrow-right" boyut={18} />
      </a>
    </div>
    {
      (cizim || ekVar) && (
        <div class="lpc__yan">
          {cizim && (
            <div class="lpc__cizim" aria-hidden="true" data-gir>
              <Cizim src={cizim} sizes="(max-width: 55.99rem) 40vw, 22vw" genislikler={[240, 360, 520, 760]} />
            </div>
          )}
          {ekVar && (
            <div class="lpc__ek">
              <slot />
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .lpc__ic {
    display: grid;
    gap: 1.75rem clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .lpc__ic--ikili {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .lpc__metin {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    justify-items: start;
  }
  .lpc__metin h2 {
    max-width: 12em;
  }
  .lpc__metin .dugme {
    margin-block-start: 0.5rem;
  }
  .lpc__yan {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .lpc__cizim {
    justify-self: center;
    width: min(100%, 19rem);
    margin-block: -1.75rem -1.25rem;
  }
  .lpc__ek {
    max-width: 30rem;
  }
  @media (max-width: 55.99rem) {
    .lpc__ic--ikili {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Dar ekranda nesne başlığın üstünde, küçük durur; kanıt düğmenin altına iner. */
    .lpc__yan {
      display: contents;
    }
    .lpc__cizim {
      order: -1;
      justify-self: start;
      width: 8.5rem;
      margin: -1rem 0 -1.25rem -0.75rem;
    }
    .lpc__metin .dugme {
      width: 100%;
    }
  }
</style>
