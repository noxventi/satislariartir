---
/**
 * Soru kartları: işletmelerin kendi sorusu (başlık), nedenin gündelik bir örneği ve yaptığımız iş.
 * Kartlar düz bir ızgarada, aynı ölçüde durur (kart sayısı üçe bölünüyorsa üç, değilse iki sütun). Satırlar ortaktır:
 * görsel, soru, örnek, yapılan iş ve bağlantı her kartta aynı hizada başlar. Kartın tamamı tıklanır,
 * üzerine gelince soru kırmızı kalemle çizilir.
 * Başlıklar insanların aramaya yazdığı biçimde soru olmalı; örnekler temsili gündelik işletmelerdir.
 */
import type { ImageMetadata } from 'astro';
import Cizim from './Cizim.astro';
import Ikon from './Ikon.astro';

export interface SoruKarti {
  soru: string;
  ornek: string;
  care: string;
  bag: { etiket: string; url: string };
  cizim: ImageMetadata;
  /** Eski düzenden kalan alan; artık kullanılmıyor (kartlar aynı ölçüde). */
  genis?: boolean;
}
interface Props {
  kartlar: SoruKarti[];
}
const { kartlar } = Astro.props;
const sutun = kartlar.length % 3 === 0 ? 3 : 2;
// Dama düzeni: yan yana ve alt alta gelen kartlar farklı renkte olsun.
const maviMi = (i: number) => (sutun === 3 ? i % 2 === 1 : [1, 2].includes(i % 4));
---

<ul class:list={['sk', 'sk--' + sutun]}>
  {
    kartlar.map((k, i) => (
      <li class:list={['sk__kart', maviMi(i) ? 'sk__kart--mavi' : 'sk__kart--kagit']}>
        <div class="sk__metin">
          <h3 class="sk__soru">
            <span>{k.soru}</span>
          </h3>
          <p class="sk__ornek kucuk">{k.ornek}</p>
          <p class="sk__care">{k.care}</p>
          <a class="ok-bag sk__bag" href={k.bag.url}>
            {k.bag.etiket}
            <Ikon ad="arrow-right" boyut={16} />
          </a>
        </div>
        <div class="sk__cizim" aria-hidden="true">
          <Cizim src={k.cizim} sizes="(max-width: 47.99rem) 56vw, 22vw" genislikler={[280, 420, 640, 1024]} />
        </div>
      </li>
    ))
  }
</ul>

<style>
  .sk {
    --kart-arasi: clamp(0.75rem, 1.5vw, 1.4rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--kart-arasi);
    row-gap: 0.8rem;
  }
  .sk--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .sk__kart {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    justify-items: start;
    align-items: start;
    margin-block-end: calc(var(--kart-arasi) - 0.8rem);
    padding: clamp(1.4rem, 2.2vw, 2.1rem);
    border-radius: var(--kose);
    overflow: hidden;
    isolation: isolate;
  }
  @supports not (grid-template-rows: subgrid) {
    .sk__kart {
      grid-row: auto;
      grid-template-rows: auto auto auto 1fr auto;
    }
  }
  /* Kart rengi bölümün zeminine göre seçilir: beyaz bölümde kâğıt, kâğıt bölümde beyaz. */
  .sk__kart--kagit {
    background: var(--yuzey, var(--kagit));
  }
  .sk__kart--mavi {
    background: var(--mavi-acik);
  }
  .sk__metin {
    display: contents;
  }
  .sk__cizim {
    order: -1;
    justify-self: end;
    width: min(46%, 11rem);
    margin: -0.6rem -0.6rem -0.2rem 0;
  }
  .sk--2 .sk__cizim {
    width: min(36%, 11.5rem);
  }
  .sk__soru {
    align-self: end;
    font-size: clamp(1.35rem, 1.05rem + 1vw, 1.85rem);
    font-weight: 700;
    font-stretch: 86%;
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .sk__soru span {
    background: linear-gradient(var(--kirmizi), var(--kirmizi)) no-repeat 0 56% / 0 0.09em;
    transition: background-size 520ms cubic-bezier(0.6, 0.05, 0.25, 1);
  }
  .sk__kart:hover .sk__soru span,
  .sk__kart:focus-within .sk__soru span {
    background-size: 100% 0.09em;
  }
  .sk__ornek {
    color: var(--ikincil);
    max-width: 36em;
  }
  .sk__care {
    max-width: 34em;
    font-weight: 600;
    color: var(--murekkep);
  }
  .sk__bag {
    align-self: end;
  }
  .sk__bag::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Hareket görselin kendisine verilir: sarıcıya verilirse ayrı katman açılır, beyaz zemin kutu olarak görünür. */
  .sk__cizim :global(img) {
    transition: transform 600ms var(--yumusak);
  }
  .sk__kart:hover .sk__cizim :global(img) {
    transform: rotate(-2.5deg) scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .sk__cizim :global(img),
    .sk__soru span {
      transition: none;
    }
    .sk__kart:hover .sk__cizim :global(img) {
      transform: none;
    }
  }
  @media (max-width: 61.99rem) {
    .sk--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 43.99rem) {
    .sk,
    .sk--3 {
      grid-template-columns: minmax(0, 1fr);
    }
    .sk__cizim,
    .sk--2 .sk__cizim {
      width: min(44%, 10rem);
    }
  }
</style>
