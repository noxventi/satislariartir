---
/**
 * Çalışma adımları: kırmızı kalem çizgisi üstünde duraklar. Geniş ekranda yatay, dar ekranda dikey.
 * Çizgi görünüme girince soldan sağa çizilir, duraklar sırayla belirir (hareket azaltmada durağan).
 * Yalnız gerçek sıra taşıyan süreçlerde kullanılır; en fazla altı durak.
 */
export interface Adim {
  ad: string;
  /** Koyu yazılan kısa özet. */
  ozet?: string;
  aciklama: string;
}
interface Props {
  adimlar: Adim[];
}
const { adimlar } = Astro.props;
---

<ol class="ay" data-gir style={`--adet:${adimlar.length}`}>
  {
    adimlar.map((a, i) => (
      <li class="ay__durak" style={`--sira:${i}`}>
        <span class="ay__nokta" aria-hidden="true" />
        <h3>{a.ad}</h3>
        {a.ozet && <p class="ay__ozet">{a.ozet}</p>}
        <p class="ay__aciklama kucuk ikincil">{a.aciklama}</p>
      </li>
    ))
  }
</ol>

<style>
  .ay {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--adet), minmax(0, 1fr));
    column-gap: clamp(1rem, 2.2vw, 2.25rem);
  }
  .ay::before {
    content: '';
    position: absolute;
    inset-inline: 0.4rem 0;
    top: 0.6rem;
    height: 3px;
    background: var(--kirmizi);
    transform-origin: left center;
    filter: url(#kalem-dokusu);
  }
  .ay__durak {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding-block-start: 3rem;
  }
  .ay__durak h3 {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem);
    font-weight: 700;
    font-stretch: 86%;
    letter-spacing: -0.022em;
    line-height: 1.04;
  }
  .ay__nokta {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.3rem;
    height: 1.3rem;
    border: 3px solid var(--kirmizi);
    border-radius: 50%;
    background: var(--zemin, var(--beyaz));
  }
  .ay__durak:last-child .ay__nokta {
    background: var(--kirmizi);
    box-shadow: 0 0 0 4px rgb(185 35 56 / 0.16);
  }
  .ay__ozet {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--murekkep);
  }
  .ay__aciklama {
    max-width: 17em;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ay[data-gir] {
      opacity: 1;
      transform: none;
    }
    :global(.js) .ay[data-gir]::before {
      transform: scaleX(0);
      transition: transform 1400ms cubic-bezier(0.6, 0.05, 0.25, 1) 150ms;
    }
    :global(.js) .ay[data-gir] .ay__durak {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 500ms var(--yumusak) calc(200ms + var(--sira) * 240ms),
        transform 600ms var(--yumusak) calc(200ms + var(--sira) * 240ms);
    }
    :global(.js) .ay[data-gir]:global(.girdi-goruldu)::before {
      transform: none;
    }
    :global(.js) .ay[data-gir]:global(.girdi-goruldu) .ay__durak {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 55.99rem) {
    .ay {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }
    .ay::before {
      inset-inline: 0.55rem auto;
      inset-block: 0.5rem 1.5rem;
      width: 3px;
      height: auto;
      transform-origin: center top;
    }
    .ay__durak {
      padding-block-start: 0;
      padding-inline-start: 2.5rem;
      gap: 0.3rem;
    }
    .ay__nokta {
      top: 0.2rem;
    }
    .ay__aciklama {
      max-width: none;
    }
  }
  @media (max-width: 55.99rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .ay[data-gir]::before {
      transform: scaleY(0);
    }
  }
</style>
