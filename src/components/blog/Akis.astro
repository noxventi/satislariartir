---
/**
 * Akış şeması: bir sürecin aşamaları soldan sağa, kırmızı kalem oklarıyla bağlı. Telefonda yukarıdan aşağıya iner.
 * Kullanım (MDX):
 * <Akis asamalar={[
 *   { ad: 'Gösterim', aciklama: 'Reklamınız arama sonucunda görünür.' },
 *   { ad: 'Tıklama', aciklama: 'Kişi reklama dokunur.', olcu: 'TO (CTR)' },
 *   { ad: 'Talep', aciklama: 'Arar ya da form doldurur.', olcu: 'Dönüşüm oranı' },
 *   { ad: 'Satış', aciklama: 'İş bağlanır.', olcu: 'ROAS' },
 * ]} />
 * - olcu: o aşamaya geçişi ölçen terim; kartın üstünde küçük bir etiket olarak durur.
 * - En fazla beş aşama. Son aşama kırmızı zeminle vurgulanır.
 */
import Ikon from '../Ikon.astro';

interface Asama {
  ad: string;
  aciklama?: string;
  olcu?: string;
}
interface Props {
  asamalar: Asama[];
}
const { asamalar } = Astro.props;
---

<ol class="akis-semasi" style={`--adet:${asamalar.length}`}>
  {
    asamalar.map((a, i) => (
      <li class:list={['akis-semasi__asama', i === asamalar.length - 1 && 'akis-semasi__asama--son']} data-gir style={`--gecikme:${i * 90}ms`}>
        {i > 0 && (
          <span class="akis-semasi__ok" aria-hidden="true">
            <Ikon ad="arrow-right" boyut={22} />
          </span>
        )}
        <span class="akis-semasi__olcu">{a.olcu ?? ''}</span>
        <span class="akis-semasi__ad">{a.ad}</span>
        {a.aciklama && <span class="akis-semasi__aciklama">{a.aciklama}</span>}
      </li>
    ))
  }
</ol>

<style>
  .akis-semasi {
    display: grid;
    grid-template-columns: repeat(var(--adet), minmax(0, 1fr));
    gap: clamp(1.6rem, 3vw, 2.4rem);
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
  .akis-semasi__asama {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.4rem;
    align-content: start;
    margin: 0;
    padding: clamp(0.9rem, 1.6vw, 1.25rem);
    background: var(--beyaz);
    border-radius: var(--kose);
    box-shadow: 0 0 0 1.5px var(--murekkep);
  }
  .akis-semasi__asama--son {
    background: var(--kirmizi);
    box-shadow: 0 0 0 1.5px var(--kirmizi);
    color: var(--beyaz);
  }
  .akis-semasi__ok {
    position: absolute;
    left: calc(-1 * clamp(1.6rem, 3vw, 2.4rem));
    top: 50%;
    display: grid;
    place-items: center;
    width: clamp(1.6rem, 3vw, 2.4rem);
    translate: 0 -50%;
    color: var(--kirmizi);
  }
  .akis-semasi__olcu {
    min-height: 1.35rem;
    justify-self: start;
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 680;
    line-height: 1.35rem;
    color: var(--mavi);
  }
  .akis-semasi__asama--son .akis-semasi__olcu {
    color: rgb(255 255 255 / 0.86);
  }
  .akis-semasi__ad {
    font-family: var(--yazi-baslik);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    font-stretch: 86%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .akis-semasi__aciklama {
    font-size: var(--b-kucuk);
    line-height: 1.42;
    color: var(--murekkep-2);
  }
  .akis-semasi__asama--son .akis-semasi__aciklama {
    color: rgb(255 255 255 / 0.9);
  }
  @media (max-width: 47.99rem) {
    .akis-semasi {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.1rem;
    }
    .akis-semasi__asama {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      column-gap: 1rem;
    }
    .akis-semasi__olcu {
      grid-column: 2;
      grid-row: 1;
      min-height: 0;
    }
    .akis-semasi__ad {
      grid-column: 1;
      grid-row: 1;
    }
    .akis-semasi__aciklama {
      grid-column: 1 / -1;
    }
    .akis-semasi__ok {
      left: 50%;
      top: -2.1rem;
      width: auto;
      height: 2.1rem;
      translate: -50% 0;
      rotate: 90deg;
    }
  }
</style>
