---
/**
 * Tekil blog yazısı. İçerik src/content/rehberler/*.mdx dosyasından gelir (koleksiyonun adı "rehberler" olarak kaldı;
 * adres /blog/<dosya adı>/ biçimindedir).
 *
 * Düzen: üst alan (soru, künye, yanıtlanan aramalar, kısa cevap kutusu ve kapak sahnesi) > içindekiler (masaüstünde yapışkan,
 * telefonda açılır kutu) ve yazı > kaynaklar > sıradaki adım (ilgili hizmet, iki yazı, varsa proje) > görüşme bandı.
 *
 * - Kısa cevap kutusu arama ve yapay zekâ yanıtlarında alıntılanabilir özettir; Article verisinde "abstract" olarak da yazılır.
 * - İçindekiler ve yazıdaki ara başlık numaraları aynıdır: okur nerede olduğunu numaradan izler.
 * - Yazı içindeki görsel parçalar src/components/blog/ altındadır (AraGorsel, Sahne, Karsilastirma, Terimler, AdimListesi,
 *   SonucSayfasi, Akis, AramaKutulari, Not) ve src/components/rehber/ (Ornek, KontrolListesi, CalismaTablosu).
 * - Kapak sahnesi ön bilgideki "kapak" alanından gelir (src/assets/blog/). Kapağı olmayan yazıda kâğıt işi nesne durur.
 */
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Temel from '../../layouts/Temel.astro';
import Cizim from '../../components/Cizim.astro';
import Gorsel from '../../components/Gorsel.astro';
import Ikon from '../../components/Ikon.astro';
import Isaret from '../../components/Isaret.astro';
import IlgiliSayfalar, { type IlgiliSayfa } from '../../components/IlgiliSayfalar.astro';
import GorusmeBandi from '../../components/GorusmeBandi.astro';
import { GENEL_CAGRI, hizmetBul, SITE, type HizmetKimligi } from '../../site.config';
import { HIZMET_CIZIMI, HIZMET_ETIKETI, indekslenir, rehberCizimi, rehberKapagi, rehberleriGetir, rehberUrl, tarihYaz, type Rehber } from '../../lib/rehberler';
import { PROJELER } from '../../data/projeler';
import { whatsappBaglantisi } from '../../lib/iletisim';

import megafon from '../../assets/cizimler/megafon.png';
import celikvillamEkran from '../../assets/projeler/celikvillam-masaustu.jpg';

export async function getStaticPaths() {
  const rehberler = await rehberleriGetir();
  return rehberler.map((rehber) => ({ params: { slug: rehber.id }, props: { rehber, rehberler } }));
}

interface Props {
  rehber: Rehber;
  rehberler: Rehber[];
}
const { rehber, rehberler } = Astro.props;
const d = rehber.data;
const { Content, headings } = await render(rehber);
const basliklar = headings.filter((h) => h.depth === 2);
// "genel" konulu yazılar tek bir hizmete bağlı değildir: çağrı ve form genel görüşme isteğine döner.
const anaKonu = d.hizmetler[0];
const anaHizmet = anaKonu === 'genel' ? undefined : hizmetBul(anaKonu as HizmetKimligi);
const hizmetKimligi = anaHizmet?.kimlik;
const cagriEtiketi = anaHizmet?.cagri ?? GENEL_CAGRI.etiket;
const gorsel = rehberCizimi(rehber);
const kapak = rehberKapagi(rehber);
const proje = d.proje ? PROJELER.find((p) => p.kimlik === d.proje) : undefined;
// Yazıyı bitiren okur soru sormak isterse WhatsApp sohbeti yazının adıyla açılır.
const soruAdresi = whatsappBaglantisi(`“${d.baslik}” yazınız`);
const url = rehberUrl(rehber);
const kirintilar = [
  { ad: 'Blog', url: '/blog/' },
  { ad: d.baslik, url },
];

// Sıradaki adım: önce "sonraki" rehber, sonra aynı konudan bir başkası.
const sonraki = d.sonraki ? rehberler.find((r) => r.id === d.sonraki) : undefined;
const digerleri = rehberler.filter((r) => r.id !== rehber.id && r.id !== sonraki?.id);
const ayniKonu = digerleri.filter((r) => r.data.hizmetler.some((h) => d.hizmetler.includes(h)));
const ilgiliRehberler = [...new Set([sonraki, ...ayniKonu, ...digerleri])].filter((r): r is Rehber => Boolean(r)).slice(0, 2);

// Proje kartında yalnız ekibin tasarladığı sitenin ekran görüntüsü kullanılır; diğerinde kâğıt işi nesne durur.
const PROJE_GORSELI: Record<string, { gorsel: ImageMetadata; alt: string }> = {
  celikvillam: { gorsel: celikvillamEkran, alt: 'ÇelikVillam web sitesinin ana sayfası' },
};

const siradaki: IlgiliSayfa[] = [
  {
    tur: 'Hizmet',
    baslik: d.hizmetBaglantisi.etiket,
    metin: anaHizmet?.ozet ?? 'Reklam, SEO, yapay zekâ görünürlüğü ve web sitesi: hangisinin sizin durumunuza uyduğunu birlikte seçelim.',
    url: d.hizmetBaglantisi.url,
    cizim: HIZMET_CIZIMI[anaKonu],
  },
  ...ilgiliRehberler.map((r) => {
    const k = rehberKapagi(r);
    return {
      tur: 'Blog',
      baslik: r.data.soru,
      metin: r.data.elinizeGecen,
      url: rehberUrl(r),
      ...(k ? { gorsel: k.gorsel, gorselAlt: k.alt } : { cizim: rehberCizimi(r).cizim }),
    };
  }),
  ...(proje?.dosya
    ? [
        {
          tur: 'Proje',
          baslik: proje.siteAdi ?? proje.marka,
          metin: proje.karar,
          url: proje.dosya,
          ...(PROJE_GORSELI[proje.kimlik] ? { gorsel: PROJE_GORSELI[proje.kimlik].gorsel, gorselAlt: PROJE_GORSELI[proje.kimlik].alt } : { cizim: megafon }),
        },
      ]
    : []),
];

const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.soru,
    description: d.aciklama,
    abstract: d.kisaCevap,
    inLanguage: 'tr-TR',
    timeRequired: `PT${d.okumaDk}M`,
    datePublished: d.yayinTarihi.toISOString().slice(0, 10),
    dateModified: d.sonKontrol.toISOString().slice(0, 10),
    mainEntityOfPage: `${SITE.url}${url}`,
    ...(kapak && { image: `${SITE.url}${kapak.gorsel.src}` }),
    // Kişi yalnız gerçekten görev aldıysa yazılır; aksi hâlde yayıncı kurumdur.
    author: d.yazar ? { '@type': 'Person', name: d.yazar } : { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad },
    publisher: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad },
  },
];
const KAYNAK_TURU = { resmi: 'Resmî kaynak', topluluk: 'Kullanıcı sorusu', ornek: 'Aynı konuda başka bir yazı' } as const;
const icindekilerAdedi = basliklar.length + (d.kaynaklar.length > 0 ? 1 : 0);
// İçindekiler kutusu telefonda kapalı başlar. Çizimden önce çalışır, sayfa kaymaz.
const KUTU_BETIGI =
  "(function(){var k=document.currentScript.previousElementSibling;if(k&&window.matchMedia('(max-width: 61.99rem)').matches)k.removeAttribute('open')})()";
---

<Temel
  baslik={`${d.baslik} | Satışları Artır`}
  aciklama={d.aciklama}
  sayfaTuru="rehber"
  hizmet={hizmetKimligi}
  indeksle={indekslenir(rehber)}
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: cagriEtiketi, url: '#gorusme' }}
>
  <article>
    <header class:list={['rb', kapak && 'rb--kapakli']}>
      <div class="sarici rb__ic">
        <nav class="rb__kirinti" aria-label="Sayfa konumu">
          <ol class="kirinti">
            <li><a href="/">Ana sayfa</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><span aria-current="page">{d.baslik}</span></li>
          </ol>
        </nav>

        <div class="rb__metin">
          <h1 class="rb__soru">{d.soru}</h1>
          <ul class="rb__kunye">
            {d.hizmetler.map((h) => <li class="rb__konu">{HIZMET_ETIKETI[h]}</li>)}
            <li>
              <Ikon ad="clock" boyut={17} />
              {d.okumaDk} dakikalık okuma
            </li>
            <li>
              <Ikon ad="calendar-blank" boyut={17} />
              <span>
                Son içerik kontrolü: <time datetime={d.sonKontrol.toISOString().slice(0, 10)}>{tarihYaz(d.sonKontrol)}</time>
              </span>
            </li>
            {d.yazar && <li>Yazan: {d.yazar}</li>}
            {d.inceleyen && <li>İnceleyen: {d.inceleyen}</li>}
          </ul>

          {
            d.aramalar.length > 0 && (
              <div class="rb__aramalar">
                <p class="rb__aramalar-ad">Bu yazının yanıtladığı aramalar</p>
                <ul>
                  {d.aramalar.map((a) => (
                    <li>
                      <Ikon ad="magnifying-glass" boyut={15} />
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="rb__cevap">
            <h2 class="rb__cevap-ad"><Isaret tip="alt" gecikme={250}>Kısa cevap</Isaret></h2>
            <p class="rb__cevap-metni">{d.kisaCevap}</p>
          </div>
        </div>

        {
          kapak ? (
            <div class="rb__kapak">
              <Gorsel src={kapak.gorsel} alt={kapak.alt} sizes="(max-width: 61.99rem) 92vw, 40vw" genislikler={[480, 720, 960, 1280, 1700]} kalite={66} oncelik />
            </div>
          ) : (
            <div class="rb__cizim">
              <Cizim src={gorsel.cizim} alt={gorsel.alt} sizes="(max-width: 61.99rem) 44vw, 30vw" genislikler={[280, 420, 640, 860, 1024]} oncelik />
            </div>
          )
        }
      </div>
    </header>

    <div class="sarici rg">
      {
        basliklar.length > 1 && (
          <nav class="ic" aria-label="Bu yazıda">
            <p class="ic__ad" aria-hidden="true">
              Bu yazıda
            </p>
            <details class="ic__kutu" open>
              <summary class="ic__ozet">
                <span>Bu yazıda</span>
                <span class="ic__adet">{icindekilerAdedi} başlık</span>
                <Ikon ad="plus" boyut={20} class="ic__arti" />
              </summary>
              <ol class="ic__liste" data-icindekiler>
                {basliklar.map((b, i) => (
                  <li>
                    <a href={`#${b.slug}`}>
                      <span class="ic__no">{i + 1}</span>
                      <span>{b.text}</span>
                    </a>
                  </li>
                ))}
                {d.kaynaklar.length > 0 && (
                  <li>
                    <a href="#kaynaklar">
                      <span class="ic__no">
                        <Ikon ad="link-simple" boyut={15} />
                      </span>
                      <span>Kaynaklar</span>
                    </a>
                  </li>
                )}
              </ol>
            </details>
            {/* Telefonda kutu kapalı başlar. Betik çalışmazsa açık kalır ve bütün başlıklar okunur. */}
            <script is:inline set:html={KUTU_BETIGI} />
            <a class="ok-bag ic__cagri" href="#gorusme" data-olay="cta_click" data-yer="rehber-icindekiler" data-kanal={hizmetKimligi}>
              Bunu birlikte konuşalım
              <Ikon ad="arrow-right" boyut={16} />
            </a>
          </nav>
        )
      }

      <div class="rg__govde">
        <div class="rg__yazi yazi">
          <Content />
        </div>

        {/* Yazının sonu: okurun aklında kalan soruyu en kısa yoldan sorması için. */}
        <aside class="soru-karti" aria-labelledby="soru-karti-baslik">
          <div class="soru-karti__metin">
            <h2 class="baslik-3" id="soru-karti-baslik">
              Bu yazıyla ilgili bir sorunuz mu var?
            </h2>
            <p>Kendi hesabınızda ya da sitenizde takıldığınız yeri yazın, birlikte bakalım.</p>
            <div class="soru-karti__yollar">
              {soruAdresi && (
                <a class="soru-karti__wa" href={soruAdresi} target="_blank" rel="noopener" data-yer="rehber-soru-karti" data-kanal={hizmetKimligi}>
                  <Ikon ad="whatsapp-logo" boyut={20} />
                  WhatsApp’tan sorun
                </a>
              )}
              <a class="ok-bag" href="#gorusme" data-olay="cta_click" data-yer="rehber-soru-karti" data-kanal={hizmetKimligi}>
                {cagriEtiketi}
                <Ikon ad="arrow-right" boyut={16} />
              </a>
            </div>
          </div>
          <Cizim src={megafon} class="soru-karti__cizim" sizes="(max-width: 47.99rem) 28vw, 9rem" genislikler={[200, 320, 480]} />
        </aside>

        {
          d.kaynaklar.length > 0 && (
            <section class="kaynak" aria-labelledby="kaynaklar">
              <h2 class="baslik-3" id="kaynaklar">
                Kaynaklar
              </h2>
              <ul class="kaynak__liste">
                {d.kaynaklar.map((k) => (
                  <li>
                    <a href={k.url} rel="noopener">
                      <span class="kaynak__ad">{k.ad}</span>
                      <span class="kaynak__tur">{KAYNAK_TURU[k.tur]}</span>
                      <Ikon ad="arrow-up-right" boyut={18} />
                    </a>
                  </li>
                ))}
              </ul>
              <p class="kucuk ikincil">
                Kaynak bağlantıları {tarihYaz(d.sonKontrol)} tarihinde kontrol edildi. Platform arayüzleri değişebilir; adımları kendi ekranınızla
                karşılaştırın. Bu yazı genel bilgilendirme amaçlıdır; hukuki, mali ya da vergisel danışmanlık yerine geçmez
                (<a href="/kullanim-kosullari/">kullanım koşulları</a>).
              </p>
            </section>
          )
        }
      </div>
    </div>
  </article>

  <IlgiliSayfalar
    baslik="Sıradaki adım"
    giris="Bu yazıdaki adımları birlikte uygulayabilir ya da bir sonraki soruya geçebilirsiniz."
    sayfalar={siradaki}
  />

  <GorusmeBandi
    baslik={anaHizmet ? 'Kendi hesabınızda birlikte bakalım.' : 'Sizin işletmeniz için konuşalım.'}
    metin={
      anaHizmet
        ? 'Bu yazıdaki adımları sizin hesabınız ve siteniz üzerinde birlikte uygulayalım. Henüz başlamadıysanız ilk adımı baştan planlarız.'
        : 'İşletmenizi ve ulaşmak istediğiniz müşteriyi anlatın. Hangi kanalla başlamanın doğru olduğunu birlikte belirleyelim.'
    }
    kanal={hizmetKimligi ?? 'belirsiz'}
    cagri={cagriEtiketi}
    konum={`rehber-${rehber.id}`}
  />
</Temel>

<script>
  // İçindekiler: okunan bölüm işaretlenir. Betik çalışmazsa liste düz bağlantı listesi olarak kalır.
  const liste = document.querySelector<HTMLElement>('[data-icindekiler]');
  if (liste) {
    const baglar = [...liste.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const hedefler = baglar.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let bekliyor = false;
    const isaretle = () => {
      bekliyor = false;
      const sinir = innerHeight * 0.32;
      let etkin = -1;
      hedefler.forEach((h, i) => {
        if (h && h.getBoundingClientRect().top <= sinir) etkin = i;
      });
      baglar.forEach((a, i) => (i === etkin ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    addEventListener(
      'scroll',
      () => {
        if (bekliyor) return;
        bekliyor = true;
        requestAnimationFrame(isaretle);
      },
      { passive: true },
    );
    isaretle();

    // Telefonda kapatılan kutu, pencere genişleyince yeniden açılır (masaüstünde özet satırı görünmez).
    const kutu = liste.closest('details');
    const dar = matchMedia('(max-width: 61.99rem)');
    dar.addEventListener('change', (e) => {
      if (!e.matches && kutu) kutu.open = true;
    });
  }
</script>

<style>
  /* ---- Üst alan -------------------------------------------------------------
     Soru, künye ve kısa cevap solda; rehberin kâğıt işi görseli sağda. Kısa cevap, ana sayfadaki
     arama kutusunun karşılığıdır: beyaz kâğıt, mürekkep çerçeve, sert gölge. */
  .rb {
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(2.25rem, 4.5vw, 4rem);
  }
  .rb__ic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }
  .rb__kirinti {
    grid-column: 1 / -1;
  }
  .rb__metin {
    grid-column: 1 / span 8;
    display: grid;
    justify-items: start;
    min-width: 0;
  }
  .rb__soru {
    font-size: clamp(2.05rem, 1.3rem + 2.7vw, 3.75rem);
    font-weight: 720;
    font-stretch: 84%;
    line-height: 1;
    letter-spacing: -0.028em;
    max-width: 17em;
  }
  .rb__kunye {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block-start: clamp(1rem, 2vw, 1.5rem);
    padding: 0;
    list-style: none;
    font-size: var(--b-kucuk);
    line-height: 1.3;
    color: var(--ikincil);
  }
  .rb__kunye li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .rb__kunye :global(svg) {
    flex: none;
    color: var(--kirmizi);
  }
  .rb__konu {
    padding: 0.32em 0.65em 0.36em;
    border-radius: 2px;
    background: var(--mavi-acik);
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 650;
    color: var(--mavi-koyu);
  }
  .rb__konu + .rb__konu {
    margin-inline-start: -0.75rem;
  }
  .rb__cevap {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    width: 100%;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.15rem, 2.2vw, 1.75rem) clamp(1.15rem, 2.4vw, 2rem) clamp(1.25rem, 2.4vw, 1.9rem);
    background: var(--beyaz);
    border: 1.5px solid var(--murekkep);
    border-radius: var(--kose);
    box-shadow: 0.35rem 0.35rem 0 var(--mavi-acik);
  }
  .rb__cevap-ad {
    font-size: 1.0625rem;
    font-weight: 680;
    font-stretch: 94%;
    letter-spacing: -0.004em;
    line-height: 1.3;
  }
  .rb__cevap-metni {
    font-size: var(--b-giris);
    line-height: 1.46;
    color: var(--murekkep);
    max-width: 41em;
  }
  .rb__cizim {
    grid-column: 9 / -1;
    margin: -1rem -1rem -1rem 0;
  }
  /* Kapaklı yazı: metin yedi sütun, kapak sahnesi beş sütun. Sahne, masadaki bir fotoğraf gibi sert gölgeyle durur. */
  .rb--kapakli .rb__metin {
    grid-column: 1 / span 7;
  }
  .rb--kapakli .rb__soru {
    font-size: clamp(2.05rem, 1.35rem + 2.3vw, 3.4rem);
  }
  .rb__kapak {
    grid-column: 8 / -1;
    overflow: hidden;
    border-radius: var(--kose);
    box-shadow: 0.5rem 0.5rem 0 var(--mavi-acik);
  }
  .rb__kapak :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  /* Yanıtlanan aramalar: küçük arama kutuları. */
  .rb__aramalar {
    display: grid;
    gap: 0.5rem;
    margin-block-start: clamp(1.1rem, 2vw, 1.5rem);
  }
  .rb__aramalar-ad {
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 640;
    color: var(--ikincil);
  }
  .rb__aramalar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }
  .rb__aramalar li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.36rem 0.8rem 0.4rem 0.65rem;
    background: var(--beyaz);
    border: 1px solid var(--cizgi-koyu);
    border-radius: 999px;
    font-family: var(--yazi-baslik);
    font-size: var(--b-kucuk);
    font-weight: 540;
    line-height: 1.15;
    color: var(--murekkep);
  }
  .rb__aramalar li :global(svg) {
    flex: none;
    color: var(--mavi);
  }
  @media (max-width: 61.99rem) {
    .rb__ic {
      row-gap: 1rem;
    }
    .rb__metin {
      grid-column: 1 / -1;
    }
    .rb__cizim {
      grid-column: 1 / -1;
      grid-row: 2;
      width: min(46%, 13rem);
      margin: -0.25rem 0 -0.75rem -0.75rem;
    }
    /* Dar ekranda sıra: soru, künye, kapak, aramalar, kısa cevap. Metin kutusu çözülür, parçalar sıraya girer. */
    .rb--kapakli .rb__metin {
      display: contents;
    }
    .rb--kapakli .rb__metin > * {
      grid-column: 1 / -1;
      margin-block-start: 0;
    }
    .rb--kapakli .rb__kirinti {
      order: 0;
    }
    .rb--kapakli .rb__soru {
