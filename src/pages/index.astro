  { terim: 'google’a reklam vermek', hacim: '5.400' },
  { terim: 'seo ajansı', hacim: '8.100' },
  { terim: 'instagram reklam verme', hacim: '5.400' },
  { terim: 'web sitesi yaptırmak', hacim: '590' },
  { terim: 'reklam ajansı', hacim: '6.600' },
  { terim: 'dijital pazarlama ajansı', hacim: '2.400' },
];

