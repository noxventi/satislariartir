      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Üçerli düzen: görsel üstte, ad altında; bütün karolar aynı ölçüde, sırada yetim karo kalmaz. */
    .sektor-seridi__liste--uclu {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sektor-seridi__liste--uclu a {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 0.45rem;
      align-items: start;
      min-height: 0;
      padding: 0.3rem 0.3rem 0.6rem;
    }
    .sektor-seridi__liste--uclu .sektor-seridi__gorsel {
      aspect-ratio: 4 / 3;
    }
    .sektor-seridi__liste--uclu strong {
      padding-inline: 0.25rem;
      font-size: 0.8125rem;
      line-height: 1.16;
    }
  }
  .yol__izgara {
    --sira-arasi: clamp(2.5rem, 4.6vw, 4.25rem);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 0.7rem;
  }
  .yol__oge {
    grid-column: span 2;
    grid-row: span 5;
    display: grid;
    grid-template-rows: subgrid;
    justify-items: start;
    align-items: start;
  }
  /* İkinci kart sırası: boşluk görselin üstünden verilir (satırlar ortak olduğu için hizayı bozmaz). */
  .yol__oge:nth-child(n + 3) .yol__gorsel {
    margin-block-start: var(--sira-arasi);
  }
  @supports not (grid-template-rows: subgrid) {
    .yol__oge {
      grid-row: auto;
      grid-template-rows: auto auto auto 1fr auto;
    }
  }
  .yol__oge--1,
  .yol__oge--2 {
    grid-column: span 3;
  }
  .yol__gorsel {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--kose);
    margin-block-end: 0.4rem;
  }
  .yol__gorsel :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 900ms var(--yumusak);
  }
  .yol__oge--1 .yol__gorsel :global(img),
  .yol__oge--2 .yol__gorsel :global(img) {
    aspect-ratio: 16 / 10;
  }
  /* Dikey sahnelerin yatay kırpımında anlatan kısım kadrajda kalsın. */
  .yol__oge--2 .yol__gorsel :global(img) {
    object-position: 50% 44%;
  }
  .yol__oge--3 .yol__gorsel :global(img) {
    object-position: 50% 50%;
  }
  .yol__oge--4 .yol__gorsel :global(img) {
    object-position: 50% 38%;
  }
  .yol__oge--5 .yol__gorsel :global(img) {
    object-position: 50% 32%;
  }
  .yol__oge:hover .yol__gorsel :global(img) {
    transform: scale(1.03);
  }
  /* Üst satır: müşterinin o andaki davranışı. Başlık: hizmetin aranan adı. */
  .yol__davranis {
    font-family: var(--yazi-baslik);
    font-size: var(--b-kucuk);
    font-weight: 620;
    font-stretch: 96%;
    line-height: 1.3;
    color: var(--mavi);
  }
  .yol__ad {
    font-size: clamp(1.4rem, 1.12rem + 1vw, 1.95rem);
    font-weight: 700;
    font-stretch: 87%;
    line-height: 1.06;
    letter-spacing: -0.022em;
    margin-block-start: -0.3rem;
    text-wrap: balance;
  }
  .yol__oge--1 .yol__ad,
  .yol__oge--2 .yol__ad {
    font-size: clamp(1.6rem, 1.15rem + 1.5vw, 2.4rem);
  }
  .yol__is {
    color: var(--murekkep-2);
    max-width: 34em;
  }
  .yol__oge > :global(.ok-bag) {
    align-self: end;
  }
  @media (prefers-reduced-motion: reduce) {
    .yol__gorsel :global(img) {
      transition: none;
    }
  }
  @media (max-width: 61.99rem) {
    .yol__oge[class] {
      grid-column: span 3;
    }
    .yol__oge[class] .yol__gorsel :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 47.99rem) {
    .yol__izgara {
      --sira-arasi: 2.25rem;
    }
    .yol__oge[class] {
      grid-column: 1 / -1;
    }
    .yol__oge + .yol__oge .yol__gorsel {
      margin-block-start: var(--sira-arasi);
    }
  }

  /* ---- İz ------------------------------------------------------------------- */
  .iz__ust {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 1.75rem;
    align-items: end;
  }
  .iz__soru {
    grid-column: 1 / span 7;
    font-size: clamp(2.3rem, 0.9rem + 4.3vw, 4.6rem);
    max-width: 10.5em;
  }
  /* Altı çizili söz satır ortasında bölünmesin. */
  .iz__soru :global(.isaret) {
    white-space: nowrap;
  }
  .iz__aciklama {
    grid-column: 8 / -1;
    display: grid;
    gap: 0.9rem;
    padding-block-end: 0.6rem;
  }
  .iz__yol {
    --cizgi-y: 0.6rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.2vw, 2.25rem);
    margin-block-start: clamp(2.75rem, 5vw, 4.5rem);
  }
  /* Kırmızı kalem çizgisi: incelemeden hedefe tek hat. */
  .iz__yol::before {
    content: '';
    position: absolute;
    inset-inline: 0.4rem 0;
    top: var(--cizgi-y);
    height: 3px;
    background: var(--kirmizi);
    transform-origin: left center;
    filter: url(#kalem-dokusu);
  }
  .iz__durak {
    position: relative;
    padding-block-start: 3rem;
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .iz__durak h3 {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.1rem);
    font-weight: 700;
    font-stretch: 86%;
    letter-spacing: -0.022em;
    line-height: 1.02;
  }
  .iz__nokta {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--beyaz);
    border: 3px solid var(--kirmizi);
  }
  .iz__durak:last-child .iz__nokta {
    background: var(--kirmizi);
    box-shadow: 0 0 0 4px rgb(185 35 56 / 0.16);
  }
  .iz__ornek {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.3;
    color: var(--murekkep);
    margin-block-start: 0.2rem;
  }
  .iz__ornek {
    font-weight: 600;
  }
  .iz__kontrol {
    max-width: 16em;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .iz__yol[data-gir] {
      opacity: 1;
      transform: none;
    }
    :global(.js) .iz__yol[data-gir]::before {
      transform: scaleX(0);
      transition: transform 1400ms cubic-bezier(0.6, 0.05, 0.25, 1) 150ms;
    }
    :global(.js) .iz__yol[data-gir] .iz__durak {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 500ms var(--yumusak) calc(200ms + var(--sira) * 240ms),
        transform 600ms var(--yumusak) calc(200ms + var(--sira) * 240ms);
    }
    :global(.js) .iz__yol[data-gir]:global(.girdi-goruldu)::before {
      transform: none;
    }
    :global(.js) .iz__yol[data-gir]:global(.girdi-goruldu) .iz__durak {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 55.99rem) {
    .iz__soru,
    .iz__aciklama {
      grid-column: 1 / -1;
    }
    .iz__yol {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }
    .iz__yol::before {
      inset-inline: 0.55rem auto;
      inset-block: 0.5rem 1.5rem;
      width: 3px;
      height: auto;
      transform-origin: center top;
    }
    .iz__durak {
      padding-block-start: 0;
      padding-inline-start: 2.5rem;
      gap: 0.3rem;
    }
    .iz__nokta {
      top: 0.2rem;
    }
    .iz__kontrol {
      max-width: none;
    }
  }
  @media (max-width: 55.99rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .iz__yol[data-gir]::before {
      transform: scaleY(0);
    }
  }
  /* ---- Markalar ----------------------------------------------------------------
     Altı canlı sitenin ilk ekranı: aynı ölçüde çerçeveler, üç sütunlu düz ızgara. Altında markanın logosu,
     sektörü ve yapılan iş aynı hizada durur. */
  .marka__ust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.25rem 2rem;
    margin-block-end: clamp(2rem, 4vw, 3.25rem);
  }
  .marka__ust > div {
    display: grid;
    gap: 1.1rem;
    max-width: 44rem;
  }
  .marka__izgara {
    --sira-arasi: clamp(1.75rem, 3.4vw, 2.75rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.25rem);
    row-gap: 0.85rem;
  }
  .marka__oge {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
  }
  .marka__kart {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-items: start;
    color: var(--murekkep);
    text-decoration: none;
  }
  /* Sonraki kart sıraları: boşluk ekran görüntüsünün üstünden verilir. */
  .marka__oge:nth-child(n + 4) .marka__ekran {
    margin-block-start: var(--sira-arasi);
  }
  @supports not (grid-template-rows: subgrid) {
    .marka__oge,
    .marka__kart {
      grid-row: auto;
      grid-template-rows: auto auto 1fr;
    }
  }
  /* Tarayıcı penceresi: ince çubuk, üç nokta, altında sitenin ilk ekranı. */
  .marka__ekran {
    display: block;
    overflow: hidden;
    background: var(--beyaz);
    border: 1.5px solid var(--murekkep);
    border-radius: var(--kose);
    box-shadow: 0.4rem 0.4rem 0 var(--mavi-acik);
    transition:
      transform 260ms var(--yumusak),
      box-shadow 260ms var(--yumusak);
  }
  .marka__cubuk {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.5rem;
    padding-inline: 0.65rem;
    border-block-end: 1.5px solid var(--murekkep);
    background: var(--kagit);
  }
  .marka__cubuk i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--cizgi-koyu);
  }
  .marka__cubuk i:first-child {
    background: var(--kirmizi);
  }
  .marka__ekran :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 0;
  }
  .marka__logo {
    display: flex;
    align-items: center;
    height: 2.5rem;
    margin-block-start: 0.5rem;
  }
  .marka__logo img {
    width: auto;
    height: auto;
    max-width: 10.5rem;
    max-height: 100%;
  }
  .marka__bilgi {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }
  .marka__sektor {
    font-family: var(--yazi-baslik);
    font-size: var(--b-kucuk);
    font-weight: 640;
    color: var(--mavi);
  }
  .marka__is {
    font-size: var(--b-kucuk);
    line-height: 1.45;
    color: var(--murekkep-2);
  }
  @media (hover: hover) {
    .marka__kart:hover .marka__ekran {
      transform: translate(-3px, -3px);
      box-shadow: 0.65rem 0.65rem 0 var(--mavi-acik);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marka__ekran {
      transition: none;
    }
    .marka__kart:hover .marka__ekran {
      transform: none;
    }
  }
  @media (max-width: 61.99rem) {
    .marka__izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .marka__oge:nth-child(n + 3) .marka__ekran {
      margin-block-start: var(--sira-arasi);
    }
  }
  /* Telefon: altı site iki sütunda, küçük pencereler hâlinde bir arada görünür; alt alta altı tam ekran dizilmez. */
  @media (max-width: 43.99rem) {
    .marka__ust {
      grid-template-columns: minmax(0, 1fr);
    }
    .marka__ust :global(.ok-bag) {
      justify-self: start;
    }
    .marka__izgara {
      --sira-arasi: 1.6rem;
      column-gap: 0.85rem;
      row-gap: 0.55rem;
    }
    .marka__ekran {
      box-shadow: 0.25rem 0.25rem 0 var(--mavi-acik);
    }
    .marka__cubuk {
      gap: 0.22rem;
      height: 1rem;
      padding-inline: 0.45rem;
    }
    .marka__cubuk i {
      width: 0.28rem;
      height: 0.28rem;
    }
    .marka__logo {
      height: 2rem;
      margin-block-start: 0.4rem;
    }
    .marka__logo img {
      max-width: min(100%, 8rem);
    }
    .marka__sektor,
    .marka__is {
      font-size: 0.8125rem;
      line-height: 1.35;
    }
  }

  /* ---- Müşteri yorumları ---------------------------------------------------------
     Lacivert bölüm. Kartlar yana kayar (dokunarak, klavyeyle ya da oklarla); hepsi aynı yükseklikte.
     Alttaki kırmızı kalem çizgisi görülen kısım kadar uzar. */
  .yorum {
    --serit-kenar: max(var(--kenar), calc((100vw - var(--genislik)) / 2));
    background: var(--murekkep);
    color: var(--beyaz);
    overflow: clip;
  }
  .yorum__ust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.25rem 2rem;
    margin-block-end: clamp(1.75rem, 3.5vw, 3rem);
  }
  .yorum__ust > div:first-child {
    display: grid;
    gap: 1rem;
  }
  .yorum__ust .giris {
    color: rgb(255 255 255 / 0.78);
  }
  .yorum__oklar {
    display: flex;
    gap: 0.6rem;
  }
  .yorum__oklar button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1.5px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: none;
    color: var(--beyaz);
    cursor: pointer;
    transition:
      background-color 180ms,
      color 180ms,
      border-color 180ms,
      opacity 180ms;
  }
  .yorum__oklar button:disabled {
    opacity: 0.32;
    cursor: default;
  }
  @media (hover: hover) {
    .yorum__oklar button:not(:disabled):hover {
      background: var(--beyaz);
      border-color: var(--beyaz);
      color: var(--murekkep);
    }
  }
  .yorum__serit {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--serit-kenar);
    scrollbar-width: none;
    padding-block: 0.5rem 0.9rem;
  }
  .yorum__serit::-webkit-scrollbar {
    display: none;
  }
  .yorum__serit:focus-visible {
    outline: 2px solid var(--beyaz);
    outline-offset: -4px;
  }
  .yorum__liste {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.4rem);
    width: max-content;
    padding-inline: var(--serit-kenar);
  }
  .yorum__kart {
    flex: none;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    width: clamp(17.5rem, 30vw, 26.5rem);
    padding: clamp(1.5rem, 2.4vw, 2.25rem);
    background: var(--kagit);
    border-radius: var(--kose);
    box-shadow: 0.4rem 0.4rem 0 rgb(0 0 0 / 0.28);
    color: var(--murekkep);
    scroll-snap-align: start;
  }
  .yorum__tirnak {
    display: block;
    height: 2.2rem;
    font-family: var(--yazi-baslik);
    font-size: 5.5rem;
    font-weight: 800;
    line-height: 0.9;
    color: var(--kirmizi);
  }
  .yorum__soz p {
    font-family: var(--yazi-baslik);
    font-size: clamp(1.125rem, 1.02rem + 0.42vw, 1.375rem);
    font-weight: 560;
    font-stretch: 95%;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .yorum__soz--buyuk p {
    font-size: clamp(1.45rem, 1.2rem + 1vw, 1.95rem);
    font-weight: 600;
    font-stretch: 90%;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .yorum__soz--kucuk p {
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    font-weight: 540;
    line-height: 1.36;
    letter-spacing: -0.006em;
  }
  .yorum__kim {
    display: grid;
    gap: 0.5rem;
    padding-block-start: 0.5rem;
  }
  .yorum__logo {
    width: auto;
    height: auto;
    max-width: 9rem;
    max-height: 2rem;
    margin-block-end: 0.3rem;
  }
  .yorum__ad {
    display: grid;
    gap: 0.05rem;
    line-height: 1.3;
  }
  .yorum__ad strong {
    font-family: var(--yazi-baslik);
    font-weight: 680;
    font-stretch: 94%;
  }
  .yorum__ad span {
    font-size: var(--b-kucuk);
    color: var(--murekkep-2);
  }
  .yorum__is {
    font-size: var(--b-mikro);
    color: var(--ikincil);
  }
  .yorum__ilerleme {
    height: 3px;
    margin-block-start: clamp(1.25rem, 2.5vw, 2rem);
    background: rgb(255 255 255 / 0.16);
    border-radius: 2px;
    overflow: hidden;
  }
  .yorum__ilerleme span {
    display: block;
    height: 100%;
    background: #ff6b7f;
    transform: scaleX(var(--dolu, 0.34));
    transform-origin: left center;
    transition: transform 220ms var(--yumusak);
  }
  @media (max-width: 47.99rem) {
    .yorum__kart {
      width: min(82vw, 21rem);
    }
    .yorum__oklar button {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* ---- Bilgi ------------------------------------------------------------------- */
  .bilgi__ic {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: center;
  }
  .bilgi__giris {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .bilgi__cizim {
    width: min(100%, 24rem);
    margin: -1rem 0 -0.5rem -1rem;
  }
  .bilgi__liste {
    display: grid;
    gap: clamp(0.6rem, 1.2vw, 1rem);
  }
  .bilgi__kart {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    padding-inline-end: clamp(3.5rem, 6vw, 5rem);
    border-radius: var(--kose);
    background: var(--kagit);
    color: var(--murekkep);
    text-decoration: none;
    transition: transform 320ms var(--yumusak);
  }
  .bilgi__liste li:nth-child(2) .bilgi__kart {
    background: var(--mavi-acik);
  }
  .bilgi__kart p {
    color: var(--murekkep-2);
    max-width: 36em;
  }
  .bilgi__ok {
    position: absolute;
    inset-inline-end: clamp(1.1rem, 2vw, 1.75rem);
    top: 50%;
    translate: 0 -50%;
    color: var(--kirmizi);
    transition: transform 280ms var(--yumusak);
  }
  .bilgi__kart:hover {
    transform: translateX(-4px);
  }
  .bilgi__kart:hover .bilgi__ok {
    transform: translateX(6px);
  }
  @media (max-width: 55.99rem) {
    .bilgi__ic {
      grid-template-columns: 1fr;
    }
    .bilgi__cizim {
      width: min(72%, 19rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bilgi__kart,
    .bilgi__ok {
      transition: none;
    }
  }

  /* ---- Sık sorulan sorular ---------------------------------------------------------
     Her soru üst alandaki arama kutusunun küçüğüdür: büyüteç, soru, açınca altında yanıt. */
  .sss__ic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 2rem;
    align-items: start;
  }
  .sss__giris {
    grid-column: 1 / span 4;
    position: sticky;
    top: calc(var(--ust-bant) + 2rem);
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .sss__liste {
    grid-column: 6 / -1;
    display: grid;
    gap: 0.8rem;
  }
  .sss__oge {
