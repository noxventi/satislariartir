import defter from '../assets/cizimler/defter.png';

import yolArama from '../assets/gorseller/yol-arama.jpg';
import yolAkis from '../assets/gorseller/yol-akis.jpg';
import yolCevap from '../assets/gorseller/yol-cevap.jpg';
import yolYapayZeka from '../assets/gorseller/yol-yapay-zeka.jpg';
import yolSite from '../assets/gorseller/yol-site.jpg';
import ilkAdim from '../assets/gorseller/ilk-adim.jpg';


const ANA_CAGRI = 'Satışlarımı artırmak istiyorum';

const ekranlar = import.meta.glob<{ default: ImageMetadata }>('../assets/projeler/*-masaustu.jpg', { eager: true });
const logoDosyalari = import.meta.glob<{ default: ImageMetadata }>('../assets/logolar/*.png', { eager: true });
const logoBul = (kimlik: string) => logoDosyalari['../assets/logolar/' + kimlik + '.png']?.default;
const isAdlari: Record<string, string> = {
  'Web sitesi tasarımı': 'Web tasarım',
  'SEO ve GEO': 'SEO ve GEO',
  SEO: 'SEO',
  'Dijital reklam yönetimi': 'Reklam yönetimi',
  'Sosyal medya yönetimi': 'Sosyal medya',
  'CRM yapısı': 'CRM',
};

/** Çalıştığımız markalar: altı canlı sitenin masaüstü ilk ekranı, hepsi aynı ölçüde, düz bir ızgarada. */
const vitrin = ['celikvillam', 'tarum-havuz', 'burger-engineer', 'estika', 'bodrum-olive-house', 'esvia'].map((kimlik) => {
  const p = PROJELER.find((x) => x.kimlik === kimlik)!;
  return {
    ad: p.siteAdi ?? p.marka,
    sektor: p.sektor,
    // İlk iş adı büyük harfle başlar, sonrakiler cümle içinde olduğu için küçük harfle (kısaltmalar hariç).
    isler: p.obrandyKapsami
      .map((k) => isAdlari[k] ?? k)
      .map((k, i) => (i === 0 || /^(SEO|CRM|GEO)/.test(k) ? k : k.charAt(0).toLocaleLowerCase('tr') + k.slice(1)))
      .join(', '),
    url: p.dosya ?? '/calismalarimiz/',
    ekran: ekranlar['../assets/projeler/' + p.alanAdi.split('.')[0] + '-masaustu.jpg'].default,
    logo: logoBul(kimlik),
  };
});

/** Müşteri yorumları: sözler veride kelimesi kelimesine durur (src/data/projeler.ts). */
const yorumlar = MUSTERI_YORUMLARI.map((y) => ({
  ...y,
  logo: logoBul(y.kimlik),
  // Kısa söz büyük, uzun söz küçük dizilir: kartlar aynı yükseklikte kalır, boşluk kalmaz.
  boy: y.soz.length < 125 ? 'buyuk' : y.soz.length < 230 ? 'orta' : 'kucuk',
}));
