import kapakMasaustu from '../assets/gorseller/kapak-masaustu.jpg';
import kapakMobil from '../assets/gorseller/kapak-mobil.jpg';
import megafon from '../assets/cizimler/megafon.png';
import mesaj from '../assets/cizimler/mesaj.png';
