    care: 'Müşterilerinizin sorduğu soruları belirliyor, yanıtlarda adınızın geçip geçmediğini ölçüyor ve kaynak gösterilen sayfaları düzeltiyoruz.',
    bag: { etiket: 'GEO ve AEO danışmanlığı', url: geo.url },
