<script>
  // Üst alandaki arama satırı: gerçek aramalar sırayla yazılır, kırmızı kalemle çizilir.
  // Betik yoksa ya da hareket azaltılmışsa ilk arama sabit olarak görünür.
  const kok = document.querySelector<HTMLElement>('[data-ara]');
  const liste = [...document.querySelectorAll<HTMLElement>('[data-aramalar] li')].map((li) => ({
    terim: li.dataset.terim || '',
    hacim: li.dataset.hacim || '',
  }));
  if (kok && liste.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const yazi = kok.querySelector<HTMLElement>('[data-yazi]')!;
    const sayi = kok.querySelector<HTMLElement>('[data-sayi]')!;
    const bekle = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let gorunur = true;
    new IntersectionObserver(([g]) => (gorunur = g.isIntersecting)).observe(kok);

    (async () => {
      let i = 0;
      // İlk arama sayfayla birlikte yazılı gelir: yalnız çizilir.
      for (;;) {
        await bekle(1700);
        kok.setAttribute('data-cizili', '');
        await bekle(1300);
        while (!gorunur || document.hidden) await bekle(600);
        i = (i + 1) % liste.length;
        kok.removeAttribute('data-cizili');
        kok.setAttribute('data-yaziyor', '');
        yazi.textContent = '';
        sayi.textContent = liste[i].hacim;
        for (const harf of liste[i].terim) {
          yazi.textContent += harf;
          await bekle(42 + Math.random() * 38);
        }
        kok.removeAttribute('data-yaziyor');
      }
    })();
  } else if (kok) {
    kok.setAttribute('data-cizili', '');
  }

  // Müşteri yorumları: oklar bir kart kaydırır, alttaki kırmızı çizgi görülen kısmı gösterir.
  const serit = document.querySelector<HTMLElement>('[data-yorum-serit]');
  if (serit) {
    const oklar = [...document.querySelectorAll<HTMLButtonElement>('[data-yorum-oklar] button')];
    const cizgi = document.querySelector<HTMLElement>('[data-yorum-cizgi]');
    const guncelle = () => {
      const enCok = serit.scrollWidth - serit.clientWidth;
      cizgi?.style.setProperty('--dolu', String(Math.min(1, (serit.scrollLeft + serit.clientWidth) / serit.scrollWidth)));
      oklar.forEach((o) => (o.disabled = o.dataset.yon === '-1' ? serit.scrollLeft < 8 : serit.scrollLeft > enCok - 8));
    };
    oklar.forEach((o) =>
      o.addEventListener('click', () => {
        const kart = serit.querySelector<HTMLElement>('.yorum__kart');
        const adim = kart ? kart.offsetWidth + parseFloat(getComputedStyle(kart.parentElement!).columnGap || '0') : serit.clientWidth * 0.8;
        serit.scrollBy({ left: Number(o.dataset.yon) * adim, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }),
    );
    serit.addEventListener('scroll', guncelle, { passive: true });
    addEventListener('resize', guncelle);
    guncelle();
  }
</script>

