---
/**
 * Çalışmalar sayfası. Sıra: kısa başlık, sağlık vitrini (sayfanın odağı), diğer sektörlerin iki ayrıntılı dosyası,
 * yayındaki sitelerin duvarı.
 *
 * - Görüntüler canlı sitelerin kendisidir (araclar/proje-ekran.mjs), üretilmiş ya da taklit edilmiş değildir.
 * - Web tasarımı yapılmayan projelerde (yalnız reklam ya da SEO) site görüntüsü kullanılmaz: tasarım ekibe atfedilmez.
 * - Kişi portresi gösterilmez. Doç. Dr. Pınar Taşdemir'in sitesinden yalnız portre içermeyen iki kesit kullanılır:
 *   masaüstü ilk ekranın yazı tarafı ve telefondaki uygulamalar bölümü (alındığı gün: SAGLIK_EKRAN_TARIHI).
 *   Avukat sitesi duvarda yazı karosuyla durur.
 * - Sağlık markalarında reklam yönetimi satırı yoktur. Hekim sözleri MUSTERI_YORUMLARI kaydından kelimesi kelimesine gelir.
 * - Ölçülmüş sonuç hiçbir kayıtta yer almaz.
 */
import type { ImageMetadata } from 'astro';
import Temel from '../../layouts/Temel.astro';
import GorusmeBandi from '../../components/GorusmeBandi.astro';
import Gorsel from '../../components/Gorsel.astro';
import Ikon from '../../components/Ikon.astro';
import Isaret from '../../components/Isaret.astro';
import { KAYNAK_KONTROL_TARIHI, MUSTERI_SOZLERI, MUSTERI_YORUMLARI, PROJELER, projeBul, type Proje } from '../../data/projeler';
import { SEKTORLER, sektorGorseli, sektorUrl } from '../../data/sektorler';
import pinarIlkEkran from '../../assets/projeler/kayseridermatolog-ayrinti.jpg';
import pinarTelefon from '../../assets/projeler/kayseridermatolog-uygulamalar.jpg';

const CAGRI = 'Benzer bir projeyi görüşelim';
const SAGLIK = 'Sağlık';
const SAGLIK_EKRAN_TARIHI = '19 Kasım 2026';
const kirintilar = [{ ad: 'Çalışmalarımız', url: '/calismalarimiz/' }];
const sektorSayisi = new Set(PROJELER.map((p) => p.sektor)).size;

const ekranlar = import.meta.glob<{ default: ImageMetadata }>('../../assets/projeler/*.jpg', { eager: true });
const ekranBul = (p: Proje, tur: 'masaustu' | 'mobil') => ekranlar[`../../assets/projeler/${p.alanAdi.split('.')[0]}-${tur}.jpg`]?.default;
const logolar = import.meta.glob<{ default: ImageMetadata }>('../../assets/logolar/*.png', { eager: true });
const logoBul = (kimlik: string) => logolar[`../../assets/logolar/${kimlik}.png`]?.default;

const isler = (p: Proje) => [
  ...p.obrandyKapsami,
  ...(p.reklamYonetimi === 'beyan' && !p.obrandyKapsami.includes('Dijital reklam yönetimi') ? ['Google Ads ve Meta yönetimi'] : []),
];
/** Süzgeç anahtarları. */
const turler = (p: Proje) =>
  [
    p.obrandyKapsami.includes('Web sitesi tasarımı') && 'web',
    p.obrandyKapsami.some((k) => k.startsWith('SEO')) && 'seo',
    p.reklamYonetimi === 'beyan' && 'reklam',
  ].filter(Boolean) as string[];

// ---- Sağlık vitrini -------------------------------------------------------------------------------
const hekimler = PROJELER.filter((p) => p.sektor === SAGLIK);
const SAYI_ADLARI = ['', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz'];
const hekimSayisi = SAYI_ADLARI[hekimler.length] ?? String(hekimler.length);
const pinar = projeBul('pinar-tasdemir');
const pinarLogo = logoBul(pinar.kimlik);
/** İki hekimin kayıtlı sözü. Kısa söz büyük, uzun söz küçük dizilir; kartlar aynı yükseklikte kalır. */
const hekimSozleri = ['emre-apaydin', 'belda-yurtseven-tuner'].map((kimlik) => {
  const p = projeBul(kimlik);
  const y = MUSTERI_YORUMLARI.find((x) => x.kimlik === kimlik);
  if (!y) throw new Error(`Çalışmalar: "${kimlik}" için kayıtlı müşteri sözü yok.`);
  return { p, y, logo: logoBul(kimlik), boy: y.soz.length < 160 ? 'buyuk' : 'kucuk' };
});
/** Sağlıkta çalıştığımız iki alanın sektör sayfası. */
const saglikAlanlari = [
  { kimlik: 'saglik-ve-klinikler', ust: 'Hekim, muayenehane, klinik, diş hekimi' },
  { kimlik: 'saglik-turizmi', ust: 'Yetki belgeli klinik ve hastaneler' },
].map(({ kimlik, ust }) => {
  const s = SEKTORLER.find((x) => x.kimlik === kimlik);
  if (!s) throw new Error(`Çalışmalar: "${kimlik}" sektör kaydı yok.`);
  return { ust, ad: s.ad, ozet: s.ozet, url: sektorUrl(s), gorsel: sektorGorseli(kimlik) };
});

// ---- Diğer sektörler ----------------------------------------------------------------------------
const digerleri = PROJELER.filter((p) => p.sektor !== SAGLIK);
const digerSektorSayisi = new Set(digerleri.map((p) => p.sektor)).size;
const celik = projeBul('celikvillam');
const hun = projeBul('hun-education');
const soz = MUSTERI_SOZLERI['hun-education'];

/**
 * Duvarın dizilişi. G: masaüstü görüntüsü (geniş), D: telefon görüntüsü (dar), T: yazı karosu.
 * Her satır 12 sütunu doldurur: G D D / D G T / T D G / D D D D. Sağlık projeleri yukarıdaki vitrinde durur.
 */
const dizilis: [string, 'G' | 'D' | 'T'][] = [
  ['burger-engineer', 'G'],
  ['tarum-havuz', 'D'],
  ['estika', 'D'],
  ['esvia', 'D'],
  ['white-earth-atelier', 'G'],
  ['1001-art', 'T'],
  ['suha-akyildiz', 'T'],
  ['rotech-danismanlik', 'D'],
  ['rotech-defense', 'G'],
  ['bodrum-olive-house', 'D'],
  ['yurt-disi-egitim-rehberim', 'D'],
  ['eduregist', 'D'],
  ['ilk-gunebakan', 'D'],
];
const RENKLER = ['mavi', 'acik', 'murekkep'];
let yaziSirasi = 0;
const duvar = dizilis.map(([kimlik, istenen]) => {
  const p = projeBul(kimlik);
  const gorsel = istenen === 'T' ? undefined : ekranBul(p, istenen === 'G' ? 'masaustu' : 'mobil');
  const tur = gorsel ? istenen : 'T';
  return { p, tur, gorsel, isler: isler(p), turler: turler(p), renk: tur === 'T' ? RENKLER[yaziSirasi++ % RENKLER.length] : '' };
});

const suzgecler = [
  { anahtar: 'hepsi', etiket: 'Hepsi', adet: duvar.length },
  { anahtar: 'web', etiket: 'Web tasarım', adet: duvar.filter((d) => d.turler.includes('web')).length },
  { anahtar: 'seo', etiket: 'SEO ve GEO', adet: duvar.filter((d) => d.turler.includes('seo')).length },
  { anahtar: 'reklam', etiket: 'Reklam yönetimi', adet: duvar.filter((d) => d.turler.includes('reklam')).length },
];
---

<Temel
  baslik="Projeler ve Müşteri Görüşleri | Satışları Artır"
  aciklama={`Hekim sitelerinden üretime yürüttüğümüz seçili projeler: sağlıkta web tasarım, SEO ve GEO çalışmaları ve ${sektorSayisi} sektörden ${PROJELER.length} marka.`}
  sayfaTuru="projeler"
  kirintilar={kirintilar}
  cagri={{ etiket: CAGRI, url: '#gorusme' }}
>
  <!-- Başlık -->
  <section class="cb">
    <div class="sarici">
      <nav aria-label="Sayfa konumu">
        <ol class="kirinti">
          <li><a href="/">Ana sayfa</a></li>
          <li><span aria-current="page">Çalışmalarımız</span></li>
        </ol>
      </nav>
      <div class="cb__ic">
        <h1 class="dev cb__baslik">Çalıştığımız markalar</h1>
        <p class="giris cb__giris">
          Sağlıktan eğitime, yapıdan üretime {sektorSayisi} sektörden {PROJELER.length} marka. Görüntüler yayındaki
          sitelerin kendisi: dokunun, canlı siteyi açıp kendiniz inceleyin.
        </p>
      </div>
    </div>
  </section>

  <!-- Sağlık vitrini -->
  <section class="saglik koyu-zemin" id="saglik" aria-labelledby="saglik-baslik">
    <div class="sarici">
      <header class="saglik__bas">
        <p class="etiket saglik__etiket">Sağlık ve klinikler</p>
        <h2 class="saglik__baslik" id="saglik-baslik">
          <Isaret tip="alt">Hekimlerle</Isaret> yürüttüğümüz çalışmalar
        </h2>
        <p class="giris saglik__giris">
          Ankara, Eskişehir ve Kayseri’de {hekimSayisi} hekimin yayındaki sitesi. Tanıtımın kurallara bağlı olduğu bu
          alanda web tasarım, SEO ve GEO üzerinde çalıştık.
        </p>
      </header>

      <!-- Sıra marka sahibinin isteğiyle: önce Emre Apaydın, sonra Belda Yurtseven Tüner, sonra Pınar Taşdemir. -->
      <!-- İki hekimin sözü -->
      <div class="hekim-sozleri">
        <h3 class="gorunmez">Hekimlerin sözleri</h3>
        {
          hekimSozleri.map(({ p, y, logo, boy }) => (
            <figure class="hs">
              <span class="hs__tirnak" aria-hidden="true">
                “
              </span>
              <blockquote class:list={['hs__soz', `hs__soz--${boy}`]}>
                <p>{y.soz}</p>
              </blockquote>
              <figcaption class="hs__kim">
                {logo && <img class="hs__logo" src={logo.src} width={logo.width} height={logo.height} alt="" loading="lazy" decoding="async" />}
                <p class="hs__ad">
                  <strong>{y.kisi}</strong>
                  <span>{y.kurum}</span>
                </p>
                <p class="mikro hs__bilgi">
                  {p.brans}, {p.il}. Yapılan iş: {y.is}
                </p>
                <a class="hs__bag mikro" href={`https://${p.alanAdi}/`} rel="noopener">
                  {p.alanAdi}
                  <Ikon ad="arrow-up-right" boyut={13} />
                </a>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <!-- Web tasarımı da ekibimize ait olan hekim sitesi -->
      <article class="hekim">
        <figure class="hekim__gorsel">
          <a class="hekim__ekran" href={`https://${pinar.alanAdi}/`} rel="noopener" tabindex="-1" aria-hidden="true">
            <Gorsel
              src={pinarIlkEkran}
              alt=""
              sizes="(max-width: 47.99rem) 56vw, (max-width: 61.99rem) 48vw, 34vw"
              genislikler={[480, 720, 960, 1200, 1660]}
              kalite={74}
            />
          </a>
          <span class="hekim__telefon">
            <Gorsel src={pinarTelefon} alt="" sizes="(max-width: 47.99rem) 36vw, (max-width: 61.99rem) 24vw, 16vw" genislikler={[240, 360, 480, 780]} kalite={74} />
          </span>
          <figcaption class="mikro hekim__kaynak">
            {pinar.alanAdi}: masaüstünde ilk ekran, telefonda uygulamalar bölümü ({SAGLIK_EKRAN_TARIHI})
          </figcaption>
        </figure>

        <div class="hekim__metin">
          {pinarLogo && <img class="hekim__logo" src={pinarLogo.src} width={pinarLogo.width} height={pinarLogo.height} alt="Pınar Este-Clinic" loading="lazy" decoding="async" />}
          <p class="etiket hekim__brans">
            <Ikon ad="map-pin" boyut={15} />
            {pinar.brans}, {pinar.il}
          </p>
          <h3 class="hekim__ad">{pinar.marka}</h3>
          <p class="hekim__soru">{pinar.karar}</p>
          <p class="hekim__aciklama">
            Sitenin tasarımını ve sayfa planını bu soruya göre kurduk. SEO ve GEO çalışması aynı plan üzerinde yürüdü.
          </p>
          <ul class="cipler cipler--koyu" aria-label="Yapılan iş">
            {isler(pinar).map((i) => <li>{i}</li>)}
          </ul>
          <a class="dugme dugme--beyaz" href={`https://${pinar.alanAdi}/`} rel="noopener" data-olay="cta_click" data-yer="projeler-saglik-site">
            Canlı siteyi açın
            <Ikon ad="arrow-up-right" boyut={18} />
          </a>
        </div>
      </article>

      <!-- Sağlıkta çalışma biçimi ve iki alanın sayfası -->
      <div class="saglik__alt">
        <div class="ilke">
          <h3 class="ilke__baslik">Sağlıkta nasıl çalışıyoruz?</h3>
          <ul class="ilke__liste">
            <li>
              <strong>Kuralları baştan okuyoruz.</strong>
              <span>Sayfa planını hekimlerin tanıtım kurallarına bakarak, sizinle birlikte çıkarıyoruz.</span>
            </li>
            <li>
              <strong>Metni hekim onaylar.</strong>
              <span>Tıbbi bilgi içeren her sayfa yayından önce hekimin onayına sunulur.</span>
            </li>
            <li>
              <strong>Sonuç sözü vermiyoruz.</strong>
              <span>Hasta sayısı ya da sıralama için söz vermiyoruz. Hedefimiz, hastanın sizi doğru bilgiyle bulması.</span>
            </li>
          </ul>
          <a class="dugme dugme--beyaz" href="#gorusme" data-olay="cta_click" data-yer="projeler-saglik">
            Kliniğiniz için görüşelim
            <Ikon ad="arrow-right" boyut={18} />
          </a>
        </div>

        <ul class="alanlar" aria-label="Sağlıkta çalıştığımız alanlar">
          {
            saglikAlanlari.map((a) => (
              <li>
                <a class="alan-kart" href={a.url}>
                  <span class="alan-kart__gorsel">
                    <Gorsel src={a.gorsel} alt="" sizes="(max-width: 47.99rem) 92vw, (max-width: 61.99rem) 46vw, 28vw" genislikler={[480, 720, 960]} kalite={66} />
                  </span>
                  <span class="etiket alan-kart__ust">{a.ust}</span>
                  <span class="alan-kart__ad">{a.ad}</span>
                  <span class="alan-kart__ozet">{a.ozet}</span>
                  <span class="alan-kart__ok">
                    Nasıl çalıştığımızı okuyun
                    <Ikon ad="arrow-right" boyut={16} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Diğer sektörler: iki ayrıntılı dosya -->
  <section class="bolum diger" id="diger-sektorler" aria-labelledby="diger-baslik">
    <div class="sarici">
      <div class="diger__bas">
        <h2 class="baslik-2" id="diger-baslik">Diğer sektörlerden çalışmalar</h2>
        <p class="giris">
          Yapıdan eğitime, yeme içmeden üretime {digerSektorSayisi} sektörden {digerleri.length} marka. İkisini ayrıntılı
          dosyasıyla anlatıyoruz.
        </p>
      </div>

      <div class="dosyalar">
        <article class="dosya dosya--celik">
          <div class="dosya__metin">
            <p class="etiket">{celik.sektor}</p>
            <h3 class="dosya__ad">{celik.siteAdi}</h3>
            <p class="dosya__karar">{celik.karar}</p>
            <ul class="cipler" aria-label="Yapılan iş">
              {isler(celik).map((i) => <li>{i}</li>)}
            </ul>
            <a class="dugme dugme--murekkep" href={celik.dosya} data-olay="cta_click" data-yer="projeler-dosya">
              Projeyi inceleyin
              <Ikon ad="arrow-right" boyut={18} />
            </a>
          </div>
          <a class="dosya__ekran" href={celik.dosya} tabindex="-1" aria-hidden="true">
            <span class="dosya__masaustu">
              <Gorsel src={ekranBul(celik, 'masaustu')!} alt="" sizes="(max-width: 55.99rem) 92vw, 50vw" genislikler={[640, 960, 1280, 1440]} kalite={72} />
            </span>
            <span class="dosya__telefon">
              <Gorsel src={ekranBul(celik, 'mobil')!} alt="" sizes="(max-width: 55.99rem) 30vw, 14vw" genislikler={[240, 360, 480, 780]} kalite={72} />
            </span>
          </a>
        </article>

        <article class="dosya dosya--hun koyu-zemin">
          <figure class="dosya__soz">
            <blockquote>
              <p>“{soz.soz}”</p>
            </blockquote>
            <figcaption>
              <strong>{soz.kisi}</strong>, {soz.kurum}
            </figcaption>
          </figure>
          <div class="dosya__metin">
            <p class="etiket">{hun.sektor}</p>
            <h3 class="dosya__ad">{hun.marka}</h3>
            <p class="dosya__karar">{hun.karar}</p>
            <ul class="cipler" aria-label="Yapılan iş">
              {isler(hun).map((i) => <li>{i}</li>)}
            </ul>
            <a class="dugme dugme--beyaz" href={hun.dosya} data-olay="cta_click" data-yer="projeler-dosya">
              Projeyi inceleyin
              <Ikon ad="arrow-right" boyut={18} />
            </a>
            <p class="mikro dosya__not">{hun.tasarimNotu}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Duvar -->
  <section class="bolum bolum--beyaz">
    <div class="sarici">
      <div class="duvar-ust">
        <h2 class="baslik-2">Yayındaki siteler</h2>
        <div class="suzgec" role="group" aria-label="Yapılan işe göre süz" data-suzgec>
          {
            suzgecler.map((s, i) => (
              <button type="button" class="suzgec__dugme" data-anahtar={s.anahtar} aria-pressed={i === 0 ? 'true' : 'false'}>
                {s.etiket}
                <span class="rakam">{s.adet}</span>
              </button>
            ))
          }
        </div>
      </div>

      <ul class="duvar" data-duvar>
        {
          duvar.map((d) => {
            const ad = d.p.siteAdi ?? d.p.marka;
            const canli = `https://${d.p.alanAdi}/`;
            return (
              <li class:list={['kare', `kare--${d.tur.toLowerCase()}`, d.renk && `kare--${d.renk}`]} data-turler={d.turler.join(' ')}>
                {d.gorsel ? (
                  <a class="kare__gorsel" href={canli} rel="noopener" aria-label={`${ad}: canlı siteyi açın`}>
                    <Gorsel
                      src={d.gorsel}
                      alt={`${ad} web sitesinin ${d.tur === 'D' ? 'telefondaki' : 'masaüstündeki'} ilk ekranı`}
                      sizes={d.tur === 'G' ? '(max-width: 47.99rem) 100vw, (max-width: 61.99rem) 64vw, 48vw' : '(max-width: 47.99rem) 50vw, (max-width: 61.99rem) 32vw, 24vw'}
                      genislikler={d.tur === 'G' ? [640, 960, 1280, 1440] : [320, 480, 640, 780]}
                      kalite={70}
                    />
                  </a>
                ) : (
                  <a class="kare__yazi" href={canli} rel="noopener" aria-label={`${ad}: canlı siteyi açın`}>
                    <span>{d.p.karar}</span>
                  </a>
                )}
                <div class="kare__metin">
                  <p class="mikro ikincil">{d.p.sektor}</p>
                  <h3 class="kare__ad">{ad}</h3>
                  {d.gorsel && <p class="kucuk kare__karar">{d.p.karar}</p>}
                  <p class="mikro kare__is">{d.isler.join(', ')}</p>
                  <a class="kare__bag mikro" href={canli} rel="noopener">
                    {d.p.alanAdi}
                    <Ikon ad="arrow-up-right" boyut={13} />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
      <p class="duvar__bos kucuk ikincil" data-bos hidden>Bu süzgeçte proje yok.</p>
      <p class="mikro ikincil duvar__tarih">Ekran görüntüleri {KAYNAK_KONTROL_TARIHI} tarihinde alındı. Siteler o günden sonra değişmiş olabilir.</p>
    </div>
  </section>

  <!-- Üç söz -->
  <section class="bolum bolum--siki">
    <div class="sarici">
      <h2 class="baslik-2 soz-baslik">Projeleri anlatırken üç şeye dikkat ediyoruz</h2>
      <ul class="sozler">
        <li>
          <strong>Kanıt canlı sitedir.</strong>
          <span>Her markanın yanında yaptığımız iş ve sitenin adresi yazar. Açıp kendiniz bakabilirsiniz.</span>
        </li>
        <li>
          <strong>Ölçmediğimiz sonucu yazmayız.</strong>
          <span>Müşterinin onayladığı bir ölçüm gelmeden hiçbir projeye sonuç rakamı koymuyoruz.</span>
        </li>
        <li>
          <strong>Sağlıkta reklam referansı göstermeyiz.</strong>
          <span>Hekim sitelerini yalnız web ve arama görünürlüğü işleriyle anlatıyoruz.</span>
        </li>
      </ul>
    </div>
  </section>

  <GorusmeBandi
    baslik="Sıradaki proje sizinki olsun."
    metin="İşletmenizi ve ulaşmak istediğiniz müşteriyi anlatın. Benzer bir işi nasıl kurduğumuzu görüşmede anlatalım."
    cagri={CAGRI}
    konum="projeler"
    kimlik="projeler"
  />
</Temel>

<script>
  // Süzgeç: yalnız göster ve gizle, adres üretmez. Betik yoksa bütün projeler görünür.
  const suzgec = document.querySelector<HTMLElement>('[data-suzgec]');
  const kareler = [...document.querySelectorAll<HTMLElement>('[data-duvar] > li')];
  const bos = document.querySelector<HTMLElement>('[data-bos]');
  suzgec?.addEventListener('click', (e) => {
    const dugme = (e.target as Element).closest<HTMLButtonElement>('button[data-anahtar]');
    if (!dugme) return;
    const anahtar = dugme.dataset.anahtar!;
    suzgec.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === dugme)));
    let gorunen = 0;
    kareler.forEach((k) => {
      const uygun = anahtar === 'hepsi' || (k.dataset.turler || '').split(' ').includes(anahtar);
      k.hidden = !uygun;
      if (uygun) gorunen++;
    });
    if (bos) bos.hidden = gorunen > 0;
