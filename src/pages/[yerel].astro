            <a class="ok-bag" href="/sehirler/">
              Bütün şehirler
              <Ikon ad="arrow-right" boyut={16} />
            </a>
          </div>
          <ul class="bolge__liste">
            {[...sehirSayfasi, ...ilceSayfasi].map((x) => (
              <li>
                <a href={yerelUrl(x)}>
                  <strong>{x.baslik}</strong>
                  <span>{bolgeEtiketi(x)}</span>
                  <Ikon ad="arrow-right" boyut={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Sss baslik={s.sss.baslik} giris={s.sss.giris} sorular={s.sss.sorular} zemin={beyaz('sss') ? 'beyaz' : 'kagit'} />

  <IlgiliSayfalar zemin={beyaz('ilgili') ? 'beyaz' : 'kagit'} sayfalar={h.ilgili} />

  <GorusmeBandi
    baslik={`${yerDeki} işletmeniz için birlikte bakalım.`}
    metin={`İşletmenizi, ${yerAdi} ve çevresinde ulaşmak istediğiniz müşteriyi anlatın. Görüşmeye buradan başlayalım.`}
    kanal={h.kanal}
    cagri={s.cagri}
    konum={`yerel-${s.kimlik}`}
  />
</Temel>

