---
/**
 * Dijital pazarlama sözlüğü (/sozluk/).
 * Amaç: Google’da, ChatGPT, Gemini, Perplexity ve Google’ın yapay zekâ özetlerinde terim sorularına kaynak gösterilecek
 * kısa, doğru ve tek başına alıntılanabilir tanımlar. Veri src/data/sozluk.ts dosyasındadır.
 *
 * Bölümler: üst alan (defter çizimi) > konu kartları (beş kategoriye atlama) > her kategori bir bölüm, terimler iki
 * sütunlu kartlarda (telefonda tek sütun) > A’dan Z’ye dizin > görüşme bandı.
 *
 * - Her terim kartı terimin kimliğiyle çapalanır (/sozluk/#roas). Çapayla gelinen kart kırmızı çerçeveyle belirir.
 * - Kartlar görünüme girerken canlandırılmaz: çapayla gelen okur tanımı beklemeden görmeli.
 * - Yapısal veri: DefinedTermSet ve her terim için DefinedTerm (url = sayfa adresi + #kimlik); kırıntı Temel’den gelir.
 */
import Temel from '../../layouts/Temel.astro';
import GorusmeBandi from '../../components/GorusmeBandi.astro';
import Cizim from '../../components/Cizim.astro';
import Ikon from '../../components/Ikon.astro';
import { SITE } from '../../site.config';
import { tarihYaz } from '../../lib/rehberler';
import { SOZLUK, SOZLUK_KATEGORILERI, SOZLUK_SON_KONTROL, harfDizini, kategoriTerimleri } from '../../data/sozluk';
import type { ImageMetadata } from 'astro';

import defter from '../../assets/cizimler/defter.png';
import megafon from '../../assets/cizimler/megafon.png';
import terazi from '../../assets/cizimler/terazi.png';
import buyutec from '../../assets/cizimler/buyutec.png';
import robot from '../../assets/cizimler/robot.png';
import taslak from '../../assets/cizimler/taslak.png';

const kirintilar = [{ ad: 'Sözlük', url: '/sozluk/' }];
const BASLIK = 'Dijital pazarlama sözlüğü';
const ACIKLAMA =
  'Google Ads, Meta reklamları, ölçüm, SEO, GEO ve web sitesi terimlerinin kısa tanımları: ROAS, Kalite Puanı, dizine ekleme, AI Modu, llms.txt ve diğerleri.';

const CIZIMLER: Record<string, ImageMetadata> = { reklam: megafon, olcum: terazi, 'seo-terimleri': buyutec, 'geo-ve-aeo': robot, web: taslak };

const kategoriler = SOZLUK_KATEGORILERI.map((k) => ({ ...k, cizim: CIZIMLER[k.kimlik], terimler: kategoriTerimleri(k.ad) }));
const dizin = harfDizini();
const kaynakli = SOZLUK.filter((t) => t.kaynak).length;

const SAYFA = `${SITE.url}/sozluk/`;
const SET_KIMLIGI = `${SAYFA}#sozluk`;
const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': SET_KIMLIGI,
    name: 'Dijital Pazarlama Sözlüğü',
    description: ACIKLAMA,
    url: SAYFA,
    inLanguage: 'tr-TR',
    dateModified: SOZLUK_SON_KONTROL.toISOString().slice(0, 10),
    isPartOf: { '@id': `${SITE.url}/#site` },
    publisher: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad },
    hasDefinedTerm: SOZLUK.map((t) => ({
      '@type': 'DefinedTerm',
      '@id': `${SAYFA}#${t.kimlik}`,
      name: t.terim,
      ...(t.kisaltma && { alternateName: t.kisaltma }),
      description: t.tanim,
      url: `${SAYFA}#${t.kimlik}`,
      inDefinedTermSet: { '@id': SET_KIMLIGI },
    })),
  },
];
---

<Temel
  baslik="Dijital Pazarlama Sözlüğü ve Terimleri | Satışları Artır"
  aciklama={ACIKLAMA}
  sayfaTuru="rehberler"
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: 'Görüşme isteyin', url: '#gorusme' }}
>
  <!-- Üst alan -->
  <section class="su">
    <div class="sarici su__ic">
      <nav class="su__kirinti" aria-label="Sayfa konumu">
        <ol class="kirinti">
          <li><a href="/">Ana sayfa</a></li>
          <li><span aria-current="page">Sözlük</span></li>
        </ol>
      </nav>
      <div class="su__metin">
        <h1 class="baslik-1 su__baslik">{BASLIK}</h1>
        <div class="giris akis su__giris">
          <p>
            Google Ads, Meta reklamları, ölçüm, SEO, GEO ve web sitesiyle ilgili {SOZLUK.length} terimin kısa tanımları bu
            sayfada. Her tanım tek başına anlaşılacak biçimde yazıldı; platformlara ait terimlerin altında Google ya da
            Meta’nın resmî belgesine bağlantı var.
          </p>
        </div>
        <p class="su__kunye">
          <span><strong class="rakam">{SOZLUK.length}</strong> terim</span>
          <span><strong class="rakam">{kaynakli}</strong> resmî kaynak</span>
          <span>Son kontrol: <time datetime={SOZLUK_SON_KONTROL.toISOString().slice(0, 10)}>{tarihYaz(SOZLUK_SON_KONTROL)}</time></span>
        </p>
      </div>
      <div class="su__cizim">
        <Cizim
          src={defter}
          alt="Kâğıttan mavi bir masa lambasının ışığında açık duran çizgili defter; sayfaların arasında kırmızı bir kalem, bir satırın altı kırmızıyla çizilmiş"
          sizes="(max-width: 61.99rem) 52vw, 32vw"
          genislikler={[320, 480, 720, 960]}
          oncelik
        />
      </div>
    </div>
  </section>

  <!-- Konu kartları -->
  <nav class="sk" aria-label="Sözlüğün konuları">
    <div class="sarici">
      <ul class="sk__liste">
        {
          kategoriler.map((k) => (
            <li>
              <a class="sk__kart" href={`#${k.kimlik}`}>
                <span class="sk__cizim" aria-hidden="true">
                  <Cizim src={k.cizim} sizes="(max-width: 61.99rem) 4.5rem, 9rem" genislikler={[160, 240, 320]} />
                </span>
                <span class="sk__ad">{k.ad}</span>
                <span class="sk__sayi">{k.terimler.length} terim</span>
                <span class="sk__ozet">{k.ozet}</span>
                <span class="sk__ok" aria-hidden="true">
                  <Ikon ad="arrow-down" boyut={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="ok-bag sk__dizin" href="#dizin">
        A’dan Z’ye bütün terimler
        <Ikon ad="arrow-down" boyut={16} />
      </a>
    </div>
  </nav>

  <!-- Kategoriler -->
  {
    kategoriler.map((k, i) => (
      <section class:list={['bolum', 'sz', i % 2 === 0 && 'bolum--beyaz']} id={k.kimlik} aria-labelledby={`${k.kimlik}-baslik`}>
        <div class="sarici">
          <div class="sz__ust">
            <h2 class="baslik-2" id={`${k.kimlik}-baslik`}>
              {k.baslik}
            </h2>
            <p class="giris">{k.giris}</p>
          </div>
          <div class="tk-izgara">
            {k.terimler.map((t) => (
              <article class="tk" id={t.kimlik} aria-labelledby={`${t.kimlik}-ad`}>
                <div class="tk__ust">
                  <h3 class="tk__ad" id={`${t.kimlik}-ad`}>
                    <dfn>{t.terim}</dfn>
                    {t.kisaltma && <span class="tk__kisa">{t.kisaltma}</span>}
                  </h3>
                  <a class="tk__capa" href={`#${t.kimlik}`} aria-label={`${t.terim} tanımının bağlantısı`}>
                    <Ikon ad="link-simple" boyut={18} />
                  </a>
                </div>
                {t.acilim && <p class="tk__acilim">{t.acilim}</p>}
                <p class="tk__tanim">{t.tanim}</p>
                {t.ornek && (
                  <p class="tk__ornek">
                    <span class="tk__etiket">Örnek</span>
                    {t.ornek}
                  </p>
                )}
                <div class="tk__alt">
                  <p class="tk__ayrinti">
                    <span>Ayrıntısı:</span>{' '}
                    <a href={t.ilgili.url}>
                      {t.ilgili.etiket}
                      <Ikon ad="arrow-right" boyut={15} />
                    </a>
                  </p>
                  {t.kaynak && (
                    <p class="tk__kaynak">
                      <span>Kaynak:</span>{' '}
                      <a href={t.kaynak.url} rel="noopener">
                        {t.kaynak.ad}
                        <Ikon ad="arrow-up-right" boyut={14} />
                      </a>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- A’dan Z’ye dizin -->
  <section class="bolum dz" id="dizin" aria-labelledby="dizin-baslik">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2" id="dizin-baslik">A’dan Z’ye bütün terimler</h2>
        <p class="giris">Aradığınız terimin konusunu bilmiyorsanız buradan doğrudan tanımına gidin.</p>
      </div>
      <div class="dz__kagit">
        {
          dizin.map((g) => (
            <div class="dz__grup">
              <p class="dz__harf" aria-hidden="true">
                {g.harf}
              </p>
              <ul class="dz__terimler">
                {g.terimler.map((t) => (
                  <li>
                    <a href={`#${t.kimlik}`}>{t.terim}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="dz__not kucuk ikincil">
        Tanımlar genel bilgilendirme içindir. Platform arayüzleri ve adları değişebilir; ayrıntı için terimin altındaki resmî
        belgeye bakın.
      </p>
    </div>
  </section>

  <GorusmeBandi
    baslik="Raporunuzdaki rakamları birlikte okuyalım."
    metin="Reklam hesabınızda ya da sitenizde anlamını çözemediğiniz bir satır varsa yazın. Görüşmeye buradan başlayalım."
    kanal="belirsiz"
    cagri="Görüşme isteyin"
    konum="sozluk"
  />
</Temel>

<style>
  /* ---- Üst alan: metin solda, defter sağda ---------------------------------------- */
  .su {
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(1.75rem, 3.5vw, 3rem);
  }
  .su__ic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: clamp(1.25rem, 2.6vw, 2.25rem);
    align-items: center;
  }
  .su__kirinti {
    grid-column: 1 / -1;
  }
  .su__metin {
    grid-column: 1 / span 7;
    display: grid;
    justify-items: start;
  }
  .su__baslik {
    max-width: 11em;
  }
  .su__giris {
    margin-block-start: clamp(1.1rem, 2vw, 1.6rem);
  }
  /* Künye: terim sayısı, kaynak sayısı ve son kontrol tarihi. */
  .su__kunye {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: clamp(1.25rem, 2.2vw, 1.75rem);
  }
  .su__kunye > span {
    display: inline-block;
    padding: 0.42rem 0.8rem 0.46rem;
    border: 1.5px solid var(--cizgi-koyu);
    border-radius: 999px;
    background: var(--beyaz);
    font-family: var(--yazi-baslik);
    font-size: var(--b-kucuk);
    font-weight: 560;
    font-stretch: 96%;
    line-height: 1.15;
    color: var(--murekkep-2);
  }
  .su__kunye strong {
    font-weight: 720;
    color: var(--murekkep);
  }
  .su__cizim {
    grid-column: 8 / -1;
    margin: -1.5rem -0.5rem -2rem 0;
  }
  @media (max-width: 61.99rem) {
    .su__ic {
      row-gap: 0.75rem;
    }
    .su__metin {
      grid-column: 1 / -1;
    }
    .su__cizim {
      grid-column: 1 / -1;
      grid-row: 2;
      width: min(58%, 15rem);
      margin: -0.25rem 0 -0.75rem -0.75rem;
    }
  }

  /* ---- Konu kartları: geniş ekranda beş eş kart, dar ekranda satırlar ---------------- */
  .sk {
    padding-block: clamp(0.5rem, 1.5vw, 1rem) clamp(2.75rem, 5.5vw, 4.5rem);
  }
  .sk__liste {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.2vw, 1.1rem);
  }
  .sk__liste li {
    display: grid;
  }
  .sk__kart {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 0.3rem;
    padding: 0.9rem clamp(1rem, 1.6vw, 1.35rem) 1.2rem;
    border-radius: var(--kose);
    background: var(--beyaz);
    color: var(--murekkep);
    text-decoration: none;
    transition:
      transform 220ms var(--yumusak),
      box-shadow 220ms var(--yumusak);
  }
  .sk__cizim {
    display: block;
    width: min(100%, 9rem);
    margin: -0.25rem auto 0.35rem -0.4rem;
  }
  .sk__cizim :global(img) {
    width: 100%;
    height: auto;
  }
  .sk__ad {
    font-family: var(--yazi-baslik);
    font-size: clamp(1.3rem, 1.12rem + 0.6vw, 1.6rem);
    font-weight: 710;
    font-stretch: 86%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .sk__sayi {
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 640;
    color: var(--mavi);
    font-variant-numeric: lining-nums;
  }
  .sk__ozet {
    margin-block-start: 0.3rem;
    font-size: var(--b-kucuk);
    line-height: 1.42;
    color: var(--murekkep-2);
  }
  .sk__ok {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--kirmizi);
  }
  @media (hover: hover) {
    .sk__kart:hover {
      transform: translate(-2px, -2px);
      box-shadow: 0.4rem 0.4rem 0 rgb(23 61 166 / 0.2);
    }
    .sk__kart:hover .sk__ok :global(svg) {
      animation: sk-in 460ms var(--yumusak);
    }
  }
  @keyframes sk-in {
    44% {
      transform: translateY(0.6em);
      opacity: 0;
    }
    45% {
      transform: translateY(-0.6em);
      opacity: 0;
    }
  }
  .sk__dizin {
    margin-block-start: 1.1rem;
    min-height: 2.75rem;
    align-items: center;
  }
  /* Dar ekran: her konu bir satır; solda küçük çizim, ortada ad ve sayı, sağda ok. Özet gizlenir. */
  @media (max-width: 61.99rem) {
    .sk__liste {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    .sk__kart {
      grid-template-columns: 3.75rem minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      column-gap: 0.85rem;
      row-gap: 0.1rem;
      align-items: center;
      padding: 0.55rem 1rem 0.55rem 0.6rem;
    }
    .sk__cizim {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 3.75rem;
      margin: 0;
    }
    .sk__ad {
      grid-column: 2;
      align-self: end;
      font-size: 1.25rem;
    }
    .sk__sayi {
      grid-column: 2;
      align-self: start;
    }
    .sk__ozet {
      display: none;
    }
    .sk__ok {
      position: static;
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }
  /* Tablet: satırda yer var; özet adın yanında görünür. */
  @media (min-width: 48rem) and (max-width: 61.99rem) {
    .sk__kart {
      grid-template-columns: 3.75rem minmax(0, 11rem) minmax(0, 1fr) auto;
      column-gap: 1.25rem;
    }
    .sk__ozet {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      margin: 0;
    }
    .sk__ok {
      grid-column: 4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk__kart {
      transition: none;
    }
    .sk__kart:hover {
      transform: none;
    }
    .sk__kart:hover .sk__ok :global(svg) {
      animation: none;
    }
  }

  /* ---- Kategori bölümleri ------------------------------------------------------------ */
  .sz {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .sz__ust {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.9rem;
    align-items: end;
    margin-block-end: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .sz__ust .giris {
    max-width: 34em;
  }
  @media (max-width: 55.99rem) {
    .sz__ust {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Terim kartları: iki sütun, eş yükseklik; alt satır karta yaslanır ----------------- */
  .tk-izgara {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .tk {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.2rem, 2.2vw, 1.9rem);
    border-radius: var(--kose);
    background: var(--yuzey, var(--beyaz));
    scroll-margin-top: calc(var(--ust-bant) + 1.25rem);
    transition: box-shadow 260ms var(--yumusak);
  }
  .tk__ust {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .tk__ad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    font-size: clamp(1.4rem, 1.2rem + 0.75vw, 1.85rem);
    font-weight: 710;
    font-stretch: 86%;
    letter-spacing: -0.022em;
    line-height: 1.05;
  }
  .tk__ad dfn {
    font-style: normal;
  }
  .tk__kisa {
    padding: 0.3em 0.55em 0.32em;
    border-radius: 2px;
    background: var(--mavi-acik);
    font-size: var(--b-mikro);
    font-weight: 660;
    font-stretch: 100%;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--mavi-koyu);
  }
  .bolum--beyaz .tk__kisa {
    background: var(--beyaz);
  }
  /* Kendi bağlantısı: okur tanımı paylaşmak isterse adresi buradan alır. */
  .tk__capa {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -0.5rem -0.6rem 0 0;
    border-radius: var(--kose);
    color: var(--ikincil);
    transition:
      color var(--hizli),
      background-color var(--hizli);
  }
  .tk__capa:hover {
    color: var(--murekkep);
    background: var(--cizgi);
  }
  .tk__acilim {
    margin-block-start: -0.35rem;
    font-family: var(--yazi-baslik);
    font-size: var(--b-kucuk);
    font-weight: 600;
    font-stretch: 96%;
    line-height: 1.3;
    color: var(--mavi);
  }
  .tk__tanim {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--murekkep);
  }
  .tk__ornek {
    display: grid;
    gap: 0.25rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px dashed var(--cizgi-koyu);
    font-size: var(--b-kucuk);
    line-height: 1.5;
    color: var(--murekkep-2);
  }
  .tk__etiket {
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 660;
    letter-spacing: 0.01em;
    color: var(--murekkep);
  }
  .tk__alt {
    display: grid;
    gap: 0.35rem;
    margin-block-start: auto;
    padding-block-start: 0.85rem;
    border-block-start: 1px solid var(--cizgi);
    font-size: var(--b-kucuk);
    line-height: 1.4;
  }
  .tk__alt span {
    font-family: var(--yazi-baslik);
    font-weight: 620;
    color: var(--ikincil);
  }
  .tk__ayrinti a {
    font-family: var(--yazi-baslik);
    font-weight: 640;
    font-stretch: 96%;
    color: var(--murekkep);
    text-decoration-color: var(--cizgi-koyu);
    text-underline-offset: 0.22em;
  }
  .tk__ayrinti a:hover {
    text-decoration-color: var(--kirmizi);
  }
  .tk__kaynak a {
    color: var(--mavi);
  }
  .tk__alt a :global(svg) {
    display: inline-block;
    margin-inline-start: 0.2em;
    vertical-align: -0.12em;
  }
  .tk__ayrinti a :global(svg) {
    color: var(--kirmizi);
  }
  /* Çapayla gelinen terim: kırmızı çerçeve ve mürekkep gölge. */
  .tk:target {
    box-shadow:
      0 0 0 2px var(--kirmizi),
      0.45rem 0.45rem 0 var(--murekkep);
  }
  @media (max-width: 47.99rem) {
    .tk-izgara {
      grid-template-columns: minmax(0, 1fr);
    }
    .tk:target {
      box-shadow:
        0 0 0 2px var(--kirmizi),
        0.3rem 0.3rem 0 var(--murekkep);
    }
  }
