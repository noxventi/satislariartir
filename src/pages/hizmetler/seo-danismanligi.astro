const adimlar = [
  { ad: 'İnceleme', ozet: 'Site, rakip ve arama analizi', aciklama: 'Sitenizin Google’a açık olup olmadığına, rakiplerin hangi sayfalarla göründüğüne ve müşterinizin neyi aradığına bakıyoruz.' },
  { ad: 'Strateji', ozet: 'Arama ve sayfa planı', aciklama: 'Hangi aramanın hangi sayfaya ait olduğunu belirliyor, bulguları öncelik sırasına koyuyoruz.' },
  { ad: 'Kurulum', ozet: 'Teknik düzeltme, sayfa, içerik', aciklama: 'Teknik sorunları gideriyor, hizmet sayfalarını ve eksik içerikleri bu plana göre kuruyoruz.' },
  { ad: 'Optimizasyon', ozet: 'Düzenli takip ve iyileştirme', aciklama: 'Arama verisini düzenli okuyor; görünmeyen sayfayı ve tıklanmayan başlığı yeniden ele alıyoruz.' },
  { ad: 'Hedef', ozet: 'Organik talep ve müşteri', aciklama: 'Başarıyı ziyaretçi sayısıyla değil, aramadan gelip talep bırakan müşteriyle değerlendiriyoruz.' },
