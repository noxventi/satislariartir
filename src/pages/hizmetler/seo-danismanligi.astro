---
/**
 * SEO danışmanlığı hizmet sayfası.
 * Ana niyet: "seo danışmanlığı" (H1). "seo ajansı", "seo hizmeti", "seo nedir", "seo çalışması" ve "yerel seo"
 * başlık etiketinde, kapsam kartlarında ve sık sorulan sorularda karşılanır.
 * Arama verisi: arastirma/openseo-2026-11-14.md
 *
 * Düzen google-ads-yonetimi.astro kalıbını izler (15 Kasım 2026):
 * SayfaBasi > BuSayfada > kapsam kartları > soru kartları > çalışma adımları > iki durum (yeni site / sonuç alınamamış SEO) >
 * teknik kontrol örneği > arama niyeti, içerik kararı ve proje > sık sorulan sorular > ilgili sayfalar > görüşme.
 * Anlatım sırası: derinlemesine inceleme, bilinçli kurulum, düzenli optimizasyon, müşteri hedefi.
 * Çapalar: #teknik-bulgu (eski düzenden korunur), #ilk-seo, #seo-inceleme, #arama-niyeti, #icerik-karari.
 *
 * Platform bilgileri (Search Console rapor ve araç adları) 14 Kasım 2026'da Google yardım sayfalarından doğrulandı.
 */
import Temel from '../../layouts/Temel.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import BuSayfada from '../../components/BuSayfada.astro';
import SoruKartlari from '../../components/SoruKartlari.astro';
import Adimlar from '../../components/Adimlar.astro';
import IkiDurum from '../../components/IkiDurum.astro';
import Sss from '../../components/Sss.astro';
