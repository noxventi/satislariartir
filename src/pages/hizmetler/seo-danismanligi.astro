const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'SEO danışmanlığı',
    alternateName: 'SEO hizmeti',
    serviceType: 'SEO danışmanlığı, teknik SEO ve yerel SEO',
    provider: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad, url: `${SITE.url}/` },
    areaServed: { '@type': 'Country', name: 'Türkiye' },
    url: `${SITE.url}${hizmet.url}`,
    description:
      'Ayrıntılı site incelemesi, teknik SEO, anahtar kelime ve arama niyeti araştırması, hizmet sayfaları ve içerik, yerel SEO ve düzenli optimizasyonu kapsayan SEO danışmanlığı.',
  },
];
---

<Temel
  baslik="SEO Danışmanlığı ve SEO Ajansı Hizmeti | Satışları Artır"
  aciklama="SEO danışmanlığı: ayrıntılı site incelemesi, teknik SEO, hizmet sayfaları, içerik ve yerel SEO. Yeni siteler ve SEO yaptırıp sonuç alamayan işletmeler için."
  sayfaTuru="hizmet"
  hizmet="seo"
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: hizmet.cagri, url: '#gorusme' }}
>
  <SayfaBasi
    kirintilar={kirintilar}
    baslik="SEO danışmanlığı"
    gorsel={gorsel}
    gorselBicimi="dikey"
    mobilOdak="50% 62%"
    gorselAlt="Kâğıttan dev bir açık kitaba yürüyen, elinde soru işareti taşıyan küçük bir müşteri; kırmızı kalem çizgisi kitabın içindeki kapıdan ışıkları yanan dükkâna uzanıyor"
    cagri={{ etiket: hizmet.cagri, url: '#gorusme', kanal: 'seo' }}
    ikincil={{ etiket: 'Örnek teknik kontrolü görün', url: '#teknik-bulgu' }}
  >
    <p>
      SEO danışmanlığı, bir web sitesinin Google’da hizmetini arayan kişilere görünmesi için sitenin teknik yapısını,
      sayfalarını ve içeriğini inceleyip düzeltme işidir.
    </p>
    <p>
      Siteniz yeniyse temeli baştan kuruyor, daha önce SEO yaptırıp sonuç alamadıysanız işin nerede takıldığını bulup
      oradan devam ediyoruz. Sıralama sözü vermiyoruz; neyi neden düzelttiğimizi gösteriyoruz.
    </p>
  </SayfaBasi>

  <BuSayfada
    bolumler={[
      { etiket: 'Neleri kapsar?', hedef: 'kapsam' },
      { etiket: 'Sık yaşanan sorunlar', hedef: 'sorunlar' },
      { etiket: 'Nasıl çalışıyoruz?', hedef: 'yontem' },
      { etiket: 'Yeni site ya da mevcut SEO', hedef: 'ilk-seo' },
      { etiket: 'Teknik kontrol örneği', hedef: 'teknik-bulgu' },
      { etiket: 'Sık sorulanlar', hedef: 'sss' },
    ]}
  />

  <!-- Kapsam -->
  <section class="bolum bolum--beyaz" id="kapsam">
    <div class="sarici konu konu--ust">
      <div class="konu__baslik konu__baslik--cizimli">
        <div>
          <h2 class="baslik-2">SEO danışmanlığı neleri kapsar?</h2>
          <div class="metin">
            <p>
              İster SEO ajansı ister SEO danışmanı deyin, iyi bir SEO hizmeti tek bir işten oluşmaz. Sitenin Google’a
              açık olması, doğru aramada doğru sayfanın çıkması ve gelen kişinin aradığını bulması ayrı işlerdir.
            </p>
          </div>
        </div>
        <Cizim src={harita} class="konu__cizim" sizes="(max-width: 55.99rem) 40vw, 16vw" />
      </div>
      <div class="konu__icerik">
        <ul class="tikli tikli--ikili">
          {
            kapsam.map((k) => (
              <li>
                <strong>{k.ad}</strong>
                <span>{k.aciklama}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Sık yaşanan sorunlar -->
  <section class="bolum" id="sorunlar">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">SEO’da en sık duyduğumuz sorular</h2>
        <p class="giris">Sitesi olan işletmeler çoğunlukla bu dört sorudan birini soruyor. Her birinde ilk baktığımız yer:</p>
      </div>
      <SoruKartlari kartlar={sorunlar} />
    </div>
  </section>

  <!-- Yöntem -->
  <section class="bolum bolum--beyaz" id="yontem">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">SEO çalışmasını nasıl yürütüyoruz?</h2>
        <p class="giris">
          İçerik yazıp beklemiyoruz. Önce sitenizi inceliyor, sonra bulguya göre kuruyor, ardından düzenli takip ve
          optimizasyonla hedefinize yaklaştırıyoruz.
        </p>
      </div>
      <Adimlar adimlar={adimlar} />
    </div>
  </section>

  <!-- İki durum: yeni site / sonuç alınamamış SEO -->
  <IkiDurum
    kimlik="ilk-seo"
    baslik="Siteniz yeni mi, SEO yaptırıp sonuç alamadınız mı?"
    giris="İki durumda başlangıç noktası farklıdır. Hangisindeyseniz oradan başlıyoruz."
    sol={{
      ust: 'Siteniz yeniyse ya da hiç SEO yaptırmadıysanız',
      baslik: 'Temeli baştan, doğru sırayla kuruyoruz',
