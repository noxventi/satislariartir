const icerikKarari = [
  {
    ad: 'Soruyu kimin sorduğuna bakıyoruz',
    aciklama: 'Satış görüşmelerinizde tekrar eden soruları ve Search Console’da gösterim alan aramaları aynı listede topluyoruz.',
  },
  {
    ad: 'Sitede cevabı var mı diye bakıyoruz',
    aciklama: 'Cevap bir sayfanın ortasında gömülüyse yeni yazı açmıyor, o sayfayı düzeltiyoruz. Hiç yoksa yeni sayfa sıraya giriyor.',
  },
  {
    ad: 'Cevabı bir hizmete bağlıyoruz',
    aciklama: 'Her rehber ilgili hizmete, hizmet sayfası da aynı soruya bağlanıyor. Hiçbir hizmete bağlanmayan konu beklemeye alınıyor.',
  },
];

const sorular = [
  {
    soru: 'SEO nedir?',
    cevap:
      'SEO (arama motoru optimizasyonu), bir web sitesinin Google gibi arama motorlarında reklam vermeden, organik sonuçlarda görünmesi için yapılan çalışmaların bütünüdür. Sitenin teknik yapısını, sayfalarını, içeriğini ve başka sitelerden aldığı bağlantıları kapsar. Reklamdan farkı, tıklama başına ödeme yapılmamasıdır.',
  },
  {
    soru: 'SEO danışmanlığı ile SEO ajansı arasındaki fark ne?',
    cevap:
      'SEO danışmanlığında işi biz yönlendirir ve denetleriz, uygulamayı sizin ekibiniz ya da geliştiriciniz yapabilir; SEO ajansı hizmetinde ise incelemeyi, düzeltmeyi ve içerik planını baştan sona ajans üstlenir. İki biçimde de çalışıyoruz. Hangisinin size uyduğu, sitenize kimin erişebildiğine ve ekibinizin işin ne kadarını üstlenebileceğine göre ilk görüşmede netleşir.',
  },
  {
    soru: 'SEO ne zaman sonuç verir?',
    cevap:
      'Kesin bir süre söylemek doğru olmaz, çünkü dört ayrı şey farklı hızda değişir. Tarama ve dizine eklenme düzeltmeleri önce görünür. Hangi aramalarda gösterildiğiniz ondan sonra değişir. Talep en son gelir ve yalnız aramaya değil, sayfanın kendisine de bağlıdır. Sıra ya da tarih için söz vermiyoruz.',
  },
  {
    soru: 'SEO mu, Google Ads mi?',
    cevap:
      'İkisi farklı iş görür: Google Ads’te bütçe ayırdığınız sürece reklamla görünürsünüz, SEO’da ise sitenizin reklam vermeden, organik sonuçlarda görünmesi için çalışılır. Hemen talebe ihtiyacı olan işletmeler çoğunlukla reklamla başlar ve SEO çalışmasını yanında yürütür. Reklamda talep getiren aramalar, SEO’da hangi sayfaların önce kurulacağını da gösterir.',
    bag: { etiket: 'Google Ads yönetimi', url: '/hizmetler/google-ads-yonetimi/' },
  },
  {
    soru: 'Yerel SEO nedir?',
    cevap:
      'Yerel SEO, bir işletmenin bulunduğu ya da hizmet verdiği bölgede yapılan aramalarda ve Google Haritalar’da görünmesi için yapılan çalışmadır. Google İşletme Profili’nin doğru doldurulmasını, adres ve telefon bilgisinin her yerde aynı olmasını, yorumları ve bölgeye özel sayfaları kapsar. Çilingir, kombi servisi ya da restoran gibi müşterisi yakınından gelen işletmelerde ilk ele alınan iştir.',
  },
  {
    soru: 'İçeriği kim yazar?',
    cevap:
      'Metni kimin yazacağı çalışmanın kapsamında, işe başlamadan netleşir. Hangi sayfanın yazılacağına birlikte karar veririz. Kim yazarsa yazsın, işinizi bilen biri okuyup onaylamadan içerik yayımlanmaz.',
  },
  {
    soru: 'Teknik düzeltmeleri kim yapar?',
