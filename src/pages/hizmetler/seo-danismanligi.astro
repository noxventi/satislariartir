    ornek:
      'Bir güzellik salonu düzenli blog yazısı yayımlıyor ama yazılar aramadan ziyaretçi almıyor. Konular müşterinin sorduğu sorulardan seçilmemiştir ya da aynı konuyu anlatan birkaç yazı birbirinin önünü kesiyordur.',
    care: 'Yazıları tek tek inceliyor; hangisinin birleşeceğine, düzeleceğine ya da bir hizmete bağlanacağına karar veriyoruz.',
    bag: { etiket: 'İlk içerik kararını nasıl veriyoruz?', url: '#icerik-karari' },
    cizim: defter,
    genis: true,
  },
