    sorgu: 'havuz yenileme firması',
    bekledigi: 'Sizi başka firmalarla karşılaştırıyor. Yaptığınız işi, çalıştığınız bölgeyi, iş örneklerini ve teklif yolunu görmek istiyor.',
    sayfa: 'Hizmet sayfası',
    ek: 'İş örnekleri ve teklif yoluyla birlikte.',
    cizim: liste,
  },
  {
    kim: 'Sorununu yazan müşteri',
    sorgu: 'havuz seramiği neden dökülür',
