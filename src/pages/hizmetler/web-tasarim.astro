<style>
  /* ---- Beş özellik: tek sırada beş kart; satırlar (görsel, ad, kısa söz, açıklama) subgrid ile hizalı. */
  .oz {
    --kart-arasi: clamp(0.75rem, 1.4vw, 1.25rem);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: var(--kart-arasi);
    row-gap: 0.6rem;
  }
  .oz__kart {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    align-items: start;
    margin-block-end: calc(var(--kart-arasi) - 0.6rem);
    padding: clamp(1rem, 1.6vw, 1.5rem);
    background: var(--yuzey);
    border-radius: var(--kose);
  }
  .oz__kart:nth-child(even) {
    background: var(--mavi-acik);
  }
  .oz__cizim {
    justify-self: end;
    width: min(72%, 8.75rem);
    margin: -0.6rem -0.6rem 0 0;
  }
  .oz__ad {
    font-size: clamp(1.25rem, 1.08rem + 0.6vw, 1.6rem);
    font-weight: 710;
    font-stretch: 85%;
    letter-spacing: -0.022em;
    line-height: 1.06;
    text-wrap: balance;
  }
