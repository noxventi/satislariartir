---
/**
 * Hizmetler dizini. Ana niyet: "dijital pazarlama hizmetleri", "dijital pazarlama ajansı", "dijital pazarlama nedir".
 * Sahiplendiği soru: "Hangi hizmete ihtiyacım var?"
 *
 * Düzen (15 Kasım 2026): SayfaBasi (tanım + kâğıt kasaba) > BuSayfada > beş hizmetin görselli kartları >
 * müşterinin kendi cümlesinden hizmete götüren soru kartları > hizmetlerin birbirini tamamlaması >
 * iki durum (ilk kez / sonuç alamayanlar) > çalışma adımları > sık sorulan sorular > ilgili sayfalar > görüşme.
 * Anlatım sırası: derinlemesine inceleme, bilinçli kurulum, düzenli optimizasyon, satış hedefi.
 * Fiyat, paket ya da bütçe karşılaştırması yoktur. Örnek işletmeler temsilidir, müşteri değildir.
 * Kart metinleri bu sayfada yazılıdır; adresler site.config.ts içindeki HIZMETLER kaydından gelir.
 */
import Temel from '../../layouts/Temel.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import BuSayfada from '../../components/BuSayfada.astro';
import SoruKartlari from '../../components/SoruKartlari.astro';
import Adimlar from '../../components/Adimlar.astro';
import IkiDurum from '../../components/IkiDurum.astro';
import Sss from '../../components/Sss.astro';
import IlgiliSayfalar from '../../components/IlgiliSayfalar.astro';
import GorusmeBandi from '../../components/GorusmeBandi.astro';
import Gorsel from '../../components/Gorsel.astro';
import Cizim from '../../components/Cizim.astro';
import Ikon from '../../components/Ikon.astro';
import { HIZMETLER, SITE } from '../../site.config';

import kapak from '../../assets/gorseller/kapak-masaustu.jpg';
import yolArama from '../../assets/gorseller/yol-arama.jpg';
import yolAkis from '../../assets/gorseller/yol-akis.jpg';
import yolCevap from '../../assets/gorseller/yol-cevap.jpg';
import yolYapayZeka from '../../assets/gorseller/yol-yapay-zeka.jpg';
import yolSite from '../../assets/gorseller/yol-site.jpg';
import celikvillamEkran from '../../assets/projeler/celikvillam-masaustu.jpg';

import hedef from '../../assets/cizimler/hedef.png';
import kreatif from '../../assets/cizimler/kreatif.png';
import harita from '../../assets/cizimler/harita.png';
import robot from '../../assets/cizimler/robot.png';
import taslak from '../../assets/cizimler/taslak.png';
import yolAyrimi from '../../assets/cizimler/yol-ayrimi.png';
import yapboz from '../../assets/cizimler/yapboz.png';
import megafon from '../../assets/cizimler/megafon.png';
import takvim from '../../assets/cizimler/takvim.png';
import terazi from '../../assets/cizimler/terazi.png';
import kitaplik from '../../assets/cizimler/kitaplik.png';
import defter from '../../assets/cizimler/defter.png';

const CAGRI = 'Görüşme isteyin';
const kirintilar = [{ ad: 'Hizmetler', url: '/hizmetler/' }];
const [googleAds, meta, seo, geo, web] = HIZMETLER;

/** Beş hizmet: başlık hizmetin aranan adı, altında tek cümlelik tanım ve kimin için olduğu. */
const hizmetler = [
  {
    hizmet: googleAds,
    ad: 'Google Ads yönetimi',
    tanim: 'Google Ads yönetimi, hizmetinizi Google’da arayan kişiye reklamınızı gösterme ve bütçeyi satış getiren aramalara yönlendirme işidir.',
    kim: 'Müşterisi hizmeti adıyla arayan işletmeler: çilingir, kombi servisi, nakliye firması, oto servis.',
    bag: 'Google Ads yönetimini inceleyin',
    gorsel: yolArama,
    alt: 'Kâğıttan dev bir arama kutusuna uzanan küçük bir müşteri; kutudan çıkan kırmızı kalem çizgisi ışıkları yanan dükkâna gidiyor',
    sizes: '(max-width: 43.99rem) 100vw, (max-width: 61.99rem) 92vw, 56vw',
  },
  {
    hizmet: meta,
    ad: 'Instagram ve Facebook reklam yönetimi',
    tanim: 'Meta reklam yönetimi, işinizi henüz aramayan ama ilgilenebilecek kişilere Instagram ve Facebook’ta gösterme, gelen mesaj ve formları satışa yaklaştırma işidir.',
    kim: 'İşini göstererek satan işletmeler: güzellik salonu, mobilyacı, restoran, pilates stüdyosu.',
    bag: 'Meta reklam yönetimini inceleyin',
    gorsel: yolAkis,
    alt: 'Kâğıttan dev bir telefonun ekranındaki fotoğraf kareleri; dükkânın olduğu kare kırmızı kalemle çembere alınmış, önünde bakan küçük insanlar',
    sizes: '(max-width: 43.99rem) 100vw, (max-width: 61.99rem) 46vw, 40vw',
  },
  {
    hizmet: seo,
    ad: 'SEO danışmanlığı',
    tanim: 'SEO danışmanlığı, web sitenizin Google’ın reklam dışı sonuçlarında, müşterinizin yazdığı aramalarda görünmesi için yapılan teknik ve içerik çalışmasıdır.',
    kim: 'Sitesi olup aramalarda çıkmayan ya da müşterisinin tamamı reklamdan gelen işletmeler.',
    bag: 'SEO danışmanlığını inceleyin',
    gorsel: yolCevap,
    alt: 'Elinde soru işaretiyle reklam panolarının yanından geçip açık duran dev bir kitaba yürüyen küçük bir müşteri; kitapta bir satır kırmızı kalemle çizilmiş',
    sizes: '(max-width: 43.99rem) 100vw, (max-width: 61.99rem) 46vw, 32vw',
  },
  {
    hizmet: geo,
    ad: 'GEO ve AEO danışmanlığı',
    tanim: 'GEO ve AEO danışmanlığı, ChatGPT, Gemini ve Google’ın yapay zekâ özetleri gibi araçların yanıtlarında markanızın doğru bilgiyle anılması için yapılan çalışmadır.',
    kim: 'Müşterisi karar vermeden önce araştıran işletmeler: mimarlık ofisi, eğitim danışmanlığı, üretici firma.',
    bag: 'GEO ve AEO danışmanlığını inceleyin',
    gorsel: yolYapayZeka,
    alt: 'Kâğıttan bir yardımcı robot ve konuşma balonu; balondaki üç dükkândan ortadaki kırmızı kalemle çembere alınmış, karşısında dinleyen bir müşteri',
    sizes: '(max-width: 43.99rem) 100vw, (max-width: 61.99rem) 46vw, 32vw',
  },
  {
    hizmet: web,
    ad: 'Kurumsal web tasarım',
    tanim: 'Kurumsal web tasarım, ziyaretçinin aradığı hizmeti ilk ekranda görüp tek adımda talep bırakabileceği bir web sitesi kurma işidir.',
    kim: 'Sitesi olmayan, sitesi telefonda zor kullanılan ya da reklamı için açılış sayfası gereken işletmeler.',
    bag: 'Web tasarım sürecini inceleyin',
    gorsel: yolSite,
    alt: 'Ekranı dükkân vitrini olan kâğıttan bir dizüstü bilgisayar; üç ayrı yönden gelen kırmızı çizgiler kapıda birleşiyor, küçük müşteriler içeri giriyor',
    sizes: '(max-width: 43.99rem) 100vw, (max-width: 61.99rem) 46vw, 32vw',
  },
];

/** Müşterinin kendi cümlesi başlıktır; kart o cümleden hizmete götürür. İşletmeler temsilidir. */
const secim = [
  {
    soru: 'Müşterim ihtiyaç duyunca Google’a yazıyor. Orada nasıl çıkarım?',
    ornek: 'Kombisi arızalanan kişi “kombi servisi” yazar ve ilk gördüğü birkaç firmadan birini arar. O anda görünmeyen işletme, o müşteri için yoktur.',
    care: 'Hizmetinizi arayan kişiye reklamınızı gösteren Google Ads kampanyalarını kuruyor, arama terimlerini düzenli okuyarak geliştiriyoruz.',
    bag: { etiket: 'Google Ads yönetimi', url: googleAds.url },
    cizim: hedef,
  },
  {
    soru: 'İşimi görünce istiyorlar ama kimse aramıyor. Ne yapmalıyım?',
    ornek: 'El yapımı bir sehpa ya da yeni açılan bir pilates stüdyosu Google’da pek aranmaz. İnsanlar görünce ilgilenir, sonra yazar.',
    care: 'Instagram ve Facebook’ta işinizi doğru kişilere gösteren reklamları kuruyor, görsel ve metinleri tek tek deniyoruz.',
    bag: { etiket: 'Instagram reklam yönetimi', url: meta.url },
    cizim: kreatif,
  },
  {
    soru: 'Reklamı kesince telefon da susuyor. Reklamsız müşteri gelir mi?',
    ornek: 'Bütün müşterisi reklamdan gelen bir oto servis, bütçeyi kıstığı hafta boş kalır. Google’ın reklam dışı sonuçlarında görünmüyordur.',
    care: 'Sitenizin teknik eksiklerini gideriyor, hizmet sayfalarınızı müşterinizin yazdığı aramalara göre yeniden düzenliyoruz.',
    bag: { etiket: 'SEO danışmanlığı', url: seo.url },
    cizim: harita,
  },
  {
    soru: 'Müşterilerim artık ChatGPT’ye soruyor. Beni öneriyor mu?',
    ornek: '“İzmir’de hangi mimarlık ofisiyle çalışmalıyım?” sorusuna verilen yanıtta birkaç isim geçer. Kendi adının geçip geçmediğini çoğu işletme bilmez.',
    care: 'Müşterilerinizin sorduğu soruları belirliyor, yanıtlardaki durumunuzu ölçüyor ve kaynak gösterilen sayfaları düzeltiyoruz.',
    bag: { etiket: 'GEO ve AEO danışmanlığı', url: geo.url },
    cizim: robot,
  },
  {
    soru: 'Web sitem yok ya da çok eski. Önce site mi yaptırmalıyım?',
    ornek: 'Her zaman değil. Instagram’da mesaj hedefiyle site olmadan reklam verilebilir. Google reklamında ise tıklayan kişinin ineceği bir sayfa gerekir.',
    care: 'İhtiyaca göre tek sayfalık bir açılış sayfası ya da hizmetlerinizi ayrı ayrı anlatan kurumsal bir site kuruyoruz.',
    bag: { etiket: 'Kurumsal web tasarım', url: web.url },
    cizim: taslak,
  },
  {
    soru: 'Hangisine ihtiyacım olduğunu bilmiyorum. Nereden başlamalıyım?',
    ornek: 'Çoğu işletme bu noktadan başlar. Doğru ilk adım, müşterinizin sizi arayarak mı yoksa görerek mi bulduğuna bağlıdır.',
    care: 'Görüşmede işletmenizi dinliyor, hangi hizmetin işinize yarayacağını ve hangisinin şimdilik gerekmediğini söylüyoruz.',
    bag: { etiket: 'Google Ads mi, Instagram mı?', url: '/blog/google-ads-mi-instagram-reklami-mi/' },
    cizim: yolAyrimi,
  },
];

/** Hizmetlerin birbirine nasıl bağlandığı: tek ekibin gerekçesi. */
const baglar = [
  {
    ad: 'Reklam ve açılış sayfası',
    aciklama: 'Reklama tıklayan kişi, aradığı hizmeti ilk ekranda gösteren bir sayfaya inmelidir. Reklamı ve sayfayı aynı ekip kurduğunda ikisi aynı sözü verir.',
  },
  {
    ad: 'Google Ads ve SEO',
    aciklama: 'Reklamda teklif getirdiği görülen aramalar, SEO’da önce hangi sayfaların ele alınacağını gösterir. Tahminle değil, görülmüş aramayla ilerleriz.',
  },
  {
    ad: 'SEO ve yapay zekâ görünürlüğü',
    aciklama: 'İkisi de aynı malzemeyle çalışır: müşterinin sorusuna açık cevap veren, düzenli sayfalar. Aynı içerik iki iş için birlikte hazırlanır.',
  },
  {
    ad: 'Instagram reklamı ve mesaj düzeni',
    aciklama: 'Reklam mesajı getirir; satış, ilk yanıtla randevu arasında olur. Reklamı kuran ekip mesajdan satışa giden adımları da sizinle birlikte düzenler.',
  },
];

const adimlar = [
  { ad: 'İnceleme', ozet: 'İşletme, rakip ve arama analizi', aciklama: 'İşletmenizi, rakiplerinizi ve müşterinizin aramalarını inceliyor; varsa mevcut hesabınıza ve sitenize bakıyoruz.' },
  { ad: 'Strateji', ozet: 'Kanal, mesaj ve hedef kararı', aciklama: 'Hangi hizmetle başlanacağını ve neyin şimdilik gerekmediğini gerekçesiyle birlikte kararlaştırıyoruz.' },
  { ad: 'Kurulum', ozet: 'Bulguya dayanan kurulum', aciklama: 'Kampanyaları, sayfaları ve içerikleri incelemede çıkan bulgulara göre kuruyor, yayından önce deniyoruz.' },
  { ad: 'Optimizasyon', ozet: 'Düzenli takip ve iyileştirme', aciklama: 'Sonuç getirmeyen aramayı, reklamı ya da sayfayı kapatıyor; getireni güçlendiriyoruz.' },
  { ad: 'Hedef', ozet: 'Satış ve müşteri hedefiniz', aciklama: 'Başarıyı tıklamayla değil, işletmenize gelen talep ve satışla değerlendiriyoruz.' },
];

/** Sorular Türkiye'de aranan ifadelerden seçildi ("dijital pazarlama nedir" 1.900, "dijital pazarlama ajansı" 2.400). */
const sorular = [
  {
    soru: 'Dijital pazarlama nedir?',
    cevap:
      'Dijital pazarlama, bir işletmenin ürün ya da hizmetini internet üzerinden doğru kişilere ulaştırmak ve satışa dönüştürmek için yaptığı çalışmaların tümüdür. Arama motoru reklamları, sosyal medya reklamları, arama motoru optimizasyonu (SEO), yapay zekâ yanıtlarında görünürlük (GEO) ve web sitesi bu çalışmaların başlıca parçalarıdır.',
  },
  {
    soru: 'Dijital pazarlama ajansı ne iş yapar?',
    cevap:
      'Dijital pazarlama ajansı, işletmenizin internette müşteri bulması için gereken işleri planlar, kurar ve düzenli olarak geliştirir. Reklam hesaplarını yönetir, web sitenizi ve içeriğinizi aramalara göre düzenler, hangi işin sonuç getirdiğine bakarak bir sonraki adımı belirler. Satışları Artır bu işleri tek bir satış hedefine göre yürütür.',
  },
  {
    soru: 'Reklam ajansı, SEO ajansı ve web tasarım ajansı ayrı ayrı mı tutulmalı?',
    cevap:
      'Şart değil; üç iş birbirine bağlı olduğu için tek ekip çoğu zaman daha verimli çalışır. Reklamın açtığı sayfayı web tasarım, o sayfanın aramalarda görünmesini SEO belirler. İşler ayrı ajanslara dağıldığında sorunun hangi adımda olduğu ortada kalabilir. Bu işleri tek ekip olarak, aynı hedefle yürütüyoruz.',
  },
  {
    soru: 'Hangi hizmetten başlamalıyım?',
    cevap:
      'Müşterinizin sizi nasıl bulduğuna göre değişir. Hizmetinizi adıyla arıyorsa Google Ads, işinizi görünce ilgileniyorsa Instagram ve Facebook reklamları çoğu zaman doğru ilk adımdır. Tıklayan kişinin ineceği sayfa yoksa ya da yetersizse önce onu konuşuruz. İlk görüşmede işletmenizi dinleyip başlangıç noktasını birlikte seçiyoruz.',
    bag: { etiket: 'Google Ads mi, Instagram reklamı mı?', url: '/blog/google-ads-mi-instagram-reklami-mi/' },
  },
  {
    soru: 'Tek bir hizmet alabilir miyim?',
    cevap:
      'Evet, her hizmet tek başına alınabilir. Yalnız Google Ads yönetimi, yalnız SEO danışmanlığı ya da yalnız web tasarım için çalışabiliriz. İncelemede başka bir eksik görürsek söyleriz; karar sizindir.',
  },
  {
    soru: 'İlk kez reklam vereceğim. Reklam hesabımın olması gerekiyor mu?',
    cevap:
      'Hayır, hesabınızın olması gerekmez. Reklam hesabını işletmenizin adına birlikte açıyoruz; ödeme yöntemi, fatura bilgisi ve hesabın sahipliği sizde kalır. Bize yalnız yönetici erişimi verirsiniz.',
  },
  {
    soru: 'Daha önce ajansla çalıştım, sonuç alamadım. Neyi farklı yapıyorsunuz?',
    cevap:
      'Yeni bir şey kurmadan önce eskisini inceliyoruz. Hesabınızda bütçenin nereye gittiğine, tıklayan kişinin indiği sayfaya ve gelen başvurulara ne olduğuna bakıyor, neyin işlemediğini gösteriyoruz. Kurulumu bu bulgulara göre yapıyor, verdiğimiz her kararı gerekçesiyle anlatıyoruz.',
  },
  {
    soru: 'Sonuç garantisi veriyor musunuz?',
    cevap:
      'Hayır. Sıra, tıklama ya da satış sayısı için söz vermiyoruz; böyle bir sözü dürüstçe veremeyiz. Söz verdiğimiz şey işletmenizi ayrıntılı incelemek, kararlarımızı gerekçesiyle anlatmak ve düzenli optimizasyon yapmaktır.',
    bag: { etiket: 'Neye söz veriyoruz, neye vermiyoruz?', url: '/hakkimizda/#soz' },
  },
];

const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Satışları Artır dijital pazarlama hizmetleri',
    itemListElement: hizmetler.map((h, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: h.ad,
      description: h.tanim,
      url: `${SITE.url}${h.hizmet.url}`,
    })),
  },
];
---

<Temel
  baslik="Dijital Pazarlama Hizmetleri: Reklam, SEO, Web | Satışları Artır"
  aciklama="Dijital pazarlama hizmetleri: Google Ads, Instagram ve Facebook reklamları, SEO, GEO ve web tasarım. Hangi hizmetin size uygun olduğunu ve nasıl çalıştığımızı görün."
  sayfaTuru="hizmetler"
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: CAGRI, url: '#gorusme' }}
>
  <SayfaBasi
    kirintilar={kirintilar}
    baslik="Dijital pazarlama hizmetleri"
    gorsel={kapak}
    gorselAlt="Kâğıttan yapılmış mavi beyaz bir kasaba. Küçük kâğıt insanlar, masaya çizilmiş kırmızı kalem çizgisini izleyerek ışıkları yanan bir dükkâna yürüyor."
    mobilOdak="88% 50%"
    cagri={{ etiket: CAGRI, url: '#gorusme' }}
    ikincil={{ etiket: 'Hangi hizmet bana uygun?', url: '#hangi-hizmet' }}
  >
    <p>
      Dijital pazarlama hizmetleri, bir işletmenin internette müşteri bulması için yapılan işlerdir: Google ve Instagram
      reklamları, arama motoru optimizasyonu (SEO), yapay zekâ yanıtlarında görünürlük (GEO) ve web tasarım.
    </p>
    <p>
      Bu beş işi tek ekip olarak yürütüyoruz. Önce işletmenizi ayrıntılı inceliyor, kurulumu bulgulara göre yapıyor,
      ardından düzenli optimizasyonla geliştiriyoruz.
    </p>
  </SayfaBasi>

  <BuSayfada
    bolumler={[
      { etiket: 'Beş hizmet', hedef: 'hizmetler' },
      { etiket: 'Hangisi size uygun?', hedef: 'hangi-hizmet' },
      { etiket: 'Birlikte nasıl çalışır?', hedef: 'birlikte' },
      { etiket: 'İlk kez ya da yeniden', hedef: 'durum' },
      { etiket: 'Nasıl çalışıyoruz?', hedef: 'yontem' },
      { etiket: 'Sık sorulanlar', hedef: 'sss' },
    ]}
  />

  <!-- Beş hizmet -->
  <section class="bolum bolum--beyaz" id="hizmetler">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">Hangi dijital pazarlama hizmetlerini veriyoruz?</h2>
        <p class="giris">
          Müşteriniz sizi Google’da arayarak, Instagram’da görerek, bir sorunun cevabını ararken ya da yapay zekâya
          danışarak bulur; sonunda web sitenize gelir. Her yol için ayrı bir hizmet var.
        </p>
      </div>
      <ul class="hz">
        {
          hizmetler.map((h, i) => (
            <li class:list={['hz__oge', `hz__oge--${i + 1}`]} data-gir style={`--gecikme:${[0, 120, 0, 120, 240][i]}ms`}>
              <article class="hz__kart">
                <div class="hz__gorsel">
                  <Gorsel src={h.gorsel} alt={h.alt} sizes={h.sizes} genislikler={[480, 720, 960, 1280, 1700]} kalite={66} />
                </div>
                <div class="hz__metin">
                  <h3 class="hz__ad">
                    <span>{h.ad}</span>
                  </h3>
                  <p class="hz__tanim">{h.tanim}</p>
                  <p class="hz__kim">
                    <strong>Kimler için?</strong> {h.kim}
                  </p>
                  <a class="ok-bag hz__bag" href={h.hizmet.url}>
                    {h.bag}
                    <Ikon ad="arrow-right" boyut={16} />
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Müşterinin cümlesinden hizmete -->
  <section class="bolum" id="hangi-hizmet">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">Hangi hizmet size uygun?</h2>
        <p class="giris">
          Hizmet adlarını bilmeniz gerekmez. İşletmelerden en sık duyduğumuz altı cümle ve her birinin götürdüğü hizmet:
        </p>
      </div>
      <SoruKartlari kartlar={secim} />
    </div>
  </section>

  <!-- Hizmetler birbirini nasıl tamamlar -->
  <section class="bolum bolum--beyaz" id="birlikte">
    <div class="sarici konu konu--ust">
      <div class="konu__baslik konu__baslik--cizimli">
        <div>
