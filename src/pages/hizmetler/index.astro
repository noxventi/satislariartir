<style>
  /* Üst alan: kasaba görselin sağında durur; geniş ekranda kadraj dükkâna kaydırılır. */
  @media (min-width: 56rem) {
    :global(body[data-sayfa-turu='hizmetler'] .sb__gorsel img) {
      object-position: 88% 50%;
    }
  }

  /* ---- Beş hizmet --------------------------------------------------------------
     Ana sayfadaki galerinin kartlı hâli: üstte kâğıt işi sahne, altında hizmetin aranan adı, tanımı ve
     kimin için olduğu. Geniş ekranda 7 + 5, altında üçlü sıra. Kartın tamamı tıklanır. */
  .hz {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.4rem);
  }
  .hz__oge {
    display: grid;
    grid-column: span 4;
  }
  .hz__oge--1 {
    grid-column: span 7;
  }
  .hz__oge--2 {
    grid-column: span 5;
  }
  .hz__kart {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    isolation: isolate;
    background: var(--yuzey);
    border-radius: var(--kose);
    transition:
      transform 220ms var(--yumusak),
      box-shadow 220ms var(--yumusak);
  }
  .hz__oge--2 .hz__kart,
  .hz__oge--3 .hz__kart,
  .hz__oge--5 .hz__kart {
    background: var(--mavi-acik);
  }
  .hz__gorsel {
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  /* İlk sıradaki iki görsel aynı yükseklikte durur. */
  .hz__oge--1 .hz__gorsel,
  .hz__oge--2 .hz__gorsel {
    aspect-ratio: auto;
    height: clamp(18rem, 38vw, 34rem);
  }
  .hz__gorsel :global(picture) {
    display: block;
    height: 100%;
  }
  .hz__gorsel :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--yumusak);
  }
  .hz__oge--2 .hz__gorsel :global(img) {
    object-position: 50% 58%;
  }
  .hz__metin {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem;
    justify-items: start;
    padding: clamp(1.2rem, 2.2vw, 2rem);
  }
  .hz__ad {
    font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2.05rem);
    font-weight: 700;
    font-stretch: 87%;
    line-height: 1.06;
    letter-spacing: -0.022em;
  }
  .hz__oge--1 .hz__ad {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
  }
  /* Üzerine gelince hizmetin adı kırmızı kalemle çizilir. */
  .hz__ad span {
    background: linear-gradient(var(--kirmizi), var(--kirmizi)) no-repeat 0 96% / 0 0.08em;
    transition: background-size 520ms cubic-bezier(0.6, 0.05, 0.25, 1);
  }
  .hz__kart:hover .hz__ad span,
  .hz__kart:focus-within .hz__ad span {
    background-size: 100% 0.08em;
  }
  .hz__tanim {
    max-width: 36em;
    color: var(--murekkep-2);
  }
  /* Öne çıkan ilk kartta tanım bir kademe büyük okunur. */
  @media (min-width: 62rem) {
    .hz__oge--1 .hz__tanim {
      font-size: var(--b-giris);
      line-height: 1.42;
      max-width: 30em;
    }
  }
  .hz__kim {
    max-width: 40em;
    font-size: var(--b-kucuk);
    line-height: 1.5;
    color: var(--ikincil);
  }
  .hz__kim strong {
    font-family: var(--yazi-baslik);
    font-weight: 640;
    font-stretch: 96%;
    color: var(--murekkep);
  }
  .hz__bag {
    margin-block-start: 0.35rem;
  }
  .hz__bag::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  @media (hover: hover) {
    .hz__kart:hover {
      transform: translate(-2px, -2px);
      box-shadow: 0.35rem 0.35rem 0 rgb(23 61 166 / 0.2);
    }
    .hz__kart:hover .hz__gorsel :global(img) {
      transform: scale(1.03);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hz__kart,
    .hz__gorsel :global(img),
    .hz__ad span {
      transition: none;
    }
    .hz__kart:hover,
    .hz__kart:hover .hz__gorsel :global(img) {
      transform: none;
    }
  }
  /* Tablet: ilk kart tam genişlik, diğerleri ikişerli. */
  @media (max-width: 61.99rem) {
    .hz__oge[class] {
      grid-column: span 6;
    }
    .hz__oge--1[class] {
      grid-column: 1 / -1;
    }
    .hz__oge--1 .hz__gorsel,
    .hz__oge--2 .hz__gorsel {
      height: auto;
    }
    .hz__oge--1 .hz__gorsel {
      aspect-ratio: 16 / 9;
    }
    .hz__oge--2 .hz__gorsel {
      aspect-ratio: 4 / 5;
    }
    .hz__oge--2 .hz__gorsel :global(img) {
      object-position: 50% 50%;
    }
  }
  /* Telefon: tek sütun. Dikey sahneler kare gösterilir, odak sahnenin anlatan kısmında kalır. */
  @media (max-width: 43.99rem) {
    .hz__oge[class] {
      grid-column: 1 / -1;
    }
    .hz__oge--1 .hz__gorsel {
      aspect-ratio: 3 / 2;
    }
    .hz__oge--2 .hz__gorsel,
    .hz__oge--3 .hz__gorsel,
    .hz__oge--4 .hz__gorsel,
    .hz__oge--5 .hz__gorsel {
      aspect-ratio: 1 / 1;
    }
    .hz__oge--2 .hz__gorsel :global(img) {
      object-position: 50% 42%;
    }
    .hz__oge--3 .hz__gorsel :global(img) {
      object-position: 50% 48%;
    }
    .hz__oge--5 .hz__gorsel :global(img) {
      object-position: 50% 28%;
    }
    .hz__bag {
      min-height: 2.75rem;
      align-items: center;
    }
  }

  /* ---- Hizmetlerin birleşmesi: dört kart, yapbozun dört parçası gibi ikişerli durur. */
  @media (min-width: 48rem) {
    .baglar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
