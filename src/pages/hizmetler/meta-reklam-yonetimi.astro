    name: 'Meta reklam yönetimi',
    alternateName: 'Instagram ve Facebook reklam yönetimi',
    serviceType: 'Instagram ve Facebook reklam yönetimi',
    provider: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad, url: `${SITE.url}/` },
    areaServed: { '@type': 'Country', name: 'Türkiye' },
    url: `${SITE.url}${hizmet.url}`,
    description:
