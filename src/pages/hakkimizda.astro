---
/**
 * Hakkımızda. Sahiplendiği soru: "Bu ekip nasıl çalışıyor, neye söz veriyor, neye vermiyor?"
 *
 * Çalışan adı, portre, kuruluş yılı, müşteri sayısı, sertifika ya da ödül üretilmez.
 * Ekip üyeleri marka sahibi tarafından doğrulanıp EKIP listesine yazıldığında "Ekip" bölümü kendiliğinden görünür.
 *
 * Düzen (15 Kasım 2026): SayfaBasi (tanım + atölye masası) > BuSayfada > hikâyemiz (açılır kitap sahnesi ve kuruluş
 * düşüncesi) > çalışma ilkeleri kartları > çalışma adımları > söz verdiklerimiz / vermediklerimiz > çalışılan markalar >
 * (ekip) > sık sorulan sorular > ilgili sayfalar > görüşme.
 * Hikâye bölümünün düşüncesi marka sahibinden geldi; cümleler birebir alınmadı. Bölümde kuruluş yılı, kişi adı ya da
 * rakam yoktur.
 * Anlatım sırası: derinlemesine inceleme, gerekçeli ve bilinçli kurulum, düzenli optimizasyon, satış hedefi.
 * İlke kartlarındaki işletmeler temsili gündelik örneklerdir, müşteri değildir.
 */
import Temel from '../layouts/Temel.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import BuSayfada from '../components/BuSayfada.astro';
import Adimlar from '../components/Adimlar.astro';
import Sss from '../components/Sss.astro';
import IlgiliSayfalar from '../components/IlgiliSayfalar.astro';
import GorusmeBandi from '../components/GorusmeBandi.astro';
import ProjeEkrani from '../components/ProjeEkrani.astro';
import MusteriSozu from '../components/MusteriSozu.astro';
import Gorsel from '../components/Gorsel.astro';
import Cizim from '../components/Cizim.astro';
import Isaret from '../components/Isaret.astro';
import Ikon from '../components/Ikon.astro';
import { hizmetBul, SITE } from '../site.config';
import { MUSTERI_SOZLERI, PROJELER, projeBul } from '../data/projeler';

import atolye from '../assets/gorseller/atolye.jpg';
import hikaye from '../assets/gorseller/hikaye.jpg';
import buyutec from '../assets/cizimler/buyutec.png';
import liste from '../assets/cizimler/liste.png';
import takvim from '../assets/cizimler/takvim.png';
import balon from '../assets/cizimler/balon.png';
import kilit from '../assets/cizimler/kilit.png';
import alet from '../assets/cizimler/alet.png';
import defter from '../assets/cizimler/defter.png';
import yapboz from '../assets/cizimler/yapboz.png';
import kitaplik from '../assets/cizimler/kitaplik.png';
import terazi from '../assets/cizimler/terazi.png';

import estikaEkran from '../assets/projeler/estika-masaustu.jpg';
import gabionEkran from '../assets/projeler/gabionmaterials-mobil.jpg';
import whiteEarthEkran from '../assets/projeler/whiteearthatelier-mobil.jpg';

/** Yetkili ekip adları teyit edildiğinde doldurulur: { ad, gorev }. Boşken bölüm gizlidir. */
const EKIP: { ad: string; gorev: string }[] = [];

const CAGRI = 'Görüşme isteyin';
const kirintilar = [{ ad: 'Hakkımızda', url: '/hakkimizda/' }];
const sektorSayisi = new Set(PROJELER.map((p) => p.sektor)).size;

/** Beş çalışma ilkesi. Her kartta ilkenin kendisi, ne anlama geldiği ve gündelik bir örneği durur. */
const ilkeler = [
  {
    ad: 'Önce derinlemesine inceleriz',
    aciklama: 'Reklam açmadan, sayfa tasarlamadan önce işletmenizi, rakiplerinizi ve müşterinizin aramalarını inceleriz. Hesabınız ya da siteniz varsa işe ona bakarak başlarız.',
    ornek: 'Bir kombi servisinde ilk iş, insanların arıza anında Google’a ne yazdığını çıkarmaktır.',
    cizim: buyutec,
    genis: true,
  },
  {
    ad: 'Her kararın gerekçesini söyleriz',
    aciklama: 'Bir aramayı neden kapattığımızı, bir sayfayı neden değiştirdiğimizi anlatırız. Kararı siz de değerlendirebilmelisiniz.',
    ornek: '“İkinci el koltuk” aramasını kapattıysak nedeni yazılıdır: yeni koltuk satan mobilyacıya satış getirmiyordur.',
    cizim: liste,
    genis: true,
    mavi: true,
  },
  {
    ad: 'Kurup bırakmayız',
    aciklama: 'Yayına almak işin başıdır. Hangi aramanın, hangi reklamın ve hangi sayfanın talep getirdiğine düzenli bakar; getirmeyeni kapatır, getireni güçlendiririz.',
    ornek: 'Bir restoranın hafta içi ve hafta sonu aramaları aynı değildir; bütçe buna göre yeniden dağıtılır.',
    cizim: takvim,
    mavi: true,
  },
  {
    ad: 'Açık konuşuruz',
    aciklama: 'Yaptığımız işi sade bir dille anlatırız. İşlemeyen bir şey varsa onu da söyleriz; ihtiyacınız olmayan bir hizmeti önermeyiz.',
    ornek: 'Siteniz işini görüyorsa “yenisini yaptıralım” demeyiz, eksik olan yeri düzeltiriz.',
    cizim: balon,
  },
  {
    ad: 'Hesap ve erişim sizde kalır',
    aciklama: 'Reklam hesabı ve web sitesi işletmenizin adınadır. Bize yönetici erişimi verirsiniz; sahiplik sizde durur, erişimi dilediğiniz zaman kaldırabilirsiniz.',
    ornek: 'Çalışma bittiğinde hesabınız, geçmişi ve verisiyle birlikte sizde kalır.',
    cizim: kilit,
    mavi: true,
  },
];

const adimlar = [
  { ad: 'İnceleme', ozet: 'İşletmenizi tanıyoruz', aciklama: 'Ne sattığınızı, müşterinizin kim olduğunu ve sizi bugün nasıl bulduğunu öğreniyoruz. Hesabınız ve siteniz varsa inceliyoruz.' },
  { ad: 'Strateji', ozet: 'Nereden başlanacağını seçiyoruz', aciklama: 'Hangi kanalın, hangi mesajın ve hangi sayfanın gerektiğini gerekçesiyle birlikte kararlaştırıyoruz.' },
  { ad: 'Kurulum', ozet: 'Bulguya göre kuruyoruz', aciklama: 'Hesapları sizin adınıza açıyor; kampanyaları ve sayfaları kurup yayından önce deniyoruz.' },
  { ad: 'Optimizasyon', ozet: 'Düzenli bakıyor, geliştiriyoruz', aciklama: 'Neyin talep getirdiğini takip ediyor, yaptığımız değişiklikleri nedenleriyle size aktarıyoruz.' },
  { ad: 'Hedef', ozet: 'Satış ve müşteri hedefiniz', aciklama: 'İşin ölçüsü tıklama değil, işletmenize gelen talep ve satıştır.' },
];

/** Her işte tuttuğumuz sözler: işletme sahibinin bizden isteyebileceği, kontrol edebileceği şeyler. */
const verilenler = [
  { ad: 'İncelemeden kurulum yapmayız', aciklama: 'Hesabınıza, sitenize ve müşterinizin aramalarına bakmadan kampanya açmaz, sayfa tasarlamayız.' },
  { ad: 'Yaptığımız değişikliği nedeniyle paylaşırız', aciklama: 'Neyi kapattığımızı, neyi güçlendirdiğimizi ve gerekçesini sizden saklamayız.' },
  { ad: 'İhtiyacınız olmayan işi önermeyiz', aciklama: 'Tek bir hizmet yetiyorsa onu söyleriz. Beş hizmetin beşini birden almanız gerekmez.' },
  { ad: 'Hesaplarınız sizin adınıza olur', aciklama: 'Reklam hesabı ve site işletmenizde kalır; biz erişimle çalışırız.' },
  { ad: 'Doğrulanmamış sonucu yazmayız', aciklama: 'Proje sayfalarında yapılan işi ve canlı siteyi gösteririz. Kaynağı belli olmayan rakam paylaşmayız.' },
];

/** Vermediğimiz sözler: sektörde sık duyulan vaat çizilir, altında nedenini söyleriz. */
const verilmeyenler = [
  { vaat: 'Google’da birinci sıra', aciklama: 'Sıralamaya Google karar verir. Sitenizdeki eksikleri giderir, sonucu birlikte takip ederiz; sıra için söz vermeyiz.' },
  { vaat: 'Şu tarihe kadar şu kadar satış', aciklama: 'Satışı reklam kadar ürününüz, fiyatınız ve gelen talebe nasıl dönüldüğü de belirler. Rakam ve tarih sözü vermeyiz.' },
  { vaat: 'Garantili tıklama, takipçi ya da beğeni', aciklama: 'Bunlar satış değildir. Başarıyı işletmenize gelen talep ve satışla değerlendiririz.' },
  { vaat: 'Herkese uyan hazır kurulum', aciklama: 'Aynı sektördeki iki işletmenin müşterisi bile farklı arar. Kurulum, incelemede çıkan bulguya göre yapılır.' },
];

/** Tasarımı ekibe ait, sağlık dışı üç proje. Görüntüler canlı sitelerin ilk ekranıdır. */
const markalar = [
  { p: projeBul('estika'), gorsel: estikaEkran, tur: 'masaustu' as const },
  { p: projeBul('rotech-defense'), gorsel: gabionEkran, tur: 'mobil' as const },
  { p: projeBul('white-earth-atelier'), gorsel: whiteEarthEkran, tur: 'mobil' as const },
];

const sorular = [
  {
    soru: 'Satışları Artır ne iş yapar?',
    cevap:
      'Satışları Artır, işletmelerin internette müşteri bulması ve satışlarını artırması için çalışan bir dijital pazarlama ajansıdır. Google Ads yönetimi, Instagram ve Facebook reklam yönetimi, SEO danışmanlığı, yapay zekâ yanıtlarında görünürlük (GEO ve AEO) ve kurumsal web tasarım hizmeti verir.',
    bag: { etiket: 'Dijital pazarlama hizmetleri', url: '/hizmetler/' },
  },
  {
    soru: 'Daha önce hiç reklam vermedim. Benimle de çalışır mısınız?',
    cevap:
      'Evet. İlk kez reklam verecek işletmelerle de, yıllardır reklam veren işletmelerle de çalışıyoruz. İlk kez veriyorsanız hesap açılışından ilk kampanyaya kadar kurulumu birlikte yapıyor, her adımı sade bir dille anlatıyoruz. Reklam veriyorsanız önce mevcut hesabınızı inceliyoruz.',
  },
  {
    soru: 'Hangi sektörlerden işletmelerle çalışıyorsunuz?',
    cevap:
      'Tek bir sektörle sınırlı değiliz. Çalışmalarımız arasında yapı ve mühendislik, eğitim, yeme içme, üretim ve ihracat, konaklama ve hukuk alanından markalar var. Sektörü tanımak işi hızlandırır ama her işte incelemeye baştan başlarız, çünkü aynı sektördeki iki işletmenin müşterisi bile farklı arar.',
    bag: { etiket: 'Çalıştığımız markalar', url: '/calismalarimiz/' },
  },
  {
    soru: 'Reklam hesabı ve web sitesi kimin adına olur?',
    cevap:
      'İşletmenizin adına olur ve sizde kalır. Reklam hesabını sizin adınıza açar ya da mevcut hesabınıza yönetici erişimiyle gireriz. Ödeme yöntemi, fatura bilgisi ve sahiplik sizde durur; erişimimizi dilediğiniz zaman kaldırabilirsiniz.',
  },
  {
    soru: 'Neden sonuç garantisi vermiyorsunuz?',
    cevap:
      'Çünkü sonucu yalnız biz belirlemiyoruz. Sıralamaya arama motoru karar verir; satışı ise reklam kadar ürününüz, fiyatınız ve gelen talebe nasıl dönüldüğü etkiler. Tutamayacağımız bir söz yerine elimizde olanı taahhüt ediyoruz: ayrıntılı inceleme, gerekçeli karar ve düzenli optimizasyon.',
  },
  {
    soru: 'Çalışmaya nasıl başlıyoruz?',
    cevap:
      'Bir görüşmeyle başlıyoruz. Formu doldurduğunuzda seçtiğiniz yoldan size dönüyor, işletmenizi ve ulaşmak istediğiniz müşteriyi dinliyoruz. Hesabınız ya da siteniz varsa görüşmede birlikte bakıyor, nereden başlanacağını konuşuyoruz.',
    bag: { etiket: 'Görüşmede ne olur?', url: '/iletisim/#gorusmede' },
  },
];

const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Satışları Artır hakkında',
    url: `${SITE.url}/hakkimizda/`,
    inLanguage: 'tr-TR',
    about: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad, url: `${SITE.url}/` },
  },
];
---

<Temel
  baslik="Hakkımızda: Nasıl Çalışıyoruz? | Satışları Artır"
  aciklama="Satışları Artır, işletmelere müşteri kazandırmak için çalışan dijital pazarlama ajansıdır. Çalışma ilkelerimizi, neye söz verdiğimizi ve neye vermediğimizi okuyun."
  sayfaTuru="kurumsal"
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: CAGRI, url: '#gorusme' }}
>
  <SayfaBasi
    kirintilar={kirintilar}
    baslik="Satışları Artır hakkında"
    gorsel={atolye}
    gorselAlt="Kâğıt kasabanın kurulduğu atölye masası: yarısı tamamlanmış kâğıt bir dükkân, makas, cetvel, yapıştırıcı ve masa lambası. Kırmızı kalem çizgisi küçük kâğıt insanları dükkânın kapısına götürüyor."
    mobilOdak="64% 50%"
    cagri={{ etiket: CAGRI, url: '#gorusme' }}
    ikincil={{ etiket: 'Çalışmalarımızı inceleyin', url: '/calismalarimiz/' }}
  >
    <p>
      Satışları Artır, işletmelere müşteri kazandırmak için çalışan bir dijital pazarlama ajansıdır: Google Ads,
      Instagram ve Facebook reklamları, SEO, yapay zekâ görünürlüğü (GEO ve AEO) ve web tasarım.
    </p>
    <p>Bu sayfada nasıl çalıştığımızı, neye söz verdiğimizi ve neye söz vermediğimizi açıkça yazdık.</p>
  </SayfaBasi>

  <BuSayfada
    bolumler={[
      { etiket: 'Hikâyemiz', hedef: 'hikaye' },
      { etiket: 'Çalışma ilkelerimiz', hedef: 'ilkeler' },
      { etiket: 'Nasıl ilerliyoruz?', hedef: 'yontem' },
      { etiket: 'Sözümüz', hedef: 'soz' },
      { etiket: 'Markalar', hedef: 'markalar' },
      { etiket: 'Sık sorulanlar', hedef: 'sss' },
    ]}
  />

  <!-- Hikâyemiz -->
  <section class="bolum hy" id="hikaye">
    <div class="sarici hy__ic">
      <figure class="hy__gorsel" data-gir>
        <Gorsel
          src={hikaye}
          alt="Masada açık duran kâğıt bir kitabın sayfalarından küçük bir kasaba yükseliyor: ortada çizgili tenteli bir dükkân, iki ev ve ağaçlar. Kırmızı kalemle çizilmiş yol, alışveriş torbaları taşıyan dört kişiyi sayfanın kenarından dükkânın açık kapısına götürüyor."
          sizes="(max-width: 55.99rem) 92vw, 36vw"
          genislikler={[480, 720, 960, 1280, 1792]}
          kalite={68}
        />
      </figure>
      <div class="hy__metin">
        <h2 class="baslik-2">Hikâyenizi anlatmanıza yardımcı olalım.</h2>
        <p class="giris">Satışları Artır’ı kurarken aklımızda iki söz vardı.</p>
        <ul class="hy__iki">
          <li data-gir>Hep gelişmek</li>
          <li data-gir style="--gecikme:160ms"><Isaret gecikme={500}>Fark yaratmak</Isaret></li>
        </ul>
        <div class="hy__yazi">
          <p>
            İyi işler çoğu zaman bir zorluğun ardından çıkar. Bizim zorluğumuz şuydu: dijital pazarlamada işler
            birbirinin kopyası gibi yapılıyordu. Aynı reklam metni, aynı şablon site, aynı rapor. Yaratıcılık, disiplin ve
            yeni fikir eksikti. İşini iyi yapan pek çok işletme de bu yüzden sesini duyuramıyordu.
          </p>
          <p>
            Çözümü kendimiz kurmaya karar verdik. Satışları Artır’ı ilhamla, emekle ve iş birliğiyle kurduk. İstediğimiz,
            bir ajanstan fazlası olmaktı: hedefinize giden yolda yanınızda yürüyen bir rehber.
          </p>
          <p>
            Bugün birlikte çalıştığımız her işletme bizi heyecanlandırıyor, ortaya çıkan işle gurur duyuyoruz. Çözüm
            ortağınız olarak hikâyenizi yeniden yazmanıza ve duyması gereken kişiye duyurmanıza yardım ediyoruz.
          </p>
        </div>
        <a class="ok-bag" href="#ilkeler">
          Bunu nasıl yaptığımızı okuyun
          <Ikon ad="arrow-down" boyut={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Çalışma ilkeleri -->
  <section class="bolum bolum--beyaz" id="ilkeler">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">Nasıl çalışıyoruz?</h2>
        <p class="giris">
          İlk kez reklam verecek bir işletmede de, yıllardır reklam veren bir işletmede de aynı beş ilkeyle çalışıyoruz.
        </p>
      </div>
      <ul class="ilkeler">
        {
          ilkeler.map((i, sira) => (
            <li class:list={['ilke', i.genis && 'ilke--genis', i.mavi && 'ilke--mavi']} data-gir style={`--gecikme:${[0, 120, 0, 120, 240][sira]}ms`}>
              <div class="ilke__metin">
                <h3 class="ilke__ad">{i.ad}</h3>
                <p class="ilke__aciklama">{i.aciklama}</p>
                <p class="ilke__ornek kucuk">{i.ornek}</p>
              </div>
              <div class="ilke__cizim" aria-hidden="true">
                <Cizim src={i.cizim} sizes="(max-width: 47.99rem) 48vw, 18vw" genislikler={[280, 420, 640, 1024]} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Çalışma adımları -->
  <section class="bolum" id="yontem">
    <div class="sarici konu konu--ust">
      <div class="konu__baslik konu__baslik--cizimli">
        <div>
          <h2 class="baslik-2">Birlikte çalışmak nasıl ilerler?</h2>
          <div class="metin">
            <p>
              İlk görüşmeden sonra izlediğimiz yol beş adımdır.
              <a href={hizmetBul('google-ads').url}>Google Ads yönetiminde</a>,
              <a href={hizmetBul('meta').url}>Instagram ve Facebook reklamlarında</a>,
              <a href={hizmetBul('seo').url}>SEO danışmanlığında</a>,
              <a href={hizmetBul('geo').url}>GEO ve AEO çalışmalarında</a> ve
              <a href={hizmetBul('web').url}>web tasarımda</a> sıra değişmez.
            </p>
          </div>
        </div>
        <Cizim src={alet} class="konu__cizim" sizes="(max-width: 55.99rem) 40vw, 16vw" />
      </div>
      <div class="konu__icerik">
        <Adimlar adimlar={adimlar} />
      </div>
    </div>
  </section>

  <!-- Söz verdiklerimiz / vermediklerimiz -->
  <section class="bolum bolum--beyaz" id="soz">
    <div class="sarici">
      <div class="soz__ust">
        <div class="soz__giris">
          <h2 class="baslik-2">Neye söz veriyoruz, neye <Isaret tip="alt">vermiyoruz?</Isaret></h2>
          <p class="giris">
            Bir ajansla çalışmaya başlamadan önce bilmeniz gereken iki liste. İlkindekileri bizden isteyebilirsiniz;
            ikincidekileri vadeden olursa nasıl tutacağını sorun.
          </p>
        </div>
        <Cizim src={defter} class="soz__cizim" sizes="(max-width: 55.99rem) 44vw, 20vw" />
      </div>
      <div class="soz__izgara">
        <article class="soz__panel soz__panel--evet" data-gir>
          <h3 class="soz__baslik">Söz verdiklerimiz</h3>
          <ul class="soz__liste soz__liste--evet">
            {
              verilenler.map((v) => (
                <li>
                  <strong>{v.ad}</strong>
                  <span>{v.aciklama}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="soz__panel soz__panel--hayir koyu-zemin" data-gir style="--gecikme:140ms">
          <h3 class="soz__baslik">Söz vermediklerimiz</h3>
          <ul class="soz__liste soz__liste--hayir">
            {
              verilmeyenler.map((v, i) => (
                <li>
                  <strong><s class="soz__cizili" style={`--sira:${i}`}>“{v.vaat}”</s></strong>
                  <span>{v.aciklama}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Çalışılan markalar -->
  <section class="bolum" id="markalar">
    <div class="sarici">
      <div class="mk__ust">
        <div class="mk__giris">
          <h2 class="baslik-2">Hangi markalarla çalıştık?</h2>
          <p class="giris">
            Çalışmalarımız sayfasında yapıdan eğitime, yeme içmeden üretime {sektorSayisi} sektörden {PROJELER.length} marka
            var. Görüntüler yayındaki sitelerin kendisi; canlı sitelerini açıp inceleyebilirsiniz.
          </p>
          <a class="dugme dugme--murekkep" href="/calismalarimiz/" data-olay="cta_click" data-yer="hakkimizda-markalar">
            Çalıştığımız markaları görün
            <Ikon ad="arrow-right" boyut={18} />
          </a>
        </div>
