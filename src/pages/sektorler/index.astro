---
/**
 * Sektörler dizini (/sektorler/).
 * Ana niyet: "sektörel dijital pazarlama" ve sektör sayfalarına giriş ("inşaat firmaları için dijital pazarlama",
 * "restoran reklamı", "otel dijital pazarlama"...).
 * Bölümler: üst alan (sekiz binalı kâğıt sokak) > BuSayfada > sektör kartları (eş ölçülü ızgara) > sektöre göre ne değişir
 * (dört soru) > listede olmayan sektörler > sık sorulan sorular > görüşme.
 * Kartlar src/data/sektorler/ altındaki kayıtlardan üretilir; yeni sektör dosyası eklenince kart kendiliğinden gelir.
 */
import Temel from '../../layouts/Temel.astro';
import SayfaBasi from '../../components/SayfaBasi.astro';
import BuSayfada from '../../components/BuSayfada.astro';
import Sss from '../../components/Sss.astro';
import GorusmeBandi from '../../components/GorusmeBandi.astro';
import Cizim from '../../components/Cizim.astro';
import Gorsel from '../../components/Gorsel.astro';
import Ikon from '../../components/Ikon.astro';
import { SITE } from '../../site.config';
import { SEKTORLER, sektorGorseli, sektorUrl } from '../../data/sektorler';

import buyutec from '../../assets/cizimler/buyutec.png';
import takvim from '../../assets/cizimler/takvim.png';
import zarf from '../../assets/cizimler/zarf.png';
import terazi from '../../assets/cizimler/terazi.png';
import soru from '../../assets/cizimler/soru.png';

const kirintilar = [{ ad: 'Sektörler', url: '/sektorler/' }];
const BASLIK = 'Sektörel dijital pazarlama çözümleri';
const ACIKLAMA =
  'İnşaattan otomotive, mimarlıktan sağlık turizmine: her sektörde müşterinin ne aradığına ve nasıl karar verdiğine göre kurulan dijital pazarlama.';

const kartlar = SEKTORLER.map((s) => ({
  ad: s.ad,
  kimler: s.kimler,
  ozet: s.ozet,
  url: sektorUrl(s),
  gorsel: sektorGorseli(s.kimlik),
  alt: s.gorselAlt,
  referans: s.referanslar?.liste.length ?? 0,
}));

const farklar = [
  {
    soru: 'Müşteri nasıl arıyor?',
    metin: 'Çilingir, ihtiyacın adıyla aranır. Seramik bir vazo ise görülünce istenir. Aramayla mı, akışla mı başlanacağı buradan çıkar.',
    cizim: buyutec,
  },
  {
    soru: 'Karar ne kadar sürüyor?',
    metin: 'Restoran dakikalar içinde seçilir, villa aylar sonra yaptırılır. Kısa kararda harita ve yorum, uzun kararda içerik ve yeniden hatırlatma öne geçer.',
    cizim: takvim,
  },
  {
    soru: 'Başvuru hangi yoldan geliyor?',
    metin: 'Telefon, form, WhatsApp, rezervasyon ya da teklif isteği. Reklamın hedefi ve sayfanın düzeni, sektörün alıştığı yola göre kurulur.',
    cizim: zarf,
  },
  {
    soru: 'Meslek kuralı var mı?',
    metin: 'Avukatlar, hekimler ve mimarlar için tanıtım kuralları vardır. Bu alanlarda reklam kampanyası kurmuyor, bilgilendirici site ve arama görünürlüğü üzerinde çalışıyoruz.',
    cizim: terazi,
  },
];

const referansliSektorler = kartlar.filter((k) => k.referans > 0);
const sorular = [
  {
    soru: 'Sektörel dijital pazarlama nedir?',
    cevap:
      'Sektörel dijital pazarlama, reklamın, web sitesinin ve içeriğin bir sektördeki müşterinin arama ve karar verme biçimine göre kurulmasıdır. Aynı hizmetler her sektörde kullanılır; hangisinin öne geçeceğini müşterinin davranışı belirler.',
  },
  {
    soru: 'Her sektörde aynı hizmetleri mi veriyorsunuz?',
    cevap:
      'Hizmetler aynıdır: Google Ads, Instagram ve Facebook reklamları, SEO, yapay zekâ görünürlüğü ve web tasarım. Ağırlıkları sektöre göre değişir. Restoranda harita ve Instagram öne geçer, üretimde teknik ürün sayfaları ve teklif formu. Hukukta, mimarlık ofislerinde ve yurt içine dönük sağlık hizmetlerinde meslek kuralları nedeniyle reklam kampanyası kurmuyoruz; sağlık turizminde reklamı yalnız yetki belgesi olan kurumlar için, yurt dışına yönelik kuruyoruz.',
  },
  {
    soru: 'Hangi sektörlerde referansınız var?',
    cevap: `${referansliSektorler.map((k) => k.ad).join(', ')} sektörlerinde yayında olan çalışmalarımız var. Her sektör sayfasında o sektörde çalıştığımız markaları ve yapılan işi görebilirsiniz.`,
    bag: { etiket: 'Bütün çalışmalarımız', url: '/calismalarimiz/' },
  },
  {
    soru: 'Sektörüm listede yoksa birlikte çalışabilir miyiz?',
    cevap:
      'Evet. Yöntem sektöre bağlı değildir: önce müşterinizin sizi nasıl aradığını, nasıl karar verdiğini ve size hangi yoldan ulaştığını inceliyoruz. Daha önce çalışmadığımız bir sektörde bunu açıkça söyler, deneyimimiz varmış gibi anlatmayız.',
  },
  {
    soru: 'Sektör sayfalarındaki arama sayıları neyi gösteriyor?',
    cevap:
      'Sayılar, o ifadenin Türkiye’de bir ayda yaklaşık kaç kez arandığını gösterir ve anahtar kelime araştırma aracıyla ölçülmüştür. Mevsime göre değişir; kesin bir sayı değil, aramanın büyüklüğü hakkında fikir verir.',
  },
  {
    soru: 'Sonuç garantisi veriyor musunuz?',
    cevap:
      'Hayır. Sıra, talep ya da satış sayısı için söz vermiyoruz. Söz verdiğimiz şey işletmenizi ve sektörünüzü ayrıntılı incelemek, verdiğimiz kararları gerekçesiyle anlatmak ve düzenli optimizasyon yapmaktır.',
  },
];

const yapisalVeri = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/sektorler/#sayfa`,
    name: BASLIK,
    description: ACIKLAMA,
    url: `${SITE.url}/sektorler/`,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${SITE.url}/#site` },
    publisher: { '@type': 'Organization', '@id': `${SITE.url}/#kurum`, name: SITE.ad },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: SEKTORLER.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.baslik, url: `${SITE.url}${sektorUrl(s)}` })),
    },
  },
];
---

<Temel
  baslik="Sektörel Dijital Pazarlama Çözümleri | Satışları Artır"
  aciklama={ACIKLAMA}
  sayfaTuru="hizmetler"
  kirintilar={kirintilar}
  yapisalVeri={yapisalVeri}
  cagri={{ etiket: 'Görüşme isteyin', url: '#gorusme' }}
>
  <SayfaBasi
    kirintilar={kirintilar}
    baslik={BASLIK}
    gorsel={sektorGorseli('sektorler')}
    gorselAlt="Yan yana farklı kâğıt binalar: şantiye, okul, restoran, fabrika, otel, hukuk bürosu, klinik ve atölye; kırmızı kalem çizgisi kaldırım boyunca her kapıya uğruyor"
    cagri={{ etiket: 'Sektörüm için görüşelim', url: '#gorusme', yer: 'sektorler-ust' }}
    ikincil={{ etiket: 'Sektörleri inceleyin', url: '#sektorler' }}
  >
    <p>
      Sektörel dijital pazarlama, reklamı, web sitesini ve içeriği bir sektördeki müşterinin arama ve karar verme
      biçimine göre kurma işidir.
    </p>
    <p>
      Havuz yaptıracak kişi aylarca araştırır, burger yiyecek kişi beş dakikada karar verir. İkisine aynı reklam ve
      aynı sayfa gösterilmez. Çalıştığımız sektörlerde müşterinin ne aradığını, işletmelerin nerede takıldığını ve
      hangi kanalın ne işe yaradığını ayrı ayrı anlattık.
    </p>
  </SayfaBasi>

  <BuSayfada
    bolumler={[
      { etiket: 'Sektörler', hedef: 'sektorler' },
      { etiket: 'Sektöre göre ne değişir?', hedef: 'fark' },
      { etiket: 'Sektörünüz yoksa', hedef: 'diger' },
      { etiket: 'Sık sorulanlar', hedef: 'sss' },
    ]}
  />

  <!-- Sektör kartları -->
  <section class="bolum bolum--beyaz" id="sektorler">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">Çalıştığımız sektörler</h2>
        <p class="giris">Her sayfada o sektörün aramaları, sık yaşanan sorunlar, kanalların işi ve birlikte çalıştığımız markalar var.</p>
      </div>
      <ul class="sek" style={`--sutun:${kartlar.length % 3 === 0 ? 3 : 4}`}>
        {
          kartlar.map((k, i) => (
            <li class="sek__kart" data-gir style={`--gecikme:${(i % 4) * 70}ms`}>
              <div class="sek__gorsel" aria-hidden="true">
                <Gorsel src={k.gorsel} alt="" sizes="(max-width: 43.99rem) 30vw, (max-width: 74.99rem) 46vw, 23vw" genislikler={[240, 360, 480, 720, 960]} kalite={62} />
              </div>
              <h3 class="sek__ad">
                <a href={k.url}>
                  <span>{k.ad}</span>
                </a>
              </h3>
              <p class="sek__kimler">{k.kimler}</p>
              <p class="sek__ozet">{k.ozet}</p>
              <p class="sek__alt">
                {k.referans > 0 && <span class="sek__referans">{k.referans} referans</span>}
                <span class="sek__ok" aria-hidden="true">
                  <Ikon ad="arrow-right" boyut={20} />
                </span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sektöre göre ne değişir -->
  <section class="bolum" id="fark">
    <div class="sarici">
      <div class="bolum-ust">
        <h2 class="baslik-2">Sektöre göre ne değişir?</h2>
        <p class="giris">Bir sektörle çalışmaya başlarken önce bu dört soruya cevap arıyoruz. Kanal, sayfa ve reklam kararları bu cevaplardan çıkar.</p>
      </div>
      <ul class="fk">
        {
          farklar.map((f, i) => (
            <li class:list={['fk__kart', i % 2 === 1 && 'fk__kart--mavi']} data-gir style={`--gecikme:${i * 80}ms`}>
              <div class="fk__cizim" aria-hidden="true">
                <Cizim src={f.cizim} sizes="(max-width: 47.99rem) 40vw, 12vw" genislikler={[240, 360, 520]} />
              </div>
              <h3 class="fk__soru">{f.soru}</h3>
              <p class="fk__metin">{f.metin}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Listede olmayan sektörler -->
  <section class="bolum bolum--acik" id="diger">
    <div class="sarici dg">
      <div class="dg__cizim" aria-hidden="true">
        <Cizim src={soru} sizes="(max-width: 47.99rem) 40vw, 18vw" genislikler={[280, 420, 640]} />
      </div>
      <div class="dg__metin">
        <h2 class="baslik-2">Sektörünüz listede yok mu?</h2>
        <div class="metin">
          <p>
            Yöntem sektöre bağlı değildir. Hangi işte olursanız olun önce müşterinizin sizi nasıl aradığını, kararı
            nasıl verdiğini ve size hangi yoldan ulaştığını inceliyoruz. Kurulum bu incelemeden çıkar.
          </p>
          <p>
            Daha önce çalışmadığımız bir sektördeyseniz bunu ilk görüşmede açıkça söyleriz. İşinizi en iyi siz
            bilirsiniz; biz de onu arayan kişiye doğru yerde, doğru sözle göstermeyi biliriz.
          </p>
        </div>
        <a class="dugme dugme--murekkep" href="#gorusme" data-olay="cta_click" data-yer="sektorler-diger">
          Sektörümü anlatmak istiyorum
          <Ikon ad="arrow-right" boyut={18} />
        </a>
      </div>
    </div>
  </section>

  <Sss baslik="Sektörel çalışma hakkında sık sorulan sorular" giris="Sektöre göre neyin değiştiği ve nasıl başladığımız hakkında en çok sorulanlar." sorular={sorular} zemin="beyaz" />

  <GorusmeBandi
    baslik="Sektörünüzü birlikte inceleyelim."
    metin="İşletmenizi, müşterinizin sizi nasıl bulduğunu ve hedefinizi anlatın. Görüşmeye buradan başlayalım."
    kanal="belirsiz"
    cagri="Görüşme isteyin"
    konum="sektorler"
  />
</Temel>

<style>
  /* ---- Sektör kartları: dört sütun, eş ölçü; satırlar (görsel, ad, kimler, özet, alt satır) subgrid ile hizalı. */
  .sek {
    --kart-arasi: clamp(0.9rem, 1.6vw, 1.4rem);
    --ic: clamp(1rem, 1.4vw, 1.3rem);
    display: grid;
    grid-template-columns: repeat(var(--sutun, 4), minmax(0, 1fr));
    column-gap: var(--kart-arasi);
    row-gap: 0.6rem;
  }
  .sek__kart {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    align-items: start;
    margin-block-end: calc(var(--kart-arasi) - 0.6rem);
    padding-block-end: var(--ic);
    background: var(--yuzey);
    border-radius: var(--kose);
    overflow: hidden;
    transition:
      transform 240ms var(--yumusak),
      box-shadow 240ms var(--yumusak);
  }
  .sek__kart > :not(.sek__gorsel) {
    margin-inline: var(--ic);
  }
  .sek__gorsel {
    aspect-ratio: 3 / 2;
    margin-block-end: 0.4rem;
    overflow: hidden;
    background: var(--mavi-acik);
  }
  .sek__gorsel :global(picture),
  .sek__gorsel :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sek__gorsel :global(img) {
    object-fit: cover;
    transition: transform 700ms var(--yumusak);
  }
  .sek__ad {
    font-size: clamp(1.3rem, 1.12rem + 0.7vw, 1.7rem);
    font-weight: 710;
    font-stretch: 85%;
    letter-spacing: -0.024em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .sek__ad a {
    color: inherit;
    text-decoration: none;
  }
  /* Kartın tamamı tıklanır. */
  .sek__ad a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .sek__ad a:focus-visible {
    outline: none;
  }
  .sek__kart:has(.sek__ad a:focus-visible) {
    outline: 2px solid var(--mavi);
    outline-offset: 3px;
  }
  .sek__ad span {
    background: linear-gradient(var(--kirmizi), var(--kirmizi)) no-repeat 0 96% / 0 0.09em;
    transition: background-size 520ms cubic-bezier(0.6, 0.05, 0.25, 1);
  }
  .sek__kart:hover .sek__ad span,
  .sek__kart:focus-within .sek__ad span {
    background-size: 100% 0.09em;
  }
  .sek__kimler {
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 620;
    line-height: 1.35;
    color: var(--mavi);
  }
  .sek__ozet {
    font-size: var(--b-kucuk);
    line-height: 1.48;
    color: var(--murekkep-2);
  }
  .sek__alt {
    display: flex;
    align-items: center;
    align-self: end;
    min-height: 1.6rem;
    width: calc(100% - 2 * var(--ic));
  }
  .sek__referans {
    padding: 0.32em 0.65em 0.36em;
    border-radius: 2px;
    background: var(--mavi-acik);
    font-family: var(--yazi-baslik);
    font-size: var(--b-mikro);
    font-weight: 650;
    line-height: 1;
    color: var(--mavi-koyu);
  }
  .sek__ok {
    margin-inline-start: auto;
    color: var(--kirmizi);
  }
  @media (hover: hover) {
    .sek__kart:hover {
      transform: translate(-2px, -2px);
      box-shadow: 0.4rem 0.4rem 0 rgb(23 61 166 / 0.2);
    }
    .sek__kart:hover .sek__gorsel :global(img) {
      transform: scale(1.045);
    }
    .sek__kart:hover .sek__ok :global(svg) {
      animation: ok-gec 460ms var(--yumusak);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sek__kart,
    .sek__gorsel :global(img),
    .sek__ad span {
      transition: none;
    }
    .sek__kart:hover,
    .sek__kart:hover .sek__gorsel :global(img) {
      transform: none;
    }
  }
  @media (max-width: 74.99rem) {
    .sek {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Telefonda kart yatay satıra döner: solda kare görsel, sağda ad, kimler ve referans. */
  @media (max-width: 43.99rem) {
    .sek {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
    }
    .sek__kart {
      grid-row: auto;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      column-gap: 0.9rem;
      row-gap: 0.35rem;
      margin-block-end: 0;
      padding: 0.75rem;
    }
    .sek__kart > :not(.sek__gorsel) {
      margin-inline: 0;
    }
    .sek__gorsel {
      grid-column: 1;
      grid-row: 1 / -1;
      aspect-ratio: 1;
      margin: 0;
      border-radius: 3px;
    }
    .sek__ad,
    .sek__kimler,
    .sek__alt {
      grid-column: 2;
    }
    .sek__ad {
      font-size: 1.25rem;
    }
    .sek__ozet {
      display: none;
    }
    .sek__alt {
      width: 100%;
    }
  }

  /* ---- Sektöre göre ne değişir: dört kart, görsel üstte. */
  .fk {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 1.5vw, 1.4rem);
    row-gap: 0.7rem;
  }
  .fk__kart {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-items: start;
    padding: clamp(1.15rem, 2vw, 1.75rem);
    background: var(--yuzey);
    border-radius: var(--kose);
  }
  .fk__kart--mavi {
    background: var(--mavi-acik);
  }
  .fk__cizim {
    justify-self: end;
    width: min(62%, 9.5rem);
    margin: -0.5rem -0.5rem 0 0;
  }
  .fk__soru {
    font-size: clamp(1.3rem, 1.12rem + 0.7vw, 1.7rem);
    font-weight: 710;
    font-stretch: 85%;
    letter-spacing: -0.024em;
    line-height: 1.06;
    text-wrap: balance;
  }
  .fk__metin {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--murekkep-2);
  }
  @media (max-width: 74.99rem) {
    .fk {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fk__kart:nth-child(n + 3) {
      margin-block-start: clamp(0.05rem, 0.8vw, 0.7rem);
    }
    /* İki sütunda dama düzeni. */
    .fk__kart:nth-child(n) {
      background: var(--yuzey);
    }
    .fk__kart:nth-child(4n + 2),
    .fk__kart:nth-child(4n + 3) {
      background: var(--mavi-acik);
    }
  }
  @media (max-width: 43.99rem) {
    .fk {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
    }
    .fk__kart {
      grid-row: auto;
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      grid-template-rows: auto 1fr;
      column-gap: 0.75rem;
      row-gap: 0.5rem;
      margin-block-start: 0 !important;
    }
    .fk__kart:nth-child(n) {
      background: var(--yuzey);
    }
    .fk__kart:nth-child(even) {
      background: var(--mavi-acik);
    }
    .fk__cizim {
      grid-column: 2;
      grid-row: 1 / -1;
      width: 100%;
      margin: -0.25rem -0.4rem 0 0;
    }
    .fk__soru,
    .fk__metin {
      grid-column: 1;
    }
  }

  /* ---- Listede olmayan sektörler */
  .dg {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
  }
  .dg__cizim {
    justify-self: center;
    width: min(100%, 19rem);
  }
  .dg__metin {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }
  .dg__metin .metin {
    max-width: 44rem;
  }
  @media (max-width: 55.99rem) {
    .dg {
      grid-template-columns: minmax(0, 1fr);
    }
    .dg__cizim {
      justify-self: start;
      width: min(48%, 12rem);
      margin: -0.75rem 0 -1rem -0.75rem;
    }
    .dg__metin :global(.dugme) {
      width: 100%;
    }
  }
</style>
