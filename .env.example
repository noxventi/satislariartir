# Satışları Artır | ortam değişkenleri (kopyalayıp .env olarak kaydedin)

# Ölçüm etiketleri. Boşken hiçbir üçüncü taraf betiği yüklenmez ve çerez bandı görünmez.
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=

# Ön izleme ortamında "taslak" yazın: bütün sayfalar noindex olur, robots.txt siteyi kapatır.
PUBLIC_SITE_ORTAMI=

# 1 ise çerez bandı etiket tanımlı olmasa da görünür (tasarım kontrolü için).
PUBLIC_CEREZ_BANDI=

# Talep kayıtlarının tutulduğu klasör. Boşsa üretimde ~/satislariartir-veri, geliştirmede ./veri. Kalıcı ve yedeklenen bir disk olmalı;
# uygulama klasörünün içinde olmamalı (barındırma her dağıtımda o klasörü yeniler).
VERI_KLASORU=

# Erişimi sınırlı talep listesi: /yonetim/talepler/  Tanımlı değilse sayfa kapalıdır (404).
YONETIM_KULLANICI=
YONETIM_SIFRESI=

# Yeni talep e-postası (SMTP). SMTP_KULLANICI tam posta adresidir, SMTP_SIFRESI o kutunun şifresidir.
# İkisi de doluysa bildirim açılır. Gönderim başarısız olursa kayıt korunur ve 5 dakikada bir, en çok 12 kez yeniden denenir.
SMTP_KULLANICI=
SMTP_SIFRESI=
# Bildirimin gideceği adres. Boşsa SMTP_KULLANICI adresine gider.
BILDIRIM_EPOSTA=
# Boşsa Hostinger Mail varsayılanları kullanılır: smtp.hostinger.com ve 465.
SMTP_SUNUCU=
SMTP_PORT=

# Yeni talep bildirimi: bu adrese JSON gönderilir (CRM ya da otomasyon aracı). E-postadan bağımsız çalışır.
BILDIRIM_WEBHOOK_URL=

# Sunucu
HOST=0.0.0.0
PORT=4321
